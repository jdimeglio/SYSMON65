; LIBRARY FILE - PRIMATIVES 
; version 2.30
; two pass symbolic assembler, dissembler and tracer
; REGB bits 0-3 are connected to LED's
; tested in Michael Kowalski 6502 Simulator - using 65C02 Code 
; Programmed by Joe DiMeglio
; https://github.com/jdimeglio/6502-Monitor
; bug fixes
        
            
;------------------------------------------------------------------------
;prints a string ending with EOS - checkign for packed strings
;looks for the string after teh JSR statement
;------------------------------------------------------------------------           
;--------------------------------------------------------------------
; Ultra-Optimized 65C02 STRING Routine
;--------------------------------------------------------------------
STRING              PHP
                    PHA
                    PHX
                    PHY

                    TSX
                    LDA     $0105,x         ; Fetch Return Address Low
                    STA     STR_PTR
                    LDA     $0106,x         ; Fetch Return Address High
                    STA     STR_PTR+1

.NEXTCHAR           INC     STR_PTR
                    BNE     .FETCH
                    INC     STR_PTR+1

.FETCH              LDA     (STR_PTR)       ; 
                    BEQ     .ADJUST_RETURN  ; $00 = End of String                    
                    BMI     .PACKED_TOKEN   ; If Bit 7 is 1, it's compressed data               
                   
                    JSR     WRCHAR          ; Print it once
                    BRA     .NEXTCHAR       ; Immediately grab the next byte!
                    
.PACKED_TOKEN       ; --- SLOW PATH: RLE TEXT ---
                    JSR     UNPACK_DECODE   ; Sets A to char, Y to repeat count
.PRINT_LOOP         JSR     WRCHAR
                    DEY
                    BNE     .PRINT_LOOP
                    BRA     .NEXTCHAR
                    
.ADJUST_RETURN      LDA     STR_PTR
                    STA     $0105,x         ; Overwrite stack return address
                    LDA     STR_PTR+1
                    STA     $0106,x
                    
                    PLY
                    PLX
                    PLA
                    PLP
                    RTS

;------------------------------------------------------------------------
; ANSI GOTO x & y 
;------------------------------------------------------------------------
GOTOXY              
        	.IF MYWYM
                    PHA                         ;goto [ <X> ; <Y> H
                    LDA     #ESC                ;Escape codes   
                    JSR     WRCHAR              
                    LDA     #'['                
                    JSR     WRCHAR              
                    TYA             
                    JSR     WRDECI              ;write in decimal               
                    LDA     #';'                
                    JSR     WRCHAR              
                    TXA             
                    JSR     WRDECI              
                    LDA     #'H'                
                    JSR     WRCHAR              
                    PLA                 
                    RTS    
            .ELSE
                    STX     io_posx             ;use simlulator
                    STY     io_posy         
                    RTS     
            .ENDIF          
 
 ;------------------------------------------------------------------------
; ANSI - CSI n x See https://en.wikipedia.org/wiki/ANSI_escape_code
;  low level
;------------------------------------------------------------------------
WRCSI               PHA                             ;save value
                    LDA     #ESC                
                    JSR     WRCHAR              
                    LDA     #'['                
                    JSR     WRCHAR              
                    TXA             
                    JSR     WRCHAR                  ;write in decimal 
                    PLA             
                    BRA     WRCHAR                  ;write ANSI Mode                                    
                        
                    
;------------------------------------------------------------------------
; ANSI - Clear Screen; ;.BYTE   ESC,"[2J",EOS                       
;  low level
;------------------------------------------------------------------------
CLS             
            .IF MYWYM
                    LDX     #'2'
                    LDA     #'J'                ;Clrscrn escape code
                    JSR     WRCSI               ;               
                    RTS         
            .ELSE           
                    STA     io_cls              ;use simlulator 
                    RTS         
            .ENDIF
            
;------------------------------------------------------------------------
; ANSI -  Bring Cursor Home 
;------------------------------------------------------------------------
HOME  
            .IF MYWYM
                    JSR     STRING              
                    .ASCII  ESC,"[1;1H",EOS
                    RTS                     
            .ELSE
                    LDX     #00
                    LDY     #00
                    JMP     GOTOXY          
            .ENDIF
;------------------------------------------------------------------------
; ANSI -  Save Cursor Position
;------------------------------------------------------------------------
SAVECUR             JSR     STRING 
                	.ASCII  ESC,"[s",EOS                                            
                    RTS                     

;------------------------------------------------------------------------
; ANSI -  Restore Cursor Position 
;------------------------------------------------------------------------
RESTCUR             JSR     STRING          
                	.ASCII  ESC,"[u",EOS                                         
                    RTS                     
                                    
;------------------------------------------------------------------------
; Print a dot
;------------------------------------------------------------------------
WRDOT               LDA     #'.'                ;Print a dot
                    BRA     WRCHAR

;------------------------------------------------------------------------
; Check Tabs
;------------------------------------------------------------------------
TABS3
        	.IF MYWYM
                    LDA     #'C'
                    LDX     #20
                    JSR     WRCSI
            
        	.ELSE
                    PHA
                    LDA     io_posx
                    LDA     #20
                    ;CLC
                    ;ADC    #06
                    STA     io_posx
                    PLA
        	.ENDIF  
                    RTS 
                        
;------------------------------------------------------------------------
; Print a space
;------------------------------------------------------------------------
WRSPACE             LDA     #SP                 ;Print a space
                    BRA     WRCHAR               
                           
;------------------------------------------------------------------------
; Print a CR
;------------------------------------------------------------------------

WRCRLF              LDA     #CR                 ;Print a CR & LF        
                    JSR     WRCHAR
WRLF                LDA     #LF                 ;fall through to WRCHAR

;------------------------------------------------------------------------
;WRCHAR Out charater to the screen
;  Low level
;------------------------------------------------------------------------
WRCHAR
        	.IF LCD_ROUTINES
                    BBR     #01, WR2LCD,.SERIAL 
                    JMP     LCD_WRCHAR
.SERIAL             
        	.ENDIF   

        	.IF MYWYM
					PHP                         ;save flags         
                    PHA             
                    LDA     #%00010000          ;Load mask
.WAITTX             BIT     ASTAT               ;Test the hardware
                    BEQ     .WAITTX             ;Loop if not ready
                    PLA             
                    STA     ADATA      
                    PLP             
                    RTS
                                        
        	.ELSE
                    STA     io_putc             ;Else use simulator
                    RTS
        	.ENDIF

;------------------------------------------------------------------------
;Print Blank Lines & print N Blank lines 
; x= times
;------------------------------------------------------------------------
WRBLNK              LDX     #$03                ;Blank count x3
WRBL2               LDA     #SP
                    BRA     REPWRCHAR           ;repeat WR


;------------------------------------------------------------------------
;REPWRCHAR Out charater to the screen
; A= Char  x= times
;------------------------------------------------------------------------
DRAWLINECR          JSR     WRCRLF
DRAWLINE            LDA     #DASH
                    LDX     #78                 ;columns on the screen 80-2
                    JSR     REPWRCHAR 
                    BRA     WRCRLF
                    
REPWRCHAR           JSR     WRCHAR
                    DEX
                    BNE     REPWRCHAR
                    RTS

;------------------------------------------------------------------------
;convert binary into a ASCII characters - assume cpu is in binary
;write to screen eg xx
;------------------------------------------------------------------------
WR2HEX              PHA         
                    LSR                         ;write 2 hex digits         
                    LSR         
                    LSR         
                    LSR         
                    JSR     WR1HEX          
                    PLA         
WR1HEX              ;CLD                         ;write 1 character HEX eg x 
                    AND     #$0f            
                    CMP     #$0a            
                    BCC     .z09                        
                    ADC     #$06                ;carry is set           
.z09                ADC     #$30
                    BRA     WRCHAR     
            
;------------------------------------------------------------------------
; Print word in hex
; A holds MSB, Y holds LSB, eg $xxxx
;------------------------------------------------------------------------
WRWORD              PHA                         ;Save MSB
                    LDA     #'$'                ;Print dollar symbol
                    JSR     WRCHAR
                    PLA
WRWORDAY            JSR     WR2HEX              ;Print MSB
                    TYA
                    BRA     WR2HEX              ;Print LSB

;------------------------------------------------------------------------
; SCAN_ESC if key is pressed
;  Low level
;------------------------------------------------------------------------
SCAN_ESC    
            .IF MYWYM       
                    LDA     #%00001000          ; 6551 RX Full is Bit 3
                    AND     ASTAT               ; ACIA Status register          
                    BEQ     .NOTHING            
                    JSR     READACIA    
          
.NOTHING            CMP     #ESC
                    RTS     
        
            .ELSE
                    LDA     KBDCR               ;Was a key pressed?
                    CMP     #ESC                ;Make Z=1 if ESC
                    RTS
            .ENDIF

;------------------------------------------------------------------------
; Wait for keypressed
;  Low level
;------------------------------------------------------------------------
RDCHAR
        	.IF MYWYM 
					LDA     #%00001000          ;Load mask ONCE
.WAITRX             BIT     ASTAT               ;(Changed from AND to BIT so A isn't destroyed)
                    BEQ     .WAITRX         
READACIA            LDA     ACIA
                    PHA             
                    LDA     ASTAT               ;clear 6551 status register              
                    PLA         
                    RTS         

        	.ELSE   
                    LDA     KBDCR               ;Else use simulator         
                    BEQ     RDCHAR      
                    RTS 
        	.ENDIF

;------------------------------------------------------------------------
;Read 1 character and convert it to HEX 
;------------------------------------------------------------------------
RD1HEX              JSR     RDCHAR
                    BRA     HEX2BIN             

;------------------------------------------------------------------------
;Read 2 HEX character and convert it to BIN 
;------------------------------------------------------------------------
RD2HEX              JSR     RD1HEX          
                    ASL         
                    ASL         
                    ASL         
                    ASL                     
                    STA     TEMP1               
                    JSR     RD1HEX                      
                    ORA     TEMP1                                   
                    RTS         


;------------------------------------------------------------------------
;Convert AC in HEX out BIN
;------------------------------------------------------------------------
;HEX2BIN             EOR     #'0'                ;Ignore ASCII part for decimals             
;                    CMP     #9+1    
;                    BCC     .okhex              ;It was a decimal digit!
;                    ADC     #$88                ;Map letters A - F to $FA-FF
;                    CMP     #$fa
;                    BCC     .invalid            ;No hex digit anymore!
 ;                   AND     #$0F            
;.okhex              RTS
;.invalid            LDA     #FAIL
;                    RTS                         

;------------------------------------------------------------------------
; HEX2BIN (Extreme Size Optimization: 20 Bytes)
; Expects: ASCII in A
; Returns: Binary 0-15 in A, or FAIL if invalid.
;------------------------------------------------------------------------
HEX2BIN             EOR     #'0'        ; Maps '0'-'9' to 0-9. Maps A-F to $71-$76, a-f to $51-$56
                    CMP     #10         ; If A < 10, Carry = 0. If A >= 10, Carry = 1.
                    BCC     .DONE       ; 0-9 finished! Branches with exact binary value.
                    
                    ORA     #$20        ; Magic: Folds both $71-$76 (A-F) and $51-$56 (a-f) into $71-$76!
                    SBC     #$71        ; C=1 from CMP, so no borrow. $71-$76 safely becomes 0-5.
                    CMP     #6          ; Is it > 5? (Sets C=0 if it is valid 0-5)
                    BCS     .INVALID    ; If it wasn't a valid hex letter, reject it.
                    
                    ADC     #10         ; C=0 from CMP, so it perfectly adds exactly 10.
.DONE               RTS
.INVALID            LDA     #FAIL
                    RTS


;--------------------------------------------------------------
;Restore saved registers - used for Tracing
;--------------------------------------------------------------
RESTORE             LDA     SAVP                ;Restore 6502 Register Contents 
                    PHA                         ;Used by tracing software
                    LDA     SAVA    
                    LDX     SAVX
                    LDY     SAVY
                    PLP
                    RTS


;------------------------------------------------------------------------
; Save HW registers
;------------------------------------------------------------------------       
SAVE                STA     SAVA                ;Save 6502 HW registers
                    STX     SAVX
                    STY     SAVY
                    PHP
                    PLA
                    STA     SAVP                ;svae the flags
                    TSX
                    STX     SAVS                ;stack pointer              
                    RTS 


;------------------------------------------------------------------------
;Convert keyboard buffer to uppercase           
;------------------------------------------------------------------------
UPPERCASE           LDA     IN,x
                    CMP     #'z'+1              
                    BCS     .NEXTDIGIT          
                    CMP     #'a'                
                    BCC     .NEXTDIGIT          
                    SBC     #SP         
                    STA     IN,x                
.NEXTDIGIT          DEX
                    BPL     UPPERCASE           ;end of string          
                    RTS         
 
 
        .IF LCD_ROUTINES
;------------------------------------------------------------------------
; *** LCD initialisation
;------------------------------------------------------------------------
LCD_LINIT           LDX     #$04            ;do function set 4 times
.LINIT0             LDA     #%00111000      ;function set: 8 bit, 2 lines, 5x7
                    STA     LCD0
                    JSR     LCD_BUSY        ;wait for busy flag to clear
                    DEX
                    BNE     .LINIT0
                    LDA     #%00000110      ;entry mode set: increment, no shift
                    STA     LCD0
                    JSR     LCD_BUSY
                    LDA     #%00001110      ;display on, cursor on, blink off
                    STA     LCD0
                    JSR     LCD_BUSY
                    LDA     #$01            ;clear display
                    STA     LCD0
                    JSR     LCD_BUSY
                    LDA     #$80            ;DDRAM address set: $00
                    STA     LCD0
                    JSR     LCD_BUSY    
                    JSR     LCD_CLR         
                    INC     WR2LCD
                    JSR     STRING          
                    .ASCII  "LCD initiated  ",EOS                       
                    RTS   


;------------------------------------------------------------------------
;LCD Scroll
;------------------------------------------------------------------------
LCD_SCROLL          LDA     #%0000001
                


;------------------------------------------------------------------------
;LCD Clear screen
;------------------------------------------------------------------------
LCD_CLR             LDA     #%00000001
                    STA     LCD0                        
                    JSR     LCD_BUSY            
                    RTS


;------------------------------------------------------------------------           
;LCD_home           
;------------------------------------------------------------------------
LCD_HOME            LDA     #%00000011
                    STA     LCD0                        
                    JSR     LCD_BUSY            
                    RTS     


;------------------------------------------------------------------------           
;Wait for LCD busy bit to clear
;------------------------------------------------------------------------
LCD_BUSY            PHA
.LCD_BUSY0          LDA     LCD0            ;read from LCD register 0
                    AND     #%10000000      ;check bit 7 (busy)         
                    BNE     .LCD_BUSY0          
                    PLA         
                    RTS 


;------------------------------------------------------------------------                               
; *** Print character on LCD
;------------------------------------------------------------------------
LCD_WRCHAR          STA     LCD1
                    JSR     LCD_BUSY            
                    LDA     LCD0            ;get current DDRAM address          
                    AND     #%01111111      ;everthing but busy flag            
                    CMP     #20             ;wrap from pos $13 (line 1 char 20)...          
                    BNE     .LCDPRINT0          
                    LDA     #$C0            ;...to $40 (line 2 char 1)          
                    STA     LCD0            
                    JSR     LCD_BUSY
.LCDPRINT0          RTS


;;------------------------------------------------------------------------
;prints a string ending with EOS 
;------------------------------------------------------------------------
;LCD_STRING         INC     WR2LCD  
;                   JSR     STRING
;                   STZ     WR2LCD  
;                   RTS         
            
        .ENDIF                      ;End of LCD Routines
