00965  ;------------------------------------------------------------------------
00966  ;Attached address to Whatch in Trace 
00967  ;------------------------------------------------------------------------ 
00968  00E452  20 42 E8      CMD_WATCH           JSR     GET_VAL             ;Get the line number value
00969  00E455  D0 24                             BNE     .RTS                ;An error occurred!
00970  00E457  84 AD                             STY     WHATCH              ;Get first whatch address
00971  00E459  85 AE                             STA     WHATCH+1                    
00972                      
00973  00E45B  B5 19                             LDA     IN,X                ;Does the increment follow?
00974  00E45D  C9 2C                             CMP     #','
00975  00E45F  D0 1A                             BNE     .RTS                ;Nope!                  
00976  00E461  E8                                INX
00977  00E462  20 42 E8                          JSR     GET_VAL             ;Get send Whatc
00978  00E465  D0 14                             BNE     .RTS                ;An error occurred!
00979  00E467  84 AF                             STY     WHATCH+2            ;store second address
00980  00E469  85 B0                             STA     WHATCH+3                    
00981                      
00982  00E46B  B5 19                             LDA     IN,X                ;Does the increment follow?
00983  00E46D  C9 2C                             CMP     #','
00984  00E46F  D0 0A                             BNE     .RTS                ;Nope!                  
00985  00E471  E8                                INX
00986  00E472  20 42 E8                          JSR     GET_VAL             ;Get send Whatc
00987  00E475  D0 04                             BNE     .RTS                ;An error occurred!
00988  00E477  84 B1                             STY     WHATCH+4            ;Get 3rd address
00989  00E479  85 B2                             STA     WHATCH+5
00990  00E47B  60            .RTS                RTS
