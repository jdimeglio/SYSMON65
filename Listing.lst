04700  ;------------------------------------------------------------------------------------------
04701  ; Reset vector - can be redirect via software if byte A5 is found at USRRST
04702  ;------------------------------------------------------------------------------------------
04703  00FA4F  78            RESET_VECTOR        SEI                         ;Hardware reset routine
04704  00FA50  AD 02 01                          LDA     USRRST              ;Check what vector to use
04705  00FA53  49 A5                             EOR     #$A5                ; user vector or hardware
04706  00FA55  CD 04 01                          CMP     USRRST+2
04707  00FA58  D0 03                             BNE     COLD_BOOT 
04708  00FA5A  6C 02 01                          JMP     (USRRST)            ;User Rest Vector
04709          
04710                  
04711  00FA5D  A9 6C         COLD_BOOT           LDA     #<RESET_RETURN      ;User user vector stored
04712  00FA5F  8D 02 01                          STA     USRRST
04713  00FA62  49 A5                             EOR     #$A5    
04714  00FA64  8D 04 01                          STA     USRRST+2
04715  00FA67  A9 FA                             LDA     #>RESET_RETURN  
04716  00FA69  8D 03 01                          STA     USRRST+1
