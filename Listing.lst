01199  00E5A6  20 42 E6      SCAN_KEYBOARD       JSR     CHECK_WIN_FRAME 
01200  00E5A9  20 74 E5                          JSR     MOVETOCUROR         ;move cursor from SAVX,SAVY
01201  00E5AC  20 F1 FB                          JSR     RDCHAR              ;read keyboard
01202  00E5AF  C9 1B                             CMP     #ESC                ;ESCAPE for exit
01203  00E5B1  F0 20                             BEQ     .EXIT               ;Exit                       
01204  
01205              
01206  00E5B3  C9 4B         .CHECKRIGHT         CMP     #RIGHTARROW         ;Check right key 
01207  00E5B5  D0 04                             BNE     .CHECKLEFT                              
01208  00E5B7  E6 AB                             INC     SAVX                                    
01209  00E5B9  80 EB                             BRA     SCAN_KEYBOARD
01210                          
01211  00E5BB  C9 4A         .CHECKLEFT          CMP     #LEFTARROW
01212  00E5BD  D0 04                             BNE     .CHECKDOWN                          
01213  00E5BF  C6 AB                             DEC     SAVX                ;one byte of RAM
01214  00E5C1  80 E3                             BRA     SCAN_KEYBOARD
01215  
01216  00E5C3  C9 4D         .CHECKDOWN          CMP     #DOWNARROW
01217  00E5C5  D0 04                             BNE     .CHECKUP                    
01218  00E5C7  E6 AA                             INC     SAVY                ;Update RAM Cordinates
01219  00E5C9  80 DB                             BRA     SCAN_KEYBOARD
01220  
01221  00E5CB  C9 49         .CHECKUP            CMP     #UPARROW
01222  00E5CD  D0 0C                             BNE     .DIGITCHECK                 
01223  00E5CF  C6 AA                             DEC     SAVY
01224  00E5D1  80 D3                             BRA     SCAN_KEYBOARD
01225                      
01226                      
01227  00E5D3  A0 12         .EXIT               LDY     #18                 ;return cursor to bottom of screen           
01228  00E5D5  A2 00                             LDX     #00                 
01229  00E5D7  20 2E FB                          JSR     GOTOXY
01230  00E5DA  60            		    RTS 
01231              
01232  .DIGITCHECK         ; At this point, A holds the key pressed. Is it a Hex character?
01233  00E5DB  C9 30                             CMP     #'0'
01234  00E5DD  90 14                             BCC     .NOT_HEX
01235  00E5DF  C9 3A                             CMP     #'9'+1
01236  00E5E1  90 13                             BCC     .IS_HEX_CHAR
01237  00E5E3  C9 41                             CMP     #'A'
01238  00E5E5  90 0C                             BCC     .NOT_HEX
01239  00E5E7  C9 47                             CMP     #'F'+1
01240  00E5E9  90 0B                             BCC     .IS_HEX_CHAR
01241  00E5EB  C9 61                             CMP     #'a'
01242  00E5ED  90 04                             BCC     .NOT_HEX
01243  00E5EF  C9 67                             CMP     #'f'+1
01244  00E5F1  90 03                             BCC     .IS_HEX_CHAR
01245                      
01246  00E5F3  4C A6 E5      .NOT_HEX            JMP     SCAN_KEYBOARD       ; Not an arrow, not hex. Ignore it.
01247  
01248  .IS_HEX_CHAR        ; User typed the FIRST valid hex digit!
01249  00E5F6  20 10 FC                          JSR     HEX2BIN             ; Use your library routine to get 0-15
01250  00E5F9  0A                                ASL     
01251  00E5FA  0A                                ASL     
01252  00E5FB  0A                                ASL     
01253  00E5FC  0A                                ASL     
01254  00E5FD  85 D2                             STA     HEXVAL              ; Save the High Nibble 
01255                      
01256  00E5FF  20 F1 FB      .WAIT_SEC_CHAR      JSR     RDCHAR              ; Wait for the SECOND hex digit
01257  00E602  C9 30                             CMP     #'0'
01258  00E604  90 F9                             BCC     .WAIT_SEC_CHAR
01259  00E606  C9 3A                             CMP     #'9'+1
01260  00E608  90 12                             BCC     .GOT_SEC_CHAR
01261  00E60A  C9 41                             CMP     #'A'
01262  00E60C  90 F1                             BCC     .WAIT_SEC_CHAR
01263  00E60E  C9 47                             CMP     #'F'+1
01264  00E610  90 0A                             BCC     .GOT_SEC_CHAR
01265  00E612  C9 61                             CMP     #'a'
01266  00E614  90 E9                             BCC     .WAIT_SEC_CHAR
01267  00E616  C9 67                             CMP     #'f'+1
01268  00E618  90 02                             BCC     .GOT_SEC_CHAR
01269  00E61A  80 E3                             BRA     .WAIT_SEC_CHAR      ; Ignore typos, wait for valid hex
01270                      
01271  .GOT_SEC_CHAR       ; User typed the SECOND valid hex digit!
01272  00E61C  20 10 FC                          JSR     HEX2BIN             ; Use library routine again
01273  00E61F  05 D2                             ORA     HEXVAL              ; Combine Low Nibble with High Nibble
01274  00E621  85 D2                             STA     HEXVAL              ; Save the final completed byte
01275                      
01276                      ; Calculate Memory Address
01277  00E623  A5 AA                             LDA     SAVY                
01278  00E625  0A                                ASL                        
01279  00E626  0A                                ASL              
01280  00E627  0A                                ASL     
01281  00E628  0A                                ASL      
01282  00E629  85 E7                             STA     TEMP1               ; TEMP1 = SAVY * 16
01283  00E62B  A5 AB                             LDA     SAVX            
01284  00E62D  18                                CLC
01285  00E62E  65 E7                             ADC     TEMP1               ; Y * 16 + X                                                
01286  00E630  A8                                TAY                         
01287  00E631  A5 D2                             LDA     HEXVAL  
01288  00E633  91 E1                             STA     (DEST),Y            ; Write the assembled byte to RAM!
01289                      
01290                      ; --- IN-PLACE VISUAL UPDATE ---
01291  00E635  20 74 E5                          JSR     MOVETOCUROR         ; Ensure cursor is pinned
01292  00E638  A5 D2                             LDA     HEXVAL
01293  00E63A  20 C1 FB                          JSR     WR2HEX              ; Print new byte directly over the old one
01294                      
01295                      ; Auto-Advance the cursor to the right
01296  00E63D  E6 AB                             INC     SAVX
01297  00E63F  4C A6 E5                          JMP     SCAN_KEYBOARD       ; Go back (CHECK_WIN_FRAME handles line-wrapping!)             
01298  
01299  ;------------------------------------------------------------------------
01300  ;Dump Offsets to Screen -   ;check if within Window Frame
01301  ;------------------------------------------------------------------------           
01302  00E642  A6 AB         CHECK_WIN_FRAME     LDX     SAVX                ;Load up X,Y            
01303  00E644  A4 AA                             LDY     SAVY
01304  00E646  E0 00                             CPX     #00                 ;did it go neg
01305  00E648  10 07                             BPL     .CHECK_X_MAX                    
01306  00E64A  64 AB                             STZ     SAVX                                
01307  00E64C  88                                DEY
01308  00E64D  C6 AA                             DEC     SAVY                ;go back a screen load                                  
01309  00E64F  80 1D                             BRA     .CHECK_Y_MIN        ;have to jump X=$FF here    
01310                  
01311  00E651  E0 10         .CHECK_X_MAX        CPX     #16                 ;X limit
01312  00E653  90 05                             BCC     .CHECK_Y_MAX
01313  00E655  64 AB                             STZ     SAVX                ;New Line eg CR   
01314  00E657  C8                                INY 
01315  00E658  E6 AA                             INC     SAVY                ;LF eqivilent   
01316                  
01317  00E65A  C0 10         .CHECK_Y_MAX        CPY     #16                 ;Y screen limit
01318  00E65C  90 10                             BCC     .CHECK_Y_MIN        ;Not exceed then check Y min
01319  00E65E  C6 AA                             DEC     SAVY                ;adjust Y + $FF bytes forward
01320  00E660  A5 E1                             LDA     DEST
01321  00E662  18                                CLC
01322  00E663  69 10                             ADC     #$10
01323  00E665  85 E1                             STA     DEST
01324  00E667  90 02                             BCC     .SKIP_ADC
01325  00E669  E6 E2                             INC     DEST+1              
01326  00E66B  4C 82 E5      .SKIP_ADC           JMP     DRAW_SCREEN         ;redraw screen & then RTS
01327                      
01328  00E66E  C0 00         .CHECK_Y_MIN        CPY     #00
01329  00E670  10 10                             BPL     .EXIT         
01330  00E672  64 AA                             STZ     SAVY            
01331  00E674  A5 E1                             LDA     DEST                ;sbc 1 page
01332  00E676  38                                SEC 
01333  00E677  E9 10                             SBC     #$10
01334  00E679  85 E1                             STA     DEST
01335  00E67B  B0 02                             BCS     .SKIP_SBC
01336  00E67D  C6 E2                             DEC     DEST+1
01337  00E67F  4C 82 E5      .SKIP_SBC           JMP     DRAW_SCREEN         ;redraw screen & then RTS                               
01338  00E682  60            .EXIT              RTS                         ;save a byte
01339  
01340  
01341  ;------------------------------------------------------------------------
01342  ;Dump Offsets to Screen
01343  ;------------------------------------------------------------------------ 
01344  00E683  A2 09         DMPGR               LDX     #XEDGE              ;Send 9 [SPACE] to terminal
01345  00E685  20 A9 FB                          JSR     WRBL2
01346  00E688  A0 00                             LDY     #$00
01347  00E68A  A2 04                             LDX     #$04                ;Initialize line counter                                
01348  00E68C  98            .LOOP1              TYA                         ;Send "00" thru "0F", separated by 2 [SPACE], to terminal  
01349  00E68D  20 C1 FB                          JSR     WR2HEX 
01350  00E690  20 8D FB                          JSR     WRSPACE                 
01351  00E693  CA                                DEX
01352  00E694  D0 05                             BNE     .SKIPSP
01353  00E696  A2 04                             LDX     #04
01354  00E698  20 8D FB                          JSR     WRSPACE                 
01355  00E69B  C8            .SKIPSP             INY                                 
01356  00E69C  C0 10                             CPY     #$10
01357  00E69E  D0 EC                             BNE     .LOOP1
01358  00E6A0  60                                RTS                         ;Done DMPGR or MEMDMP subroutine, RETURN
01359  
01360  
01361  ;------------------------------------------------------------------------
01362  ; Move a part of memory down (to delete or shorten source lines)
01363  ;
01364  ; SRCE  2       Address of source data (destroyed)
01365  ; DEST  2       Address of destination data (destroyed)
01366  ; LENG  2       Holds the number of bytes to move
01367  ;------------------------------------------------------------------------
01368  00E6A1  A0 00         MOV_DOWN            LDY     #0                  ;Clear index in 256 byte blocks
01369  00E6A3  A6 DE                             LDX     LENG+1              ;Get number of blocks to be moved
01370  00E6A5  F0 0E                             BEQ     .LAST               ;Move last (partial) block
01371  00E6A7  B1 DF         .LOOP1              LDA     (SRCE),Y            ;Move this byte
01372  00E6A9  91 E1                             STA     (DEST),Y
01373  00E6AB  C8                                INY                         ;Point to next byte in block
01374  00E6AC  D0 F9                             BNE     .LOOP1              ;Block not done yet!
01375  00E6AE  E6 E0                             INC     SRCE+1              ;Point to next block
01376  00E6B0  E6 E2                             INC     DEST+1
01377  00E6B2  CA                                DEX                         ;Count down blocks
01378  00E6B3  D0 F2                             BNE     .LOOP1              ;Not all blocs done yet!
01379  00E6B5  A6 DD         .LAST               LDX     LENG                ;Count remainder of last block
01380  00E6B7  F0 08                             BEQ     .EXIT               ;Oh, there is no remainder!
01381  00E6B9  B1 DF         .LOOP2              LDA     (SRCE),Y            ;Move this byte
01382  00E6BB  91 E1                             STA     (DEST),Y
01383  00E6BD  C8                                INY                         ;Point to next byte in last block
01384  00E6BE  CA                                DEX                         ;Count down the bytes
01385  00E6BF  D0 F8                             BNE     .LOOP2              ;Last block not done yet!
01386  00E6C1  60            .EXIT               RTS
01387  
01388  
01389  ;------------------------------------------------------------------------
01390  ; Move a part of memory up (to make room for new or longer source line)
01391  ;
01392  ; SRCE  2       Address of source data
01393  ; DEST  2       Address of destination data
01394  ; LENG  2       Holds number of bytes to move
01395  ;
01396  ;------------------------------------------------------------------------
01397  00E6C2  A6 DE         MOV_UP              LDX     LENG+1              ;We have started the move at the
01398  00E6C4  18                                CLC                         ;end otherwise we risk
01399  00E6C5  8A                                TXA                         ;overwriting the source
01400  00E6C6  65 E0                             ADC     SRCE+1
01401  00E6C8  85 E0                             STA     SRCE+1              ;So add Length-High to source and
01402  00E6CA  18                                CLC                         ;destination address
01403  00E6CB  8A                                TXA
01404  00E6CC  65 E2                             ADC     DEST+1
01405  00E6CE  85 E2                             STA     DEST+1
01406  00E6D0  E8                                INX                         ;Allow BNE to signal the end
01407  00E6D1  A4 DD                             LDY     LENG
01408  00E6D3  F0 0E                             BEQ     .PAGE               ;Only entire pages to be moved!
01409  00E6D5  88                                DEY
01410  00E6D6  F0 07                             BEQ     .PART               ;Move last, partial, page first!
01411  00E6D8  B1 DF         .LOOP1              LDA     (SRCE),Y            ;Move one entire page
01412  00E6DA  91 E1                             STA     (DEST),Y
01413  00E6DC  88                                DEY                         ; backwards
01414  00E6DD  D0 F9                             BNE     .LOOP1              ;Page not done yet
01415  00E6DF  B1 DF         .PART               LDA     (SRCE),Y            ;Move first byte of page too
01416  00E6E1  91 E1                             STA     (DEST),Y
01417  00E6E3  88            .PAGE               DEY
01418  00E6E4  C6 E0                             DEC     SRCE+1              ;Decrement source and destination
01419  00E6E6  C6 E2                             DEC     DEST+1
01420  00E6E8  CA                                DEX
01421  00E6E9  D0 ED                             BNE     .LOOP1              ;Move all pages!
01422  00E6EB  60                                RTS
01423  
01424  
01425  ;------------------------------------------------------------------------
01426  ; Print error c=1 means its ERROR messages
01427  ;------------------------------------------------------------------------
01428  00E6EC  A4 C9         PRINT_MSGS          LDY     ERROR
01429  00E6EE  D0 0B                             BNE     ERRORMSGS           ;normal string      
01430  00E6F0  A0 D6         PRINT_ERR           LDY     #<TEXT1             ;Error texts
01431  00E6F2  84 DF                             STY     SRCE
01432  00E6F4  A0 E7                             LDY     #>TEXT1 
01433  00E6F6  84 E0                             STY     SRCE+1
01434  00E6F8  A8                                TAY                         ;index to message string
01435  00E6F9  80 0F                             BRA     PRINT_SRCE
01436          
01437  00E6FB  A9 17         ERRORMSGS           LDA     #<TEXT              ;noramal texts      
01438  00E6FD  85 DF                             STA     SRCE
01439  00E6FF  A9 E7                             LDA     #>TEXT 
01440  00E701  85 E0                             STA     SRCE+1              
01441  00E703  20 0A E7                          JSR     PRINT_SRCE          ;Print 3 characters                
01442  00E706  A0 00                             LDY     #0                  ;Save A
01443  00E708  84 C9                             STY     ERROR               ;Clear the error now                                                    
01444  
01445  00E70A  B1 DF         PRINT_SRCE          LDA     (SRCE),Y            ;Get character (also GLobal Print)          
01446  00E70C  48                                PHA 
01447  00E70D  29 7F                             AND     #%01111111          
01448  00E70F  20 98 FB                          JSR     WRCHAR              ; and print it
01449  00E712  C8                                INY                         ;check if it exceed 127
01450  00E713  68                                PLA                
01451  00E714  10 F4                             BPL     PRINT_SRCE          ; is bit=8 =1                              
01452  00E716  60                                RTS
01453  
01454  
01455  ;------------------------------------------------------------------------
01456  ; Error Messages - TODO - Can be impoved
01457  ;------------------------------------------------------------------------
01458  
01459  TEXT                .ASCII      " ERROR",CR,LF + $80                                    
01460  PNTR_ERR_SYN        .ASCIS      " :SYNTAX"                      ;Syntax error
01461  PNTR_ERR_LBL        .ASCIS      " :LABEL"                       ;Label error / no global 
01462  PNTR_ERR_RNG        .ASCIS      " :INVALID RANGE"               ;Range error
01463  PNTR_ERR_MIS        .ASCIS      " :MISSING PARAMETER or OPERAND";Missing parameter/operand
01464  PNTR_ERR_DIV        .ASCIS      " :DIVIDE by 0"                 ;Divide by 0 error
01465  PNTR_ERR_MEM        .ASCIS      " :MEMORY FULL"                 ;Memory full / illegal TA 
01466  PNTR_ERR_DEF        .ASCIS      " :UNDEFINED LABEL"             ;Undefined label
01467  PNTR_ERR_DIR        .ASCIS      " :ILLEGAL DIRECTIVE"           ;Illegal directive error
01468  PNTR_ERR_OPE        .ASCIS      " :OPERAND"                     ;Operand error
01469  PNTR_ERR_MNE        .ASCIS      " :MNEMONIC "                   ;Mnemonic error
01470  PNTR_ERR_EXT        .ASCIS      " :EXTRAT DEFINATION"           ;Extra definition error
01471  PNTR_ERR_WRT        .ASCIS      " :UNABLE TO WRITE/READ"        ;Read/Write Error
01472              
01473  TEXT1               .ASCIS      "AUTONUM ENABLE starting "      ;
01474  PNTR_ERRORS         .ASCII      " COMPILE ERROR(s)",CR,LF + $80
01475  ;PNTR_CANCEL         .ASCIS      "/"     
01476  PNTR_CODE_ORG       .ASCIS      ".ORG ->"
01477  ;PNTR_ADDR_MSG       .ASCIS      "addrs"
01478  
01479    0008              ERR_SYN     =   PNTR_ERR_SYN - TEXT                             ;index to messages 
01480    0010              ERR_LBL     =   PNTR_ERR_LBL - TEXT     
01481    0017              ERR_RNG     =   PNTR_ERR_RNG - TEXT    
01482    0026              ERR_MIS     =   PNTR_ERR_MIS - TEXT    
01483    0044              ERR_DIV     =   PNTR_ERR_DIV - TEXT    
01484    0051              ERR_MEM     =   PNTR_ERR_MEM - TEXT     
01485    005E              ERR_DEF     =   PNTR_ERR_DEF - TEXT     
01486    006F              ERR_DIR     =   PNTR_ERR_DIR - TEXT     
01487    0082              ERR_OPE     =   PNTR_ERR_OPE - TEXT    
01488    008B              ERR_MNE     =   PNTR_ERR_MNE - TEXT     
01489    0096              ERR_EXT     =   PNTR_ERR_EXT - TEXT    
01490    00A9              ERR_WRT     =   PNTR_ERR_WRT - TEXT    
01491  
01492  ;standard messages
01493  
01494    0000              AUTOTEXT    =   0               ;Flag to set aut oumbering
01495    0018              STR_ERRORS  =   PNTR_ERRORS  - TEXT1    
01496  ;STR_CANCEL  =   PNTR_CANCEL  - TEXT1
01497    002B              CODE_ORG    =   PNTR_CODE_ORG  - TEXT1
01498  ;ADDR_MSG    =   PNTR_ADDR_MSG - TEXT1   
01499          
01500  ;------------------------------------------------------------------------
01501  ; Find next non space
01502  ; Z=1 if EOL found
01503  ;------------------------------------------------------------------------
01504  
01505  00E808  A2 00         FIRSTNONSPC         LDX     #0                  ;Start at the begin of the line
01506  00E80A  B5 19         NNONSPC             LDA     IN,X                ;Is this a space?
01507  00E80C  C9 20                             CMP     #SP
01508  00E80E  D0 03                             BNE     .NOSPACE            ;It is not!
01509  00E810  E8                                INX
01510  00E811  80 F7                             BRA     NNONSPC             ;Always taken!
01511  00E813  C9 0D         .NOSPACE            CMP     #CR                 ;Set Z if we're at EOL
01512  00E815  60                                RTS
01513  
01514  ;------------------------------------------------------------------------
01515  ; Initialise the assembler before we can start
01516  ;------------------------------------------------------------------------
01517  
01518  00E816  D8            INIT                CLD                         ;You'll never know
01519          .IF LCD_ROUTINES        
01520                                                  ;Memory scan
01521  00E817  A5 F7         .LOOP               LDA     HIMEM+1             ;Stop if we run into our own code (himem +1)
01522  00E819  C9 E0                             CMP     #>COLD              ;/COLD
01523  00E81B  F0 18                             BEQ     .THATSIT
01524  00E81D  B1 F6                             LDA     (HIMEM),Y           ;See if this memory page exists
01525  00E81F  AA                                TAX                         ;Save original value
01526  00E820  A9 55                             LDA     #%01010101          ;Try this value first
01527  00E822  20 3D E8                          JSR     PROBE
01528  00E825  D0 0E                             BNE     .THATSIT            ;End of RAM!
01529  00E827  A9 AA                             LDA     #%10101010          ;Then try this value
01530  00E829  20 3D E8                          JSR     PROBE
01531  00E82C  D0 07                             BNE     .THATSIT            ;End of RAM!
01532  00E82E  8A                                TXA                         ;Restore original value
01533  00E82F  91 F6                             STA     (HIMEM),Y
01534  00E831  E6 F7                             INC     HIMEM+1             ;Try next memory page
01535  00E833  10 E2                             BPL     .LOOP               ;No need to proceed beyond $8000!
01536  00E835  20 C8 EC      .THATSIT            JSR     SHOWMEM
01537  00E838  A0 00                             LDY     #$00                ;set EOR flag to zero   
01538  00E83A  4C B0 ED                          JMP     DONEW               ;Do new command (Y must be $00)
01539           
01540  ;------------------------------------------------------------------------
01541  ; Probe memory location
01542  ;------------------------------------------------------------------------
01543  00E83D  91 F6         PROBE               STA     (HIMEM),Y           ;Store this value
01544  00E83F  D1 F6                             CMP     (HIMEM),Y           ;See if it was accepted
01545  00E841  60            XEC_RTS             RTS             
01546          
01547  ;------------------------------------------------------------------------
01548  ; Get a single 16-bit value from input line
01549  ;------------------------------------------------------------------------
01550  
01551  00E842  64 CF         GET_VAL             STZ     NEG_FLAG            ;Clear negative flag
01552  00E844  64 D2                             STZ     HEXVAL              ;Clear end result
01553  00E846  64 D3                             STZ     HEXVAL+1
01554  00E848  64 D1                             STZ     DELIM               ;Clear digit entered flag
01555  00E84A  64 C9                             STZ     ERROR                                                              
01556  00E84C  B5 19                             LDA     IN,X                ;Read character from IN
01557  00E84E  C9 2B                             CMP     #'+'                ;Is it explicit positive?
01558  00E850  F0 06                             BEQ     .POS                ;Yes!
01559  00E852  C9 2D                             CMP     #'-'                ;Is it a negative number?
01560  00E854  D0 05                             BNE     .NOSIGN             ;No! No prefix sign given
01561  00E856  85 CF                             STA     NEG_FLAG            ;Set negative flag
01562  00E858  E8            .POS                INX                         ;Point to next byte in IN
01563  00E859  B5 19                             LDA     IN,X                ; and get it
01564  
01565  00E85B  C9 30         .NOSIGN             CMP     #'0'                ;Could it be a decimal number?
01566  00E85D  90 40                             BCC     .HEX                ;Nope!
01567  00E85F  C9 3A                             CMP     #'9'+1
01568  00E861  B0 3C                             BCS     .HEX                ;Nope!
01569  
01570  ;------------------------------------------------------------------------
01571  ; Convert a decimal number to binary
01572  ;------------------------------------------------------------------------
01573  00E863  49 30         .DECLOOP            EOR     #'0'                ;Strip ASCII part
01574  00E865  C9 0A                             CMP     #9+1                ;Is it still a decimal digit?
01575  00E867  B0 64                             BCS     .DONEG1             ;Nope!
01576  00E869  A8                                TAY                         ;Save new digit
01577  00E86A  06 D2                             ASL     HEXVAL              ;Multiply previous value by 10
01578  00E86C  26 D3                             ROL     HEXVAL+1
01579  00E86E  B0 60                             BCS     .RANGE              ;Exit with range error!
01580  00E870  A5 D2                             LDA     HEXVAL
01581  00E872  0A                                ASL
01582  00E873  85 DA                             STA     DEC_SAVE
01583  00E875  A5 D3                             LDA     HEXVAL+1
01584  00E877  2A                                ROL
01585  00E878  B0 56                             BCS     .RANGE              ;Exit with range error!
01586  00E87A  06 DA                             ASL     DEC_SAVE
01587  00E87C  2A                                ROL
01588  00E87D  85 DB                             STA     DEC_SAVE+1
01589  00E87F  B0 4F                             BCS     .RANGE              ;Exit with range error!
01590  00E881  A5 DA                             LDA     DEC_SAVE
01591  00E883  65 D2                             ADC     HEXVAL
01592  00E885  85 D2                             STA     HEXVAL
01593  00E887  A5 DB                             LDA     DEC_SAVE+1
01594  00E889  65 D3                             ADC     HEXVAL+1
01595  00E88B  85 D3                             STA     HEXVAL+1
01596  00E88D  B0 41                             BCS     .RANGE              ;Exit with range error!
01597  00E88F  98                                TYA                         ;Add new digit to result
01598  00E890  65 D2                             ADC     HEXVAL
01599  00E892  85 D2                             STA     HEXVAL
01600  00E894  90 04                             BCC     .NOCY               ;No carry to high byte
01601  00E896  E6 D3                             INC     HEXVAL+1
01602  00E898  F0 36                             BEQ     .RANGE              ;Exit with range error!
01603  00E89A  E8            .NOCY               INX                         ;Point to next digit
01604  00E89B  B5 19                             LDA     IN,X                ; and get it
01605  00E89D  80 C4                             BRA     .DECLOOP            ;Always taken!
01606  
01607  ;------------------------------------------------------------------------
01608  ; Convert a hex number 16bit
01609  ;------------------------------------------------------------------------
01610  00E89F  C9 24         .HEX                CMP     #'$'                ;Is it a hex number?
01611  00E8A1  D0 30                             BNE     .BIN                ;Nope!
01612  00E8A3  E8            .HEXLOOP            INX                         ;Get next character from IN
01613  00E8A4  B5 19                             LDA     IN,X
01614  00E8A6  20 10 FC                          JSR     HEX2BIN                
01615  00E8A9  C9 FF                             CMP     #FAIL
01616  00E8AB  F0 14                             BEQ     .NOTHEX             ;No hex digit anymore!
01617  00E8AD  0A            .DIG                ASL                         ;Left justify new nibble
01618  00E8AE  0A                                ASL
01619  00E8AF  0A                                ASL
01620  00E8B0  0A                                ASL
01621  00E8B1  A0 04                             LDY     #4                  ;Set shift counter
01622  00E8B3  84 D1                             STY     DELIM               ;Indicate that input is correct
01623  00E8B5  0A            .HEXSHIFT           ASL                         ;Shift new bit into result
01624  00E8B6  26 D2                             ROL     HEXVAL
01625  00E8B8  26 D3                             ROL     HEXVAL+1
01626  00E8BA  B0 14                             BCS     .RANGE              ;Exit with range error!
01627  00E8BC  88                                DEY                         ;Decrement counter
01628  00E8BD  D0 F6                             BNE     .HEXSHIFT           ;Do all 4 bits
01629  00E8BF  F0 E2                             BEQ     .HEXLOOP            ;Do next nibble (if any)!
01630  00E8C1  A5 D1         .NOTHEX             LDA     DELIM               ;Was a digit entered?
01631  00E8C3  D0 08                             BNE     .DONEG1             ;Yes!
01632  00E8C5  A5 BF                             LDA     PC_BEG              ;If not it was the PC value!
01633  00E8C7  85 D2                             STA     HEXVAL
01634  00E8C9  A5 C0                             LDA     PC_BEG+1
01635  00E8CB  85 D3                             STA     HEXVAL+1
01636  00E8CD  4C 23 E9      .DONEG1             JMP     .DONEG              ;Check negative flag & we're done
01637  00E8D0  4C CE F4      .RANGE              JMP     RANGE_ERROR         ;Exit with range error
01638  
01639  
01640  ;------------------------------------------------------------------------
01641  ; Convert ASCII a binary number eg %..1.01.. 
01642  ;------------------------------------------------------------------------
01643  00E8D3  C9 25         .BIN                CMP     #'%'                ;Is it a binary number?
01644  00E8D5  D0 38                             BNE     .PASC               ;Nope!
01645  00E8D7  E8            .BINLOOP            INX                         ;Point to next char
01646  00E8D8  B5 19                             LDA     IN,X                ; and get it
01647  00E8DA  C9 2E                             CMP     #'.'                ;Ignore dots (for human eyes only)
01648  00E8DC  F0 F9                             BEQ     .BINLOOP
01649  00E8DE  49 30                             EOR     #'0'                ;Ignore ASCII part
01650  00E8E0  4A                                LSR                         ;Shift bit to Carry
01651  00E8E1  D0 0A                             BNE     .EXIT               ;End of binary number
01652  00E8E3  26 D2                             ROL     HEXVAL              ;Roll new bit into end result
01653  00E8E5  26 D3                             ROL     HEXVAL+1
01654  00E8E7  B0 E7                             BCS     .RANGE              ;Range error!
01655  00E8E9  E6 D1                             INC     DELIM               ;Signal that bits were entered
01656  00E8EB  80 EA                             BRA     .BINLOOP            ;Always taken! (reasonably)
01657  
01658  00E8ED  A5 D1         .EXIT               LDA     DELIM               ;Was a number entered?
01659  00E8EF  D0 32                             BNE     .DONEG              ;Yes! Check negative flag now
01660  00E8F1  4C 67 F2                          JMP     DIR_OPE             ;Exit with operand error
01661  
01662  
01663  ;------------------------------------------------------------------------
01664  ; Now it must be a label!
01665  ;------------------------------------------------------------------------
01666  00E8F4  20 51 F3      .LABEL              JSR     FIND_LABEL          ;Find this label
01667  00E8F7  B0 13                             BCS     .OPE_ERROR          ;Exit with operand error!
01668  00E8F9  F0 09                             BEQ     .NOT_FOUND          ;Label not found!
01669  00E8FB  A5 B5                             LDA     LABEL_FLAG          ;Copy assigned flag to
01670  00E8FD  05 C3                             ORA     FORWARD             ; forward referenced flag
01671  00E8FF  85 C3                             STA     FORWARD
01672  00E901  4C 23 E9      .LBL_EXIT           JMP     .DONEG              ;Check negative flag & we're done
01673  
01674  00E904  85 D2         .NOT_FOUND          STA     HEXVAL              ;A=0, clear hex val
01675  00E906  85 D3                             STA     HEXVAL+1
01676  00E908  C6 C2                             DEC     UNDEF               ;Set undefined label flag
01677  00E90A  D0 F5                             BNE     .LBL_EXIT           ;Always taken!
01678  
01679  
01680  ;------------------------------------------------------------------------
01681  ; It's none of the above! Operand error
01682  ;------------------------------------------------------------------------
01683  00E90C  4C 67 F2      .OPE_ERROR          JMP     DIR_OPE             ;Exit with operand error
01684  
01685  
01686  ;------------------------------------------------------------------------
01687  ; Convert a positive ASCII
01688  ;------------------------------------------------------------------------
01689  00E90F  C9 27         .PASC               CMP     #'''                ;Is it a positive ASCII?
01690  00E911  D0 07                             BNE     .NASC               ;Nope!
01691  
01692  00E913  20 33 E9                          JSR     .GETASC             ;Get ASCII character
01693  00E916  29 7F                             AND     #%01111111          ;Make it positive
01694  00E918  10 07                             BPL     .ASC_END            ;Always taken!
01695  
01696  
01697  ;------------------------------------------------------------------------
01698  ; Convert a negative ASCII
01699  ;------------------------------------------------------------------------
01700  00E91A  C9 22         .NASC               CMP     #'"'                ;Is it negative ASCII?
01701  00E91C  D0 D6                             BNE     .LABEL              ;Nope!
01702  00E91E  20 33 E9                          JSR     .GETASC             ;Get ASCII character
01703  00E921  85 D2         .ASC_END            STA     HEXVAL              ;And save it
01704                                                  ;Falls through to .DONEG
01705  
01706  
01707  ;------------------------------------------------------------------------
01708  ; Check negative flag and we're done
01709  ;------------------------------------------------------------------------
01710  00E923  A5 CF         .DONEG              LDA     NEG_FLAG            ;Is the negative flag set?
01711  00E925  F0 03                             BEQ     .RTS                ;Nope!
01712  00E927  20 8A EA                          JSR     NEGATE              ;Make hexval negative;
01713  
01714  00E92A  A5 C9         .RTS                LDA     ERROR               ;Set error flag upon exit
01715  00E92C  08                                PHP                         ;Save status
01716  00E92D  A5 D3                             LDA     HEXVAL+1            ;Preload new value
01717  00E92F  A4 D2                             LDY     HEXVAL
01718  00E931  28                                PLP                         ;Restore status
01719  00E932  60                                RTS
01720  
01721  
01722  ;------------------------------------------------------------------------
01723  ;Get input until delimiter
01724  ;------------------------------------------------------------------------
01725  00E933  85 D1         .GETASC             STA     DELIM               ;Save delimiter char ( ' or ' )
01726  00E935  E8                                INX                         ;Point to actual ASCII character
01727  00E936  B5 19                             LDA     IN,X                ; and get it
01728  00E938  C9 0D                             CMP     #CR                 ;Replace CR by a space
01729  00E93A  D0 02                             BNE     .NOTCR              ;Don't bother!
01730  00E93C  A9 20                             LDA     #SP
01731  00E93E  A8            .NOTCR              TAY                         ;Temporarily save character
01732  00E93F  E8                                INX                         ;See if ASCII is terminated by
01733  00E940  B5 19                             LDA     IN,X                ; delimiter
01734  00E942  C5 D1                             CMP     DELIM
01735  00E944  D0 01                             BNE     .DELIM              ;No, don't bother to increment
01736  00E946  E8                                INX                         ; pointer once more
01737  00E947  98            .DELIM              TYA                         ;Get character back
01738  00E948  60                                RTS
01739  
01740  
01741  ;------------------------------------------------------------------------
01742  ; Get expression 
01743  ;------------------------------------------------------------------------
01744  00E949  20 42 E8      GET_EXPRES          JSR     GET_VAL             ;Get value A=hi Y=lo address
01745  00E94C  D0 1E                             BNE     .RTS                ;An error occurred!
01746  00E94E  85 D9         .NEXT               STA     EXP_SAVE+1          ;Save this value for later
01747  00E950  84 D8                             STY     EXP_SAVE
01748  00E952  B5 19                             LDA     IN,X                ;Did an operator follow the value?
01749  00E954  E8                                INX
01750  00E955  C9 2B                             CMP     #'+'
01751  00E957  F0 14                             BEQ     .ADD                ;Addition!
01752  00E959  C9 2D                             CMP     #'-'
01753  00E95B  F0 26                             BEQ     .SUB                ;Subtraction!
01754  00E95D  C9 2A                             CMP     #'*'
01755  00E95F  F0 38                             BEQ     .MUL                ;Multiplication!
01756  00E961  C9 2F                             CMP     #'/'
01757  00E963  F0 63                             BEQ     .DIV                ;Division!
01758  00E965  CA                                DEX                         ;End of expression. One too far
01759  00E966  A5 D3                             LDA     HEXVAL+1            ;Load value now
01760  00E968  A4 D2                             LDY     HEXVAL
01761  00E96A  C4 D2                             CPY     HEXVAL              ;Make Z=1 (No errors)
01762  00E96C  60            .RTS                RTS                         ;None of the above! We're done!
01763  00E96D  20 42 E8      .ADD                JSR     GET_VAL             ;Get next value
01764  00E970  D0 FA                             BNE     .RTS                ;An error occurred!
01765  00E972  18                                CLC                         ;Perform add function
01766  00E973  A5 D2                             LDA     HEXVAL
01767  00E975  65 D8                             ADC     EXP_SAVE
01768  00E977  85 D2                             STA     HEXVAL
01769  00E979  A8                                TAY
01770  00E97A  A5 D3                             LDA     HEXVAL+1
01771  00E97C  65 D9                             ADC     EXP_SAVE+1
01772  00E97E  85 D3                             STA     HEXVAL+1
01773  00E980  4C 4E E9                          JMP     .NEXT               ;More operands can follow
01774  00E983  20 42 E8      .SUB                JSR     GET_VAL             ;Get next value
01775  00E986  D0 E4                             BNE     .RTS                ;An error occurred!
01776  00E988  38                                SEC                         ;Perform subtract function
01777  00E989  A5 D8                             LDA     EXP_SAVE
01778  00E98B  E5 D2                             SBC     HEXVAL
01779  00E98D  85 D2                             STA     HEXVAL
01780  00E98F  A8                                TAY
01781  00E990  A5 D9                             LDA     EXP_SAVE+1
01782  00E992  E5 D3                             SBC     HEXVAL+1
01783  00E994  85 D3                             STA     HEXVAL+1
01784  00E996  4C 4E E9                          JMP     .NEXT               ;More operands can follow!
01785  00E999  20 42 E8      .MUL                JSR     GET_VAL             ;Get next value
01786  00E99C  D0 CE                             BNE     .RTS                ;An error occurred!
01787  00E99E  64 D6                             STZ     MULDIV              ;Clear temp result
01788  00E9A0  64 D7                             STZ     MULDIV+1
01789  00E9A2  A0 10                             LDY     #16                 ;Do 16-bit multiply
01790  00E9A4  A5 D2         .MULLOOP            LDA     HEXVAL              ;Get LSB of operand 2 in carry
01791  00E9A6  4A                                LSR
01792  00E9A7  90 0D                             BCC     .MULZERO            ;Multiply by 0! Forget about it
01793  00E9A9  18                                CLC                         ;Add shifted operand 1 to temp
01794  00E9AA  A5 D6                             LDA     MULDIV
01795  00E9AC  65 D8                             ADC     EXP_SAVE
01796  00E9AE  85 D6                             STA     MULDIV
01797  00E9B0  A5 D7                             LDA     MULDIV+1
01798  00E9B2  65 D9                             ADC     EXP_SAVE+1
01799  00E9B4  85 D7                             STA     MULDIV+1
01800  00E9B6  66 D7         .MULZERO            ROR     MULDIV+1            ;Roll temp result bit into
01801  00E9B8  66 D6                             ROR     MULDIV              ; end result
01802  00E9BA  66 D3                             ROR     HEXVAL+1
01803  00E9BC  66 D2                             ROR     HEXVAL
01804  00E9BE  88                                DEY
01805  00E9BF  D0 E3                             BNE     .MULLOOP            ;Do all 16 bits!
01806  00E9C1  A4 D2                             LDY     HEXVAL              ;Preload the value
01807  00E9C3  A5 D3                             LDA     HEXVAL+1
01808  00E9C5  4C 4E E9                          JMP     .NEXT               ;More operands can follow!
01809  00E9C8  20 42 E8      .DIV                JSR     GET_VAL             ;Get next value
01810  00E9CB  D0 9F                             BNE     .RTS                ;An error occurred
01811  00E9CD  A5 D2                             LDA     HEXVAL              ;Avoid divide by 0
01812  00E9CF  05 D3                             ORA     HEXVAL+1
01813  00E9D1  F0 31                             BEQ     .DIVERR             ;It is divide by 0!
01814  00E9D3  64 D6                             STZ     MULDIV              ;Clear temp result
01815  00E9D5  64 D7                             STZ     MULDIV+1           
01816  00E9D7  A0 10                             LDY     #16                 ;Do 16-bit multiply
01817  00E9D9  06 D8         .DIVLOOP            ASL     EXP_SAVE            ;Roll 1 bit out of operand 1
01818  00E9DB  26 D9                             ROL     EXP_SAVE+1
01819  00E9DD  26 D6                             ROL     MULDIV
01820  00E9DF  26 D7                             ROL     MULDIV+1
01821  00E9E1  38                                SEC                         ; Does operand 2 go into temp?
01822  00E9E2  A5 D6                             LDA     MULDIV
01823  00E9E4  E5 D2                             SBC     HEXVAL
01824  00E9E6  85 E7                             STA     TEMP1               ; OPTIMIZATION: Save trial low byte to Zero Page
01825  00E9E8  A5 D7                             LDA     MULDIV+1
01826  00E9EA  E5 D3                             SBC     HEXVAL+1
01827  00E9EC  90 08                             BCC     .DIVSKIP            ; It didn't go! Skip updating MULDIV
01828  00E9EE  E6 D8                             INC     EXP_SAVE            ; It went! Set low bit of quotient
01829  00E9F0  85 D7                             STA     MULDIV+1            ; Save new high byte
01830  00E9F2  A5 E7                             LDA     TEMP1               ; Retrieve trial low byte from ZP
01831  00E9F4  85 D6                             STA     MULDIV              ; Save new low byte
01832  00E9F6  88            .DIVSKIP            DEY
01833  00E9F7  D0 E0                             BNE     .DIVLOOP            ; Do all 16 bits!
01834  00E9F9  A4 D8                             LDY     EXP_SAVE            ;Preload the value
01835  00E9FB  84 D2                             STY     HEXVAL
01836  00E9FD  A5 D9                             LDA     EXP_SAVE+1
01837  00E9FF  85 D3                             STA     HEXVAL+1
01838  00EA01  4C 4E E9      .NEXT_STEP          JMP     .NEXT               ;More operands can follow!
01839  00EA04  A5 B0         .DIVERR             LDA     PASS                ;Ignore div 0 during pass 1
01840  00EA06  F0 F9                             BEQ     .NEXT_STEP          ;It is pass 0!
01841  00EA08  A9 44                             LDA     #ERR_DIV            ;Exit with divide by 0 error
01842  00EA0A  85 C9                             STA     ERROR
01843  00EA0C  60                                RTS
01844  
