03684  
03685  ;------------------------------------------------------------------------
03686  ; Make Object code from NME
03687  ; MNE is in CURMNE, addr mode is in CURADM
03688  ; and the args are in HEXVAL,H
03689  ; calculate the object code, and update PC
03690  ;------------------------------------------------------------------------
03691  00F52A  A4 C6         MKOBJC              LDY     CURMNE          ;Index to the table
03692  00F52C  B9 E6 F7                          LDA     BASE,Y          ;get base value for current mnemonic
03693  00F52F  A6 C7                             LDX     CURADM          ;ADdress mode
03694  00F531  18                                CLC
03695  00F532  7D 28 F8                          ADC     OFFSET,X        ;add in the offset  
03696  00F535  E0 0C         .NOSTZ              CPX     #ABY            ;handle exceptions
03697  00F537  F0 14                             BEQ     .CHABY
03698  00F539  E0 02                             CPX     #IMM
03699  00F53B  D0 17                             BNE     .CONT
03700  00F53D  C0 22                             CPY     #$22            ;check if BIT first
03701  00F53F  D0 02                             BNE     .NOBIT
03702  00F541  69 68                             ADC     #ADJBIT
03703  00F543  C0 28         .NOBIT              CPY     #$28            ;immediate mode need to adjust a range
03704  00F545  30 0D                             BMI     .CONT
03705  00F547  C0 30                             CPY     #$2F+1
03706  00F549  B0 09                             BCS     .CONT
03707  00F54B  69 08                             ADC     #ADJIMM         ;carry is clear
03708  ;                   BNE     .CONT   
03709  00F54D  C0 35         .CHABY              CPY     #$35            ;LDX check
03710  00F54F  D0 03                             BNE     .CONT
03711  00F551  18                                CLC
03712  00F552  69 04                             ADC     #ADJABY
03713  00F554  C0 23         .CONT               CPY     #$23            ;STZ needs special handling
03714  00F556  D0 0A                             BNE     .DONE
03715  00F558  E0 0A                             CPX     #ABS
03716  00F55A  30 06                             BMI     .DONE
03717  00F55C  F0 02                             BEQ     .SKIP
03718  00F55E  69 F1                             ADC     #$1-$10         ;carry is set
03719  00F560  69 2F         .SKIP               ADC     #$30-1          ;carry is set
03720  00F562  20 FD F2      .DONE               JSR     SAVE_OBJ        ;we have the object code
03721  
03722              .IF     BRKAS2                  ;if we want to add two BRK
03723  
03724  .MKARG                                      ;where appropriate, the arg value is in HEXVAL,H
03725                                              ;copy to ARGS and null terminate
03726  00F565  8A                                TXA                     ;quick check for X=0
03727  00F566  F0 13                             BEQ     .DORTS          ;IMP - no args
03728  00F568  CA                                DEX
03729  00F569  F0 10                             BEQ     .DORTS          ;ACC - no args      
03730  00F56B  A5 D2                             LDA     HEXVAL
03731  00F56D  E0 09                             CPX     #ABS-1          ;word arg if X is greater than or equal to ABS
03732  00F56F  30 05                             BMI     .DOBYTE         ;X < #ABS   
03733  00F571  20 FD F2      .DOWORD             JSR     SAVE_OBJ        ;Save byte(s)
03734  00F574  A5 D3                             LDA     HEXVAL+1
03735  00F576  20 FD F2      .DOBYTE             JSR     SAVE_OBJ
03736  00F579  64 C9                             STZ     ERROR           ;no error really??
03737  00F57B  60            .DORTS              RTS
03738  
03739  
03740  ;------------------------------------------------------------------------
03741  ; work out the addressing mode
03742  ;------------------------------------------------------------------------   
03743  CALCAM                                          ; work out the addressing mode
03744  00F57C  20 84 F5                          JSR     ADDMOD  
03745  00F57F  E0 FF                             CPX     #FAIL
03746  00F581  D0 A7                             BNE     MKOBJC
03747                      ;LDY    #$FF    ; Illegal address mode error
03748  00F583  60                                RTS
03749  
03750  
03751  ;------------------------------------------------------------------------   
03752  ;Find addressing MODE
03753  ;SRCE = points top begining of NME in buffer
03754  ;CURMNE = location of found NME
03755  ;------------------------------------------------------------------------
03756  ADDMOD                                          ;Check the arguments and work out the
03757                                                  ;addressing mode
03758                                                  ;return mode in X
03759                                                  ;default error value for mode
03760                                                  ;save it    
03761                                                  ;Start checking the format...   
03762          
03763  00F584  A4 C6                             LDY     CURMNE              ;Holds the current mne index
03764  00F586  20 0A E8                          JSR     NNONSPC             ;get next no space              
03765  00F589  86 DC                             STX     SAVE_Y              ;Save oprand address from keyboard buffer
03766  00F58B  D0 13                             BNE     .NOTSP              ;not end of line
03767  00F58D  C0 12         .EOL                CPY     #$12                ;check exception first - JSR
03768  00F58F  F0 09                             BEQ     .RET
03769  00F591  A0 00                             LDY     #IMP                ;implied mode - space
03770  00F593  20 0E F6                          JSR     CHKMOD              ;check command is ok with this mode
03771  00F596  C0 FF                             CPY     #FAIL               ;not ok     
03772  00F598  F0 01                             BEQ     .NOTIMP             ;may still be accumulator mode though
03773  00F59A  60            .RET                RTS
03774  00F59B  A0 01         .NOTIMP             LDY     #ACC                ;accumulator mode - space
03775  00F59D  4C 0E F6                          JMP     CHKMOD              ;check command is ok with this mode         
03776  00F5A0  C9 23         .NOTSP              CMP     #IMV                ;immediate mode - '#'
03777  00F5A2  F0 0B                             BEQ     .DOIMM              
03778  00F5A4  A0 03                             LDY     #REL
03779  00F5A6  20 0E F6                          JSR     CHKMOD              ;check if command is a branch
03780  00F5A9  C0 FF                             CPY     #FAIL
03781  00F5AB  F0 21                             BEQ     .NOTREL                 
03782  00F5AD  80 73                             BRA     DOREL               ;Do relative Addressing
03783  00F5AF  98            .DOIMM              TYA
03784  00F5B0  A0 02                             LDY     #IMM
03785  00F5B2  C9 2C                             CMP     #$2C                ;check exception first - STA
03786  00F5B4  F0 67                             BEQ     BAD         
03787  00F5B6  C9 35                             CMP     #$35                ;check inclusion - LDX
03788  00F5B8  F0 0B                             BEQ     .IMMOK
03789  00F5BA  C9 22                             CMP     #$22                ;check inclusion - BIT
03790  00F5BC  F0 07                             BEQ     .IMMOK
03791  00F5BE  20 0E F6                          JSR     CHKMOD              ;check command is ok with this mode
03792  00F5C1  C0 FF                             CPY     #FAIL
03793  00F5C3  F0 D5                             BEQ     .RET
03794  00F5C5  84 C7         .IMMOK              STY     CURADM              ;
03795  00F5C7  A6 DC                             LDX     SAVE_Y
03796  00F5C9  E8                                INX                         ;Get next Charater 
03797  00F5CA  20 49 E9      .GETVALUE           JSR     GET_EXPRES
03798  00F5CD  60                                RTS
03799  .NOTREL             ;LDX    SAVE_Y              ;save two bytes :-) 
03800  00F5CE  B5 19                             LDA     IN,X                ;check the more complicated modes
03801  00F5D0  C9 28                             CMP     #OPEN               ;indirection?
03802  00F5D2  D0 01                             BNE     .CONT               ;no
03803  00F5D4  E8                                INX                         ;skip the '('
03804  00F5D5  A6 DC         .CONT               LDX     SAVE_Y              ;restore the index
03805  00F5D7  20 45 F6                          JSR     FMT2AM              ;calculate the addressing mode from the format
03806  00F5DA  E0 FF                             CPX     #FAIL
03807  00F5DC  F0 BC                             BEQ     .RET
03808  00F5DE  84 C7                             STY     CURADM
03809  
03810  
03811  ;------------------------------------------------------------------------
03812  ;           JMP CHKEXS
03813  ;           falls through
03814  ;------------------------------------------------------------------------
03815  CHKEXS                                          ;Current addressing mode is in X
03816  00F5E0  C0 06                             CPY     #ZPY                ;for MNE indices 28 to 2F, ZPY is illegal
03817  00F5E2  D0 0E                             BNE     .CONT               ;but ABY is ok, so promote byte argument to word
03818  00F5E4  A4 C6                             LDY     CURMNE
03819  00F5E6  C0 28                             CPY     #$28
03820  00F5E8  90 08                             BCC     .CONT
03821  00F5EA  C0 30                             CPY     #$2F+1
03822  00F5EC  B0 04                             BCS     .CONT   
03823  00F5EE  A0 0C                             LDY     #ABY                ;updated addressing mode
03824  00F5F0  D0 28                             BNE     OK
03825  00F5F2  A2 08         .CONT               LDX     #SPCNT              ;check special includes
03826  00F5F4  BD 94 F8      .LOOP               LDA     SPINC1-1,X          ;load mnemonic code
03827  00F5F7  C5 C6                             CMP     CURMNE
03828  00F5F9  D0 0E                             BNE     .NEXT
03829  00F5FB  BC 9C F8                          LDY     SPINC2-1,X          ;load addressing mode
03830  00F5FE  C4 C7                             CPY     CURADM
03831  00F600  F0 18                             BEQ     OK                  ;match - so ok
03832  00F602  BC A4 F8                          LDY     SPINC3-1,X          ;load addressing mode
03833  00F605  C4 C7                             CPY     CURADM
03834  00F607  F0 11                             BEQ     OK                  ;match - so ok
03835  00F609  CA            .NEXT               DEX
03836  00F60A  D0 E8                             BNE     .LOOP
03837  00F60C  A4 C7                             LDY     CURADM
03838  
03839  
03840  ;------------------------------------------------------------------------                   
03841  ;   BNE CHKMOD  ; wasn't in the exceptions table - check normally
03842  ; falls through
03843  ; CHeck Adressing Mode
03844  ;------------------------------------------------------------------------
03845  00F60E  A5 C6         CHKMOD              LDA     CURMNE              ;always > 0
03846  00F610  D9 C8 F7                          CMP     MIN,y               ;mode index in X
03847  00F613  90 08                             BCC     BAD                 ;mnemonic < MIN
03848  00F615  D9 D7 F7                          CMP     MAX,y               ;MAX,X holds actually MAX + 1
03849  00F618  B0 03                             BCS     BAD                 ;mnemonic > MAX
03850  00F61A  84 C7         OK                  STY     CURADM              ;save mode      
03851  00F61C  60                                RTS
03852  
03853  ;------------------------------------------------------------------------
03854  00F61D  A0 FF         BAD                 LDY     #FAIL               ;Illegal addressing mode error
03855  00F61F  84 C9                             STY     ERROR   
03856  00F621  60                                RTS
03857  
03858  
03859  ;------------------------------------------------------------------------       
03860  ; Calculate relative addressing mode {bug found}
03861  ;------------------------------------------------------------------------ 
03862  00F622  A6 DC         DOREL               LDX     SAVE_Y              ; restore index         
03863  00F624  20 0A E8                          JSR     NNONSPC             ;Find next non space
03864  00F627  20 49 E9                          JSR     GET_EXPRES          ;Evaluate expression                
03865  00F62A  A5 C2                             LDA     UNDEF               ;Undefined label used?
03866  00F62C  D0 16                             BNE     HEXVAL2OBJ          ;Yes! Can't verify range        
03867  00F62E  18                                CLC                         ;Calculate displacement (+1!)
03868  00F62F  A5 D2                             LDA     HEXVAL
03869  00F631  E5 B9                             SBC     PC
03870  00F633  85 D2                             STA     HEXVAL
03871  00F635  10 02                             BPL     .NOBOR              ;No borrow needed                   
03872  00F637  E6 D3                             INC     HEXVAL+1
03873  00F639  C6 D2         .NOBOR              DEC     HEXVAL              ;adjust
03874  00F63B  A5 D3                             LDA     HEXVAL+1            ;See if high byte of displacement
03875  00F63D  E5 BA                             SBC     PC+1                ;is 0                   
03876  00F63F  F0 03                             BEQ     HEXVAL2OBJ          ;OK!
03877  00F641  20 CE F4      .RANGE              JSR     RANGE_ERROR         ;Range error!
03878  00F644  60            HEXVAL2OBJ          RTS
03879                      ;LDA     HEXVAL             ;Save displacement
03880                      ;JMP     SAVE_OBJ
03881  
03882  
03883  ;------------------------------------------------------------------------
03884  ;Fomrat to Addressing and calculate the addressing given the format of the arguments
03885  ; return format in X, and location to CHKEXT from in A
03886  ;
03887  ; $FF       invalid
03888  ; #ZPG      $nn
03889  ; #ZPX      $nn,X
03890  ; #ZPY      $nn,Y
03891  ; #ABS      $nnnn
03892  ; #ABX      $nnnn,X
03893  ; #ABY      $nnnn,Y
03894  ; #IND      ($nnnn)
03895  ; #IDX      ($nn,X)
03896  ; #IDY      ($nn),Y
03897  ; #INZ      ($nn)
03898  ; #IAX      ($nnnn,X)
03899  ;       
03900  ;   Addressing modes are organised as follows:
03901  ;
03902  ;   IMP (0) ZPG (4) INZ (7) ABS (A) IND (D)
03903  ;   ACC (1) ZPX (5) INX (8) ABX (B) IAX (E)
03904  ;   IMM (2) ZPY (6) INY (9) ABY (C) ---
03905  ;   REL (3) ---  ---    --- ---
03906  ;
03907  ;   so algorithm below starts with 4, adds 3 if indirect
03908  ;   and adds 6 if absolute (i.e. 2 byte address), then adds 1 or 2
03909  ;   if ,X or ,Y format
03910  ;------------------------------------------------------------------------
03911  ; =======================================================================
03912  ; FORMAT TO ADDRESSING MODE (FMT2AM)
03913  ; -----------------------------------------------------------------------
03914  ; Calculates the addressing mode index based on operand punctuation.
03915  ; Uses 'CHAR' as a state machine to guarantee strict 6502 bracket syntax.
03916  ; =======================================================================
03917  00F645  64 D5         FMT2AM              STZ     CHAR                ; State 0: No bracket opened
03918                      
03919  00F647  A9 04                             LDA     #$04                ; Start with Zero Page base mode (4)
03920  00F649  B4 19                             LDY     IN,X
03921  00F64B  C0 28                             CPY     #OPEN               ; Did the user type '('?
03922  00F64D  D0 06                             BNE     .SKIP
03923                      
03924  00F64F  84 D5                             STY     CHAR                ; State 1: Tracker = '('
03925  00F651  18                                CLC                         
03926  00F652  69 03                             ADC     #$03                ; Shift base to Indirect modes (+3)
03927  00F654  E8                                INX                         ; Consume '('
03928                      
03929  00F655  48            .SKIP               PHA                         ; Save base mode onto stack
03930  00F656  20 42 E8                          JSR     GET_VAL             ; Parse the hex/math operand value
03931  00F659  CA                                DEX
03932  00F65A  38                                SEC                         
03933  00F65B  8A                                TXA                         
03934  00F65C  E5 DC                             SBC     SAVE_Y              
03935  00F65E  4A                                LSR                         ; Divide bytes parsed by 2
03936  00F65F  A8                                TAY                         ; Y = 1 (1-byte operand) or 2 (2-byte operand)
03937                      
03938  00F660  A5 C6                             LDA     CURMNE
03939  00F662  C9 12                             CMP     #$12                ; Is it JSR?
03940  00F664  F0 04                             BEQ     .JSR
03941  00F666  C9 38                             CMP     #$38                ; Is it JMP?
03942  00F668  D0 02                             BNE     .NOJMP
03943  00F66A  A0 02         .JSR                LDY     #$2                 ; JSR and JMP are ALWAYS 2-byte addresses
03944                      
03945  00F66C  68            .NOJMP              PLA                         ; Restore mode base from stack
03946  00F66D  E8                                INX                         
03947  00F66E  F0 56                             BEQ     FERR                ; Throw error if GET_VAL failed
03948  00F670  88                                DEY
03949  00F671  F0 03                             BEQ     .1BYT               ; If 1-byte, base is fully calculated!
03950                      
03951  00F673  18            .2BYT               CLC                         
03952  00F674  69 06                             ADC     #$06                ; If 2-bytes, add 6 to shift base to Absolute modes
03953  00F676  A8            .1BYT               TAY                         ; Y now holds the final Base Mode Index
03954                      
03955                      				; --- PUNCTUATION PARSER ---
03956  00F677  A5 B5         .CHECK              LDA     LABEL_FLAG          ; Was this a resolved label?
03957  00F679  D0 3E                             BNE     .DONE               
03958  00F67B  20 0A E8                          JSR     NNONSPC             ; Fetch next non-space character
03959  00F67E  F0 39                             BEQ     .DONE               ; EOL reached
03960  00F680  C9 3B                             CMP     #';'
03961  00F682  F0 44                             BEQ     FRET                ; Comment reached
03962                      
03963  00F684  C9 29                             CMP     #CLOSE              ; Is it ')'?
03964  00F686  D0 0D                             BNE     .CHK_COMMA
03965                      
03966  00F688  A5 D5                             LDA     CHAR                ; Did we ever open a bracket?
03967  00F68A  C9 28                             CMP     #OPEN
03968  00F68C  D0 38                             BNE     FERR                ; Error: ')' without '('!
03969  00F68E  A9 29                             LDA     #CLOSE
03970  00F690  85 D5                             STA     CHAR                ; State 2: Tracker = ')' (Bracket is closed)
03971  00F692  E8                                INX                         ; Consume ')'
03972  00F693  80 E2                             BRA     .CHECK              ; Loop back to look for ,X or ,Y
03973                      
03974  00F695  C9 2C         .CHK_COMMA          CMP     #COMMA              ; Must be a comma now
03975  00F697  D0 2D                             BNE     FERR                ; If not, syntax error!
03976  00F699  E8                                INX                         ; Consume ','
03977                      
03978  00F69A  20 0A E8                          JSR     NNONSPC             ; Fetch char after comma
03979  00F69D  C9 58                             CMP     #'X'
03980  00F69F  F0 0E                             BEQ     .ISX
03981  00F6A1  C9 59                             CMP     #'Y'
03982  00F6A3  D0 21                             BNE     FERR                ; Only X or Y allowed after comma
03983                      
03984                      				; --- Y INDEXING ---
03985  00F6A5  A5 D5         .ISY                LDA     CHAR
03986  00F6A7  C9 28                             CMP     #OPEN
03987  00F6A9  F0 1B                             BEQ     FERR                ; Error: ($12,Y) is invalid! Bracket must be closed first.
03988  00F6AB  C8                                INY                         
03989  00F6AC  C8                                INY                         ; Add 2 to mode index for Y
03990  00F6AD  80 07                             BRA     .IDX_DONE
03991                      
03992                      				; --- X INDEXING ---
03993  00F6AF  A5 D5         .ISX                LDA     CHAR
03994  00F6B1  C9 29                             CMP     #CLOSE              
03995  00F6B3  F0 11                             BEQ     FERR                ; Error: ($12),X is invalid! Bracket must still be open.
03996  00F6B5  C8                                INY                         ; Add 1 to mode index for X
03997                      
03998  00F6B6  E8            .IDX_DONE           INX                         ; Consume the X or Y
03999  00F6B7  80 BE                             BRA     .CHECK              ; Loop back to ensure line is clean
04000                      
04001                      				; --- END OF LINE VALIDATION ---
04002  00F6B9  A5 D5         .DONE               LDA     CHAR                
04003  00F6BB  C9 28                             CMP     #OPEN               
04004  00F6BD  F0 07                             BEQ     FERR                ; Error: '(' was opened but never closed!
04005                      
04006  00F6BF  C0 0F         .RET                CPY     #$0F                ; Make sure mode index < 15
04007  00F6C1  10 03                             BPL     FERR                ; If >= 15, mode doesn't exist (e.g., Indirect Absolute Y)
04008  00F6C3  98                                TYA
04009  00F6C4  AA                                TAX                         ; Return valid Addressing Mode Index in X
04010  00F6C5  60                                RTS
04011                      
04012  00F6C6  A2 FF         FERR                LDX     #FAIL               ; Return failure flag
04013  00F6C8  60            FRET                RTS
04014  
04015  
04016  ;------------------------------------------------------------------------------------------     
04017  ; Get the MNE index using the following rules:
04018  ;   - lookup awkward cases in a lookup table (DISTBL)
04019  ;   - consider opcodes by category:
04020  ;       1: nnnn1000 -> nnnn
04021  ;       2: nnn10000 -> nnn + BPL
04022  ;       3: nnnn1010 or 0nn00000 -> BRK + nnnn(0nn0)
04023  ;       4: change nnnX0010 to nnnX0001
04024  ;       5: nnnXXXab -> 001abnnn if >= 23
04025  ;       6: 001abnnn + 1 otherwise
04026  ;
04027  ; Converts a raw 6502/65C02 opcode (in A) into a mnemonic index (0-65).
04028  ; Instead of a 256-byte lookup table, this decodes the CPU's internal 
04029  ; silicon bit-patterns (the aaa-bbb-cc matrix).
04030  ; =======================================================================
04031  GETMNE                                          
04032  00F6C9  85 E7                             STA     TEMP1               ; Save the raw opcode for later reference
04033                      
04034                      				; --- 1. CHECK EXCEPTIONS TABLE ---
04035  00F6CB  A2 1A                             LDX     #TBLSZ              ; Load size of the exceptions table
04036  00F6CD  BD 28 F7      .LOOP               LDA     DISTBL-2,X          ; Read an exception opcode
04037  00F6D0  C5 E7                             CMP     TEMP1               ; Does it match our current opcode?
04038  00F6D2  D0 04                             BNE     .SKIP               ; No, keep looking
04039  00F6D4  BD 29 F7                          LDA     DISTBL-1,X          ; YES! Load the hardcoded mnemonic index
04040  00F6D7  60                                RTS                         ; Return immediately
04041  00F6D8  CA            .SKIP               DEX
04042  00F6D9  CA                                DEX                         ; Move to the next Opcode/Index pair
04043  00F6DA  D0 F1                             BNE     .LOOP
04044                      
04045                      				; --- 2. ISOLATE HIGH NIBBLE ---
04046  00F6DC  A5 E7                             LDA     TEMP1               ; Reload the raw opcode
04047  00F6DE  4A                                LSR                         ; Shift right 4 times to isolate the top 4 bits
04048  00F6DF  4A                                LSR
04049  00F6E0  4A                                LSR
04050  00F6E1  4A                                LSR
04051  00F6E2  85 E8                             STA     TEMP2               ; Save the isolated high nibble (0-15)
04052                  
04053                      				; --- 3. CHECK IMPLIED/STACK OPS (xxxx1000) ---
04054  00F6E4  A5 E7                             LDA     TEMP1
04055  00F6E6  29 0F                             AND     #$0F                ; Look at just the bottom 4 bits
04056  00F6E8  C9 08                             CMP     #$08                ; Do they equal exactly 1000? (e.g., PHP, CLC, INY)
04057  00F6EA  D0 03                             BNE     .NOTC1
04058  00F6EC  A5 E8                             LDA     TEMP2               ; YES! For these, the high nibble IS the mnemonic index!
04059  00F6EE  60                                RTS 
04060                      
04061                      				; --- 4. CHECK BRANCH OPS (xxx10000) ---
04062  00F6EF  A5 E7         .NOTC1              LDA     TEMP1
04063  00F6F1  29 1F                             AND     #$1F                ; Look at the bottom 5 bits
04064  00F6F3  C9 10                             CMP     #$10                ; Do they equal 10000? (e.g., BPL, BMI, BVC)
04065  00F6F5  D0 06                             BNE     .NOTC2
04066  00F6F7  A5 E8                             LDA     TEMP2               ; YES! It's a branch. Load the high nibble.
04067  00F6F9  4A                                LSR                         ; Divide high nibble by 2
04068  00F6FA  69 38                             ADC     #$39-1              ; Add base index for branch mnemonics (Carry is SET here, hence the -1)
04069  00F6FC  60                                RTS
04070                      
04071                      				; --- 5. CHECK ACCUMULATOR & FLAG OPS ---
04072  00F6FD  A5 E7         .NOTC2              LDA     TEMP1
04073  00F6FF  29 9F                             AND     #$9F                ; Mask out bits 5 and 6 (the 'bbb' addressing mode bits)
04074  00F701  F0 06                             BEQ     .DOC3               ; If the remaining bits are 00000000, it's a flag op (like BRK)
04075  00F703  29 0F                             AND     #$0F                ; Mask out the top 4 bits
04076  00F705  C9 0A                             CMP     #$0A                ; Does it end in 1010? (Accumulator shifts: ASL A, ROL A)
04077  00F707  D0 06                             BNE     .NOTC3
04078  00F709  A5 E8         .DOC3               LDA     TEMP2               ; YES! Load the high nibble
04079  00F70B  18                                CLC
04080  00F70C  69 10                             ADC     #$10                ; Add the offset for the shift/rotate/flag mnemonics
04081  00F70E  60                                RTS
04082                      
04083                      				; --- 6. PREPARE FOR BOGAX HASH ---
04084  00F70F  A5 E7         .NOTC3              LDA     TEMP1               ; Load raw opcode
04085  00F711  AA                                TAX                         ; Save a copy in X for a quick check later
04086  00F712  29 1F                             AND     #$1F                ; Look at bottom 5 bits
04087  00F714  C9 12                             CMP     #$12                ; Does it end in 10010? (ORA (zp), AND (zp) - 65C02 specific)
04088  00F716  D0 01                             BNE     .1
04089  00F718  CA                                DEX                         ; Adjust X down by 1 to align it with standard addressing modes
04090  00F719  8A            .1                  TXA                         ; Move the (possibly adjusted) opcode back into A
04091                      
04092                      				; ===================================================
04093                      				; 7. THE BOGAX HASH (For standard ALU/Memory ops)
04094                      				; ---------------------------------------------------
04095                      				; The opcode is in binary format: ABCD EFGH
04096                      				; We need to scramble these bits to create a unique 
04097                      				; but sequential index for the remaining mnemonics.
04098                      				; ===================================================
04099  00F71A  0A                                ASL                         ; Shift left.  A = BCDE FGH0. (Carry = A)
04100  00F71B  69 80                             ADC     #$80                ; Add $80 + Carry. Inverts bit 7, shifts Carry (A) into bit 0!
04101                                                  ; A = ?CDE FGHA. (Where ? is inverted B. Carry = B)
04102  00F71D  2A                                ROL                         ; Rotate left. A = CDEF GHAB. (Carry = ?)
04103  00F71E  0A                                ASL                         ; Shift left.  A = DEFG HAB0. (Carry = C)
04104  00F71F  29 1F                             AND     #$1F                ; Mask off top 3 bits. A = 000G HAB0.
04105  00F721  69 20                             ADC     #$20                ; Add $20 (Carry is C!). A = 001G HABC.
04106                      
04107                      				; --- 8. FINAL CATEGORY CHECK ---
04108  00F723  C9 23                             CMP     #$23                ; Did the hash produce a value < 23?
04109  00F725  30 01                             BMI     .NOTC5              ; If yes, branch to category 5 (Add 1)
04110  00F727  60                                RTS                         ; If >= 23, the hash result is the exact mnemonic index!
04111                      
04112                      				; --- 9. CATEGORY 5 FIXUP ---
04113  00F728  1A            .NOTC5              INA                         
04114  00F729  60                                RTS        
04115  
