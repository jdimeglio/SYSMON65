02795  00F04B  A5 F4         SET_BOF             LDA     LOMEM               ;Set pointer to begin of program
02796  00F04D  85 B6                             STA     PNTR                ; memory
02797  00F04F  A5 F5                             LDA     LOMEM+1
02798  00F051  85 B7                             STA     PNTR+1
02799  00F053  60                                RTS
