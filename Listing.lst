01978  ;------------------------------------------------------------------------
01979  ; Auto command
01980  ;------------------------------------------------------------------------
01981  00EAAE  F0 2F         CMD_AUT             BEQ     SET                 ;Nope!
01982  00EAB0  C9 2C                             CMP     #','                ;Is line number given?
01983  00EAB2  F0 1E                             BEQ     .INC                ;Nope!
01984  00EAB4  20 42 E8                          JSR     GET_VAL             ;Get the line number value
01985  00EAB7  D0 28                             BNE     _RTS                ;An error occurred!
01986  00EAB9  84 EA                             STY     AUTO                ;Save new value
01987  00EABB  85 EB                             STA     AUTO+1
01988  00EABD  A9 00                             LDA     #AUTOTEXT
01989  00EABF  20 EC E6                          JSR     PRINT_MSGS
01990  00EAC2  A4 EA                             LDY     AUTO
01991  00EAC4  A5 EB                             LDA     AUTO+1
01992  00EAC6  20 11 EA                          JSR     WRDECI  
01993  00EAC9  20 AD FB                          JSR     DRAWLINECR          ;draw line                                              
01994  00EACC  B5 19                             LDA     IN,X                ;Does the increment follow?
01995  00EACE  C9 2C                             CMP     #','
01996  00EAD0  D0 0D                             BNE     SET                 ;Nope!
01997  00EAD2  E8            .INC                INX
01998  00EAD3  20 42 E8                          JSR     GET_VAL             ;Get the increment value
01999  00EAD6  D0 09                             BNE     _RTS                ;An error occurred!
02000  00EAD8  C0 00                             CPY     #0                  ;Inc of 0 not allowed
02001  00EADA  D0 01                             BNE     .NOT0               ;It is not 0!
02002  00EADC  C8                                INY                         ;Zero was not allowed
02003  00EADD  84 EC         .NOT0               STY     AUTO_INC            ;Save increment
02004  00EADF  C6 ED         SET                 DEC     AUTO_FLAG           ;Make b7=1 (It was 0 before!)   
02005  00EAE1  60            _RTS                RTS
