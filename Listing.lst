00919  ;------------------------------------------------------------------------------------------ 
00920  ;PC Adjust - Program counter
00921  ;------------------------------------------------------------------------------------------     
00922  00E41C  38            PCADJ               SEC
00923  00E41D  A5 DD         PCADJ2              LDA     LENG                ;0=1-byte, 1=2-byte, 2=3-byte
00924  00E41F  A4 E0         PCADJ3              LDY     SRCE+1
00925  00E421  AA                                TAX                         ;* test displ sign (for rel
00926  00E422  10 01                             BPL     .PCADJ4             ;*  branch).  Extend neg
00927  00E424  88                                DEY                         ;*  by decrementing PCH
00928                      ;SEC                        ;*  by incrementing PCL
00929                      ;CLC                        
00930  00E425  65 DF         .PCADJ4             ADC     SRCE
00931  00E427  90 01                             BCC     .RTS                ;PCL+LENGTH (or displ) + 1 to A
00932  00E429  C8                                INY                         ;*  carry into Y (PCH)
00933  00E42A  60            .RTS                RTS 
