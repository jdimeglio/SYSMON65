04117  ;------------------------------------------------------------------------------------------     
04118  ; lookup table for disassembly special cases awkward/irregular opcodes
04119  ; Format: .BYTE <Opcode>, <Mnemonic_Index>
04120  ;------------------------------------------------------------------------------------------ 
04121    001A              TBLSZ   = $1A
04122  DISTBL  .BYTE $80, $41          ; $80 = BRA (Branch Always - 65C02 extension)
04123          .BYTE $4C, $38          ; $4C = JMP (Absolute)
04124          .BYTE $6C, $38          ; $6C = JMP (Indirect)
04125          .BYTE $7C, $38          ; $7C = JMP (Absolute Indexed Indirect, X - 65C02 extension)
04126          .BYTE $0A, $30          ; $0A = ASL A (Accumulator shifts break standard modes)
04127          .BYTE $2A, $31          ; $2A = ROL A 
04128          .BYTE $4A, $32          ; $4A = LSR A 
04129          .BYTE $6A, $33          ; $6A = ROR A 
04130          .BYTE $9C, $23          ; $9C = STZ (Absolute - 65C02 extension)
04131          .BYTE $9E, $23          ; $9E = STZ (Absolute, X - 65C02 extension)
04132          .BYTE $04, $20          ; $04 = TSB (Zero Page - 65C02 extension)
04133          .BYTE $0C, $20          ; $0C = TSB (Absolute - 65C02 extension)
04134          .BYTE $89, $22          ; $89 = BIT (Immediate - 65C02 extension)
