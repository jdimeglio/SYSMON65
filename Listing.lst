04588  00F979  20 1F E4                          JSR     PCADJ3              ;calculate address
04589  00F97C  1A                                INA                         ;Inc A
04590  00F97D  85 DF                             STA     SRCE
04591  00F97F  84 E0                             STY     SRCE+1      
