02511  ;------------------------------------------------------------------------
02512  ; Print binary  IN = AC
02513  ;------------------------------------------------------------------------
02514  00EEA5  85 D5         WRBIN               STA     CHAR                ;
02515  00EEA7  20 AD EE                          JSR     .PRNIB              ;Print nibble
02516  00EEAA  20 81 FB                          JSR     WRDOT
02517  00EEAD  A0 04         .PRNIB              LDY     #4                  ;Setup bit counter
02518  00EEAF  A9 18         .BITLOOP            LDA     #'0'/2              ;Start with ASCII 0
02519  00EEB1  06 D5                             ASL     CHAR                ;Move next bit to CY
02520  00EEB3  2A                                ROL                         ;Add bit to ASCII
02521  00EEB4  20 98 FB                          JSR     WRCHAR              ; and print it
02522  00EEB7  88                                DEY
02523  00EEB8  D0 F5                             BNE     .BITLOOP            ;Do all 4 bits
02524  00EEBA  60            VAL_RTS             RTS
02525  00EEBB  4C C9 F2      VAL_UNDEF           JMP     UNDEF_ERROR         ;Exit with undefined label used
02526          
