00106  ;------------------------------------------------------------------------
00107  ; Zero page memory
00108  ; Input buffer placed in ZP because of the many references to it. Must be
00109  ;  completely in ZP because address + index remains only one byte address
00110  ; PASS must remain the first label here! See INIT routine
00111  ;------------------------------------------------------------------------
00112  000019                                .ORG    $0019               ;Leave 1st part of ZP free
00113  000099                IN              .RS     128                 ;Input and parse buffer 128 Characters input
00114      
00115          .IF LCD_ROUTINES
00116  ;------------------------------------------------------------------------
00117  ; Tracing/debuging varials
00118  ;------------------------------------------------------------------------
00119  0000A8                XQT             .RS 15                      ;Used for tacing
00120  0000A9                SAVP            .RS 1                       ;registers save - 5 locations must be contiguous1
00121  0000AA                SAVS            .RS 1       
00122  0000AB                SAVY            .RS 1
00123  0000AC                SAVX            .RS 1
00124  0000AD                SAVA            .RS 1
00125  0000B0                WHATCH          .RS 3                       ;whatching bytes
00126      
00127  ;------------------------------------------------------------------------
00128  ; Assembler registers
00129  ;------------------------------------------------------------------------
00130  0000B1                PASS            .RS 1                       ;Assembler pass 0=1, 1=2
00131  0000B3                GLOBAL          .RS 2                       ;Last defined Global label
00132  0000B5                GLOBAL_VAL      .RS 2                       ;Last defined Global's value
00133  0000B6                LABEL_FLAG      .RS 1                       ;Found label's assigned flag 
00134  0000B8                PNTR            .RS 2                       ;Pointer in source
00135  0000B9                INDEX           .RS 1                       ;Index mode 0, X or Y
00136  0000BB                PC              .RS 2                       ;Current program counter
00137  0000BD                TA              .RS 2                       ;Current target address
00138  0000BF                TA_BEGIN        .RS 2                       ;Begin of target address block
00139  0000C1                PC_BEG          .RS 2                       ;Program counter at start of line
00140  0000C2                ASM_ERR         .RS 1                       ;Assemble errors (max 255)
00141  0000C3                UNDEF           .RS 1                       ;Undefined label if <> 0
00142  0000C4                FORWARD         .RS 1                       ;Forward referenced label if <> 0
00143  0000C5                LL_NUM          .RS 1                       ;Local label's number
00144  0000C6                FIRST_CHAR      .RS 1                       ;First character of a label
00145  
00146  0000C7                CURMNE          .RS 1                       ;Holds the current mne index
00147  0000C8                CURADM          .RS 1                       ;Holds the current addressing mode
00148  
00149  ;------------------------------------------------------------------------
00150  ; Editor's registers
00151  
00152  0000C9                CMD_CHR         .RS 1                       ;First character of command
00153  0000CA                ERROR           .RS 1                       ;Latest error
00154  0000CB                DUMP            .RS 1                       ;Dump mode in list command
00155  0000CD                PARM1           .RS 2                       ;Parameter 1
00156  0000CF                PARM2           .RS 2                       ;Parameter 2
00157  
00158  ;------------------------------------------------------------------------
00159  ; General purpose registers
00160  
00161  0000D0                NEG_FLAG        .RS 1                       ;Negative flag (if <> 0)
00162  0000D1                COUNT           .RS 1                       ;GP counter
00163  0000D2                DELIM           .RS 1                       ;String/ASCII delimiter
00164  0000D4                HEXVAL          .RS 2                       ;16-bit value of expression
00165  0000D5                LEAD0           .RS 1                       ;Leading 0 flag
00166  0000D6                CHAR            .RS 1                       ;Character compilation register
00167  0000D8                MULDIV          .RS 2                       ;Multiply/divide temp
00168  0000DA                EXP_SAVE        .RS 2                       ;Expression save value
00169  0000DC                DEC_SAVE        .RS 2                       ;Decimal convert save value
00170  0000DD                SAVE_Y          .RS 1                       ;Save Y pointer
00171  0000DF                LENG            .RS 2                       ;Length of block move
00172  0000E1                SRCE            .RS 2                       ;Source for block move
00173  0000E3                DEST            .RS 2                       ;Destination for block move
00174  0000E5                STR_PTR		.RS 2			    ;used for String function	
00175  
00176  ;------------------------------------------------------------------------
00177  ; for disassembler & getexpression
00178  
00179  0000E7                PRFLAG          .RS     2
00180  0000E8                TEMP1           .RS     1                   ;general purpose storage
00181  0000E9                TEMP2           .RS     1
00182  
00183  ;------------------------------------------------------------------------
00184  ; Registers which are best NOT to be disturbed by user's program!
00185  
00186  0000EA                OLD_SAVE        .RS     1                   ;OLD possible if <> 0
00187  0000EC                AUTO            .RS     2                   ;Next Auto line number
00188  0000ED                AUTO_INC        .RS     1                   ;Auto increment
00189  0000EE                AUTO_FLAG       .RS     1                   ;Auto mode flag (if <> -)
00190  0000F0                SYM_TABLE       .RS     2                   ;Symbol table (if MSB <> 0)
00191  0000F2                USR_OBJLO       .RS     2                   ;User's safe object begin
00192  0000F4                USR_OBJHI       .RS     2                   ;User's safe object end 
00193  0000F6                LOMEM           .RS     2                   ;Lomem address   | Don't
00194  0000F8                HIMEM           .RS     2                   ;Himem address |  change order
00195  0000FA                XEC_LAST        .RS     2                   ;Last Xec address
00196  0000FC                USERKEYDEF      .RS     2                   ;User defined @keys 
00197  0000FE                USIRQ           .RS     2                   ;User IRQ vector
00198  000100                USBRK           .RS     2                   ;User BRK vector
00199  000102                USMNI           .RS     2                   ;User NMI vector
00200  000105                USRRST          .RS     3                   ;User RESET vector + checksum
