01076  00E4F4  90 06                             BCC     .NOTASCII               
01077  00E4F6  C9 7F                             CMP     #$7f            
01078  00E4F8  B0 02                             BCS     .NOTASCII           
01079  00E4FA  80 02                             BRA     .WRITE                  
