04788                  .INCLUDE    "Primatives.65s"
04789  ; LIBRARY FILE - PRIMATIVES 
04790  ; version 2.25
04791  ; two pass symbolic assembler, dissembler and tracer
04792  ; REGB bits 0-3 are connected to LED's
04793  ; tested in Michael Kowalski 6502 Simulator - using 65C02 Code 
04794  ; Programmed by Joe DiMeglio
04795  ; https://github.com/jdimeglio/6502-Monitor
04796  ; bug fixes
04797          
04798              
04799  ;------------------------------------------------------------------------
04800  ;prints a string ending with EOS - checkign for packed strings
04801  ;looks for the string after teh JSR statement
04802  ;------------------------------------------------------------------------           
04803  00FAB6  08            STRING2             PHP
04804  00FAB7  48                                PHA
04805  00FAB8  DA                                PHX
04806  00FAB9  5A                                PHY
04807  00FABA  BA                                TSX
04808  00FABB  BD 05 01                          LDA     $0105,x             ; Stack is shallower (no SRCE pushes)
04809  00FABE  85 E3                             STA     STR_PTR
04810  00FAC0  BD 06 01                          LDA     $0106,x
04811  00FAC3  85 E4                             STA     STR_PTR+1
04812                      
04813  00FAC5  E6 E3         .NEXTCHAR           INC     STR_PTR
04814  00FAC7  D0 02                             BNE     .SKIPBUMP
04815  00FAC9  E6 E4                             INC     STR_PTR+1
04816                      
04817  00FACB  A0 01         .SKIPBUMP           LDY     #$01
04818  00FACD  B2 E3                             LDA     (STR_PTR)
04819  00FACF  F0 0D                             BEQ     .ADJUST_RETURN      ; EOS Marker ($00)
04820  00FAD1  10 03                             BPL     .NOTPACK            ; Normal character
04821  00FAD3  20 CD F0                          JSR     UNPACK_DECODE       ; RLE token: returns char in A, count in Y
04822                      
04823  00FAD6  20 98 FB      .NOTPACK            JSR     WRCHAR              ; Write character (A is preserved)
04824  00FAD9  88                                DEY
04825  00FADA  D0 FA                             BNE     .NOTPACK
04826  00FADC  80 E7                             BRA     .NEXTCHAR
04827                      
04828  00FADE  A5 E3         .ADJUST_RETURN      LDA     STR_PTR
04829  00FAE0  9D 05 01                          STA     $0105,x             ; Overwrite return address
04830  00FAE3  A5 E4                             LDA     STR_PTR+1
04831  00FAE5  9D 06 01                          STA     $0106,x
04832                      
04833  00FAE8  7A                                PLY
04834  00FAE9  FA                                PLX
04835  00FAEA  68                                PLA
04836  00FAEB  28                                PLP
04837  00FAEC  60                                RTS                
04838  ;--------------------------------------------------------------------
04839  ; Prints inline string, $00 = End of String, High-Bit = RLE Token
04840  ; Requires: STR_PTR (2 bytes in Zero Page)
04841  ;--------------------------------------------------------------------
04842  00FAED  08            STRING          PHP
04843  00FAEE  48                            PHA
04844  00FAEF  DA                            PHX                     ; X is safely preserved for caller
04845  00FAF0  5A                            PHY
04846  
04847  00FAF1  BA                            TSX                     ; X now holds the stack index!
04848  00FAF2  BD 05 01                      LDA     $0105,x         ; Fetch Return Address Low
04849  00FAF5  85 E3                         STA     STR_PTR
04850  00FAF7  BD 06 01                      LDA     $0106,x         ; Fetch Return Address High
04851  00FAFA  85 E4                         STA     STR_PTR+1
04852  
04853  00FAFC  A0 01                         LDY     #$01
04854  00FAFE  B1 E3         .NEXTCHAR       LDA     (STR_PTR),Y
04855  00FB00  F0 19                         BEQ     .ADJUST_RETURN  ; If $00, end of string
04856  00FB02  30 0A                         BMI     .IS_PACKED      ; If high bit is 1, unpack
04857                  
04858                  ; --- NORMAL CHARACTER ---
04859  00FB04  20 98 FB                      JSR     WRCHAR   
04860                  
04861  00FB07  C8            .ADVANCE_INDEX  INY
04862  00FB08  D0 F4                         BNE     .NEXTCHAR       
04863  00FB0A  E6 E4                         INC     STR_PTR+1       
04864  00FB0C  80 F0                         BRA     .NEXTCHAR               
04865                                        
04866                   ; --- PACKED DATA ---
04867  00FB0E  5A            .IS_PACKED      PHY                     ; Protect string index from UNPACK_DECODE
04868  00FB0F  20 CD F0                      JSR     UNPACK_DECODE   ; Returns char in A, count in Y
04869  00FB12  20 98 FB      .UNPACK_LOOP    JSR     WRCHAR          ; Print it (A is preserved by WRCHAR)
04870  00FB15  88                            DEY                     
04871  00FB16  D0 FA                         BNE     .UNPACK_LOOP    
04872  00FB18  7A                            PLY                     ; Restore string index
04873  
04874                  ; --- MOVE TO NEXT BYTE ---
04875  00FB19  80 EC               		BRA     .ADVANCE_INDEX 
04876  
04877                  ; --- FINISH AND RETURN ---
04878  00FB1B  98            .ADJUST_RETURN  TYA
04879  00FB1C  18                            CLC
04880  00FB1D  65 E3                         ADC     STR_PTR         
04881  00FB1F  9D 05 01                      STA     $0105,x         ; X still perfectly holds stack index!
04882  00FB22  A5 E4                         LDA     STR_PTR+1       
04883  00FB24  69 00                         ADC     #$00
04884  00FB26  9D 06 01                      STA     $0106,x         
04885  
04886  00FB29  7A                            PLY
04887  00FB2A  FA                            PLX                     ; X is restored for caller
04888  00FB2B  68                            PLA
04889  00FB2C  28                            PLP
04890  00FB2D  60                            RTS
04891  
