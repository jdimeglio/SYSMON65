01179  ;------------------------------------------------------------------------
01180  ;EDIT MEMORY one line
01181  ; DEST start of Memory Page to be edited
01182  ; SAVY,SAVX  = X,Y location for memory to be edited
01183  ;------------------------------------------------------------------------ 
01184  
01185  00E58E  20 49 E9      CMD_EDIT_MEMORY     JSR     GET_EXPRES          ;edit memory
01186  00E591  D0 04                             BNE     .CONT1                  
01187  00E593  84 DF                             STY     SRCE                ;store source
01188  00E595  85 E0                             STA     SRCE+1                                                          
01189  00E597  A4 DF         .CONT1              LDY     SRCE
01190  00E599  A5 E0                             LDA     SRCE+1
01191  00E59B  84 E1         .SAVE_DEST          STY     DEST                ;save source in dest as start of page                   
01192  00E59D  85 E2                             STA     DEST+1                                                  
01193                      
01194  00E59F  64 AA         .CONT2              STZ     SAVY                ;1st position for memory
01195  00E5A1  64 AB                             STZ     SAVX                    
