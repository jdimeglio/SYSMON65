02822  ;------------------------------------------------------------------------
02823  ; Find line in program memory
02824  ; Line number to search for is located at 0,Y
02825  ; EOF -> C=0
02826  ; Line found -> C=1 & Z=1
02827  ; Line not found, pointing at next higher line -> C=1 & Z=0
02828  ;------------------------------------------------------------------------
02829  00F067  B9 00 00      FIND_LINE           LDA     0,Y                 ;Get line number to find eg $0400
02830  00F06A  85 D2                             STA     HEXVAL
02831  00F06C  B9 01 00                          LDA     1,Y
02832  00F06F  85 D3                             STA     HEXVAL+1
02833  00F071  20 4B F0                          JSR     SET_BOF             ;Start looking at begin of program eg 0600
02834  00F074  A0 00                             LDY     #0                  ;Empty program?
02835  00F076  B1 B6                             LDA     (PNTR),Y
02836  00F078  F0 16                             BEQ     .EOF                ;Yes!
02837  
02838  00F07A  C8            .LOOP               INY                         ;Point to line number
02839  00F07B  38                                SEC                         ;Subtract wanted line from this
02840  00F07C  B1 B6                             LDA     (PNTR),Y            ; line number
02841  00F07E  E5 D2                             SBC     HEXVAL
02842  00F080  85 D1                             STA     DELIM
02843  00F082  C8                                INY
02844  00F083  B1 B6                             LDA     (PNTR),Y
02845  00F085  E5 D3                             SBC     HEXVAL+1
02846  00F087  05 D1                             ORA     DELIM               ;Z=1 if line is found
02847  00F089  B0 06                             BCS     .QUIT               ;Found it or past it!
02848  00F08B  20 92 F0                          JSR     NEXT_LINE           ;Find next line
02849  00F08E  D0 EA                             BNE     .LOOP               ;Not end of file yet!
02850  00F090  18            .EOF                CLC                         ;Indicate EOF
02851  00F091  60            .QUIT               RTS
02852  
02853  
02854  ;------------------------------------------------------------------------
02855  ; Set pointer to the next line
02856  ;------------------------------------------------------------------------
02857  00F092  A0 00         NEXT_LINE           LDY     #0                  ;reset point to line length
02858  00F094  B2 B6                             LDA     (PNTR)            	;Add length to pointer       
02859  00F096  18                                CLC
02860  00F097  65 B6                             ADC     PNTR
02861  00F099  85 B6                             STA     PNTR
02862  00F09B  90 02                             BCC     .SKIP               ;No carry!
02863  00F09D  E6 B7                             INC     PNTR+1
02864  00F09F  B2 B6         .SKIP               LDA     (PNTR)            	;Set Z if this is EOF
02865  00F0A1  60                                RTS
02866  
02867  
02868  ;------------------------------------------------------------------------
02869  ; Unpack source line to IN (Without line number)
02870  ;------------------------------------------------------------------------
02871  00F0A2  B2 B6         UNPACK_IN           LDA     (PNTR)
02872  00F0A4  38                                SEC
02873  00F0A5  E9 03                             SBC     #3                  ;Subtract length and line-num
02874  00F0A7  85 D0                             STA     COUNT
02875  00F0A9  A2 00                             LDX     #0                  ;Start at IN
02876  00F0AB  A0 03                             LDY     #3                  ;This is where the fun is
02877  00F0AD  B1 B6         .LOOP               LDA     (PNTR),Y            ;Get byte from source
02878  00F0AF  30 0D                             BMI     .UNPACK             ;It's a packed byte! was bpl
02879  00F0B1  95 19                             STA     IN,X                ;It's a normal character
02880  00F0B3  E8                                INX
02881  00F0B4  C8            .NEXT               INY                         ;Point to next source byte
02882  00F0B5  C6 D0                             DEC     COUNT               ;Decrement length counter
02883  00F0B7  D0 F4                             BNE     .LOOP               ;Not done yet!
02884      
02885  00F0B9  A9 0D                             LDA     #CR                 ;Terminate unpacked line with CR
02886  00F0BB  95 19                             STA     IN,X
02887  00F0BD  60                                RTS
02888  
02889  00F0BE  84 D1         .UNPACK             STY     DELIM               ;Save source code pointer
02890  00F0C0  20 CD F0                          JSR     UNPACK_DECODE       ;return character and count
02891  
02892  00F0C3  95 19         .EXPAND             STA     IN,X                ; Save character to IN
02893  00F0C5  E8                                INX
02894  00F0C6  88                                DEY                         ;Decrement counter
02895  00F0C7  D0 FA                             BNE     .EXPAND             ;Not done yet!
02896  00F0C9  A4 D1                             LDY     DELIM               ;Restore index in source
02897  00F0CB  D0 E7                             BNE     .NEXT               ;Always taken!
02898  
02899  
02900  ;------------------------------------------------------------------------
02901  ; Decode unpack ; returns y = count A= character Z=1 if EOL
02902  ;   100 count future 
02903  ;   110 count -
02904  ;   101 count _
02905  ;   111 count SPACE
02906  ;------------------------------------------------------------------------
02907  00F0CD  48            UNPACK_DECODE       PHA                         ;Save packed type (space or -)                  
02908  00F0CE  29 1F                             AND     #%00011111          ;Strip away type flag
02909  00F0D0  A8                                TAY                         ;to keep repeat counter
02910  00F0D1  68                                PLA                         ;Find out what type it was                                                   
02911  00F0D2  29 E0                             AND     #%11100000          ;mask flags
02912  00F0D4  C9 E0                             CMP     #%11100000
02913  00F0D6  F0 07                             BEQ     .SPACE
02914  00F0D8  C9 C0                             CMP     #%11000000
02915  00F0DA  F0 06                             BEQ     .DASH               ;must be HDASH
02916                      ;CMP    #%10100000
02917                      ;BEQ    .HDASH
02918                      ;RTS                        ;return z=0 must be %10000000           
02919  00F0DC  A9 5F         .HDASH              LDA     #'_'
02920  00F0DE  60                                RTS             ;
02921  00F0DF  A9 20         .SPACE              LDA     #' '                ;Expand a space
02922  00F0E1  60                                RTS
02923  00F0E2  A9 2D         .DASH               LDA     #DASH
02924  00F0E4  60                                RTS
02925  
02926  
02927  ;------------------------------------------------------------------------
02928  ; Assemble command
02929  ;------------------------------------------------------------------------
02930  00F0E5  20 AD FB      CMD_ASM             JSR     DRAWLINECR             
02931  00F0E8  20 54 F0                          JSR     FIND_EOFZ           ;Find end of file
02932  00F0EB  A4 B6                             LDY     PNTR                ;Set begin of symbol table
02933  00F0ED  A6 B7                             LDX     PNTR+1
02934  00F0EF  C8                                INY                         ;Symtab starts 1 byte after EOF
02935  00F0F0  D0 01                             BNE     .NOCY               ;No carry!
02936  00F0F2  E8                                INX
02937  00F0F3  84 EE         .NOCY               STY     SYM_TABLE
02938  00F0F5  86 EF                             STX     SYM_TABLE+1
02939  00F0F7  A0 00                             LDY     #0                  ;I presume that we're not beyond
02940  00F0F9  98                                TYA                         ; himem already for memory's sake
02941  00F0FA  91 EE                             STA     (SYM_TABLE),Y       ;Clear symbol table
02942  00F0FC  85 B0                             STA     PASS                ;Set pass 0
02943  00F0FE  85 C1                             STA     ASM_ERR             ;Clear error counter    
02944  00F100  20 20 F1                          JSR     ASSEMBLE            ;Start pass 1
02945  00F103  A5 C1                             LDA     ASM_ERR             ;Were there any errors?
02946  00F105  D0 08                             BNE     .ERRORS             ;Yep!
02947  00F107  C6 B0                             DEC     PASS                ;Start pass 2 (Must be $FF !)
02948  00F109  20 20 F1                          JSR     ASSEMBLE                   
02949  00F10C  20 5E EA                          JSR     PRINT_OBJ           ;Print last object range                
02950  00F10F  20 AD FB      .ERRORS             JSR     DRAWLINECR
02951  00F112  A5 C1                             LDA     ASM_ERR             ;Print number of errors
02952  00F114  85 D2                             STA     HEXVAL
02953  00F116  64 D3                             STZ     HEXVAL+1
02954  00F118  20 0D EA                          JSR     PRDECI_HEXVAL
02955  00F11B  A9 18                             LDA     #STR_ERRORS         ;Print errors string behind it
02956  00F11D  4C EC E6                          JMP     PRINT_MSGS
02957  
02958  
02959  ;------------------------------------------------------------------------
02960  ; This is what we came for, assembling!!!!
02961  ;------------------------------------------------------------------------
02962  00F120  20 4B F0      ASSEMBLE            JSR     SET_BOF             ;Start at begin of program
02963  00F123  64 B2                             STZ     GLOBAL+1            ;Make last global label invalid        
02964  00F125  A9 00                             LDA     #<DEF_ORG           ;Setup default PC
02965  00F127  85 B9                             STA     PC
02966  00F129  85 BB                             STA     TA
02967  00F12B  85 BD                             STA     TA_BEGIN
02968  00F12D  A9 10                             LDA     #>DEF_ORG
02969  00F12F  85 BA                             STA     PC+1
02970  00F131  85 BC                             STA     TA+1
02971  00F133  85 BE                             STA     TA_BEGIN+1
02972  
02973  00F135  20 E4 FB      .LINE               JSR     SCAN_ESC            ;SCAN_ESC output if necessary
02974  00F138  F0 47                             BEQ     .DONE               ;ESC was pressed!
02975  00F13A  A5 B9                             LDA     PC                  ;Copy PC at begin of line
02976  00F13C  85 BF                             STA     PC_BEG
02977  00F13E  A5 BA                             LDA     PC+1
02978  00F140  85 C0                             STA     PC_BEG+1
02979  00F142  A0 00                             LDY     #0                  ;End of program?
02980  00F144  B1 B6                             LDA     (PNTR),Y
02981  00F146  F0 39                             BEQ     .DONE               ;Yes! We're done (with this pass)
02982  00F148  84 C2                             STY     UNDEF               ;Clear undefined label flag
02983  00F14A  84 C3                             STY     FORWARD             ;and forward ref. label flag
02984  00F14C  84 C9                             STY     ERROR               ;Clear error number
02985  00F14E  20 A2 F0                          JSR     UNPACK_IN           ;Unpack this line to IN
02986      
02987  00F151  A2 00                             LDX     #0
02988  00F153  A5 19                             LDA     IN                  ;Can it be a label?
02989  00F155  C9 20                             CMP     #' '
02990  00F157  F0 0B                             BEQ     .NO_LABEL           ;Nope!
02991  00F159  C9 0D                             CMP     #CR                 ;Can't be CR, but just in case
02992  00F15B  F0 1C                             BEQ     .NEXT               ;Do next line!
02993  00F15D  C9 3B                             CMP     #';'
02994  00F15F  F0 18                             BEQ     .NEXT               ;It's a comment, ignore line
02995  00F161  20 53 F4                          JSR     ADD_LABEL           ;Add this label to symbol table
02996  
02997  00F164  20 0A E8      .NO_LABEL           JSR     NNONSPC             ;Find next non space now
02998  00F167  F0 10                             BEQ     .NEXT               ;That was all, next line please!
02999  00F169  C9 3B                             CMP     #';'                ;Compare if its a comment
03000  00F16B  F0 0C                             BEQ     .NEXT               ;The rest is comment!
03001  00F16D  C9 2E                             CMP     #'.'                ;Can it be a directive?
03002  00F16F  F0 05                             BEQ     .DIRECT             ;Yes! Handle it
03003  00F171  20 EA F4                          JSR     MNEMON              ;Decode mnemonic and operand  
03004  00F174  80 03                             BRA    .NEXT                ;That's it!
03005  
03006  00F176  20 AA F1      .DIRECT             JSR     DIRECT              ;Decode directive
03007  
03008  00F179  20 82 F1      .NEXT               JSR     CHCK_ERROR          ;Handle errors
03009  00F17C  20 92 F0                          JSR     NEXT_LINE           ;Point to next line
03010  00F17F  D0 B4                             BNE     .LINE               ;Not EOF!
03011  00F181  60            .DONE               RTS
03012  
03013  
03014  ;------------------------------------------------------------------------
03015  ; Check error
03016  ; If ERROR<>0 print line number and error behind it
03017  ; Also increment error counter
03018  ;------------------------------------------------------------------------
03019  00F182  A5 C9         CHCK_ERROR          LDA     ERROR               ;Did an error occur?
03020  00F184  D0 09                             BNE     .ERRORS             ;Yes!
03021  00F186  A5 C2                             LDA     UNDEF               ;Undefined label used in pass 2?
03022  00F188  25 B0                             AND     PASS                ; (0 if pass 1)
03023  00F18A  F0 1D                             BEQ     .RTS                ;Nope!
03024  00F18C  20 C9 F2                          JSR     UNDEF_ERROR         ;Exit with undefined label error
03025  
03026  00F18F  A0 01         .ERRORS             LDY     #1                  ;Print line number
03027  00F191  B1 B6                             LDA     (PNTR),Y
03028  00F193  85 D2                             STA     HEXVAL
03029  00F195  C8                                INY
03030  00F196  B1 B6                             LDA     (PNTR),Y
03031  00F198  85 D3                             STA     HEXVAL+1
03032  00F19A  20 0D EA                          JSR     PRDECI_HEXVAL
03033  00F19D  20 8D FB                          JSR     WRSPACE
03034  00F1A0  20 EC E6                          JSR     PRINT_MSGS          ;Print the error
03035  00F1A3  E6 C1                             INC     ASM_ERR             ;Increment error counter
03036  00F1A5  D0 02                             BNE     .RTS                ;No error overflow!
03037  00F1A7  C6 C1                             DEC     ASM_ERR             ;Max indicator is 255 errors.
03038  00F1A9  60            .RTS                RTS
03039  
03040  
03041  ;------------------------------------------------------------------------
03042  ; Decode directive
03043  ;------------------------------------------------------------------------
03044  00F1AA  20 D7 F4      DIRECT              JSR     NEXT_IN             ;Get directive's name
03045  00F1AD  F0 31                             BEQ     .EERROR             ;It may not be CR already!
03046  00F1AF  85 CB                             STA     PARM1
03047  00F1B1  20 D5 F4                          JSR     NEXT_IN_Y0
03048  00F1B4  F0 2A                             BEQ     .EERROR             ;It may not be CR already!
03049                      
03050  00F1B6  85 CC                             STA     PARM1+1
03051  00F1B8  B9 E5 F1      .SEARCH             LDA     .TABLE,Y            ;Could it be this one?
03052  00F1BB  F0 23                             BEQ     .EERROR             ;Nope! Directive not found!
03053  00F1BD  C5 CB                             CMP     PARM1
03054  00F1BF  D0 07                             BNE     .NEXT               ;Nope!
03055  00F1C1  B9 E6 F1                          LDA     .TABLE+1,Y
03056  00F1C4  C5 CC                             CMP     PARM1+1
03057  00F1C6  F0 04                             BEQ     .GOTIT              ;Found directive!
03058  00F1C8  C8            .NEXT               INY                         ;Point to next directive in table
03059  00F1C9  C8                                INY
03060  00F1CA  80 EC                             BRA     .SEARCH             ;Always taken!
03061  
03062  00F1CC  B9 F7 F1      .GOTIT              LDA     .JUMPS+1,Y          ;Get directive handler's address
03063  00F1CF  48                                PHA
03064  00F1D0  B9 F6 F1                          LDA     .JUMPS,Y
03065  00F1D3  48                                PHA
03066  00F1D4  20 D5 F4      .EOF_DIR            JSR     NEXT_IN_Y0          ;Find end of directive first
03067  00F1D7  F0 0B                             BEQ     .JUMP               ;Execute directive!
03068  00F1D9  C9 20                             CMP     #SP                 ; Is it a space already?
03069  00F1DB  D0 F7                             BNE     .EOF_DIR            ; Nope, not end of directive yet!
03070  00F1DD  4C 0A E8                          JMP     NNONSPC             ; Find next non space
03071  
03072  00F1E0  A9 6F         .EERROR             LDA     #ERR_DIR            ; Exit with directive ERROR
03073  00F1E2  85 C9                             STA     ERROR
03074  00F1E4  60            .JUMP               RTS
03075  
03076  .TABLE              .BYTE     "AS"              ;ASCII string
03077                      .BYTE     "AT"              ;ASCII string terminated
03078                      .BYTE     "BS"              ;Block skip
03079                      .BYTE     "DA"              ;Data directive
03080                      .BYTE     "EQ"              ;Word directive
03081                      .BYTE     "OR"              ;ORG directive
03082                      .BYTE     "TA"              ;Target address directive
03083                      .BYTE     "DB"              ;Byte directive Future
03084                      .BYTE     00                ;End of table
03085  
03086  .JUMPS              .DW     DIR_AS-1            ;ASCII string
03087                      .DW     DIR_AT-1            ;ASCII string terminated
03088                      .DW     DIR_BS-1            ;Block skip
03089                      .DW     DIR_DA-1            ;Data directive
03090                      .DW     DIR_EQ-1            ;Word directive
03091                      .DW     DIR_OR-1            ;ORG directive
03092                      .DW     DIR_TA-1            ;Target address directive
03093                      .DW     DIR_DB-1            ;Byte directive
03094  
03095  
03096  ;------------------------------------------------------------------------
03097  ; .BYTE and .AT directives
03098  ;------------------------------------------------------------------------
03099  00F206  A0 80         DIR_AT              LDY     #%10000000          ;Set end flag
03100  00F208  84 D4         DIR_AS              STY     LEAD0               ;Save end flag
03101  00F20A  A0 7F                             LDY     #%01111111          ;In case of positive ASCII
03102  00F20C  C9 2D                             CMP     #'-'                ;Is it the sign flag?
03103  00F20E  D0 07                             BNE     .POS                ;No! Positive ASCII
03104  00F210  A0 FF                             LDY     #%11111111          ;Set negative ASCII flag
03105  00F212  20 D7 F4                          JSR     NEXT_IN             ;Point to next character
03106  00F215  F0 50                             BEQ     DIR_OPE             ;Premature EOL!
03107  00F217  84 D5         .POS                STY     CHAR                ;Save ASCII polarity
03108  00F219  85 D1                             STA     DELIM               ;Save delimiter character
03109  00F21B  20 D7 F4      .LOOP               JSR     NEXT_IN             ;Get next char
03110  00F21E  F0 47                             BEQ     DIR_OPE             ;Sudden EOL!
03111  00F220  C5 D1                             CMP     DELIM               ;End of string?
03112  00F222  F0 10                             BEQ     .EXIT               ;Yes!
03113  00F224  25 D5                             AND     CHAR                ;Set/clear b7
03114  00F226  B4 1A                             LDY     IN+1,X              ;Is next char the delimiter?
03115  00F228  C4 D1                             CPY     DELIM
03116  00F22A  D0 02                             BNE     .NOT_END            ;Nope!
03117  00F22C  45 D4                             EOR     LEAD0               ;Invert b7 if end flag set
03118  00F22E  20 FD F2      .NOT_END            JSR     SAVE_OBJ            ;Save byte to object
03119  00F231  4C 1B F2                          JMP     .LOOP               ;Do all characters
03120  
03121  00F234  20 D7 F4      .EXIT               JSR     NEXT_IN             ;Next char must be blank or EOL
03122  00F237  F0 04                             BEQ     .RTS                ;It is!
03123  00F239  C9 20                             CMP     #SP
03124  00F23B  D0 2A                             BNE     DIR_OPE             ;It is not!
03125  00F23D  60            .RTS                RTS
03126  
03127  
03128  ;------------------------------------------------------------------------
03129  ; .BS directive
03130  ;------------------------------------------------------------------------
03131  00F23E  20 49 E9      DIR_BS              JSR     GET_EXPRES          ;Evaluate expression
03132  00F241  D0 28                             BNE     DIR_EXIT            ;An ERROR occurred
03133  00F243  A5 C2                             LDA     UNDEF
03134  00F245  D0 1D                             BNE     .UNDEF              ;Undefined labels not allowed
03135  00F247  A5 B0                             LDA     PASS                ;Don't increment TA during pass 1
03136  00F249  F0 05                             BEQ     .PC
03137  00F24B  A0 BB                             LDY     #TA                 ;Add expression to TA
03138  00F24D  20 52 F2                          JSR     .ADD
03139  00F250  A0 B9         .PC                 LDY     #PC                 ;Add expression to PC
03140  00F252  18            .ADD                CLC
03141  00F253  B9 00 00                          LDA     0,Y
03142  00F256  65 D2                             ADC     HEXVAL
03143  00F258  99 00 00                          STA     0,Y
03144  00F25B  B9 01 00                          LDA     1,Y
03145  00F25E  65 D3                             ADC     HEXVAL+1
03146  00F260  99 01 00                          STA     1,Y
03147  00F263  60                                RTS
03148  00F264  4C F0 F2      .UNDEF              JMP     DIR_UNDEF           ;Undefined label used!
03149  
03150  00F267  A9 82         DIR_OPE             LDA     #ERR_OPE            ;Exit with operand EERROR
03151  00F269  85 C9                             STA     ERROR
03152  00F26B  60            DIR_EXIT            RTS
03153  
03154  
03155  ;------------------------------------------------------------------------
03156  ; .BYTE directive Data directive
03157  ;------------------------------------------------------------------------
03158  00F26C  A9 3C         DIR_DB              LDA     #'<'
03159  00F26E  85 D5                             STA     CHAR                ;Save prefix
03160  00F270  80 0A                             BRA     PREFIXDA            ;get single bytes
03161  
03162  
03163  ;------------------------------------------------------------------------
03164  ; .BYTE directive Data directive
03165  ;------------------------------------------------------------------------
03166  00F272  85 D5         DIR_DA              STA     CHAR                ;Save prefix
03167  00F274  C9 3C                             CMP     #'<'                ;Low byte only?
03168  00F276  F0 04                             BEQ     PREFIXDA            ;Yes!
03169  00F278  C9 3E                             CMP     #'>'                ;High byte only?
03170  00F27A  D0 03                             BNE     NOPREFIX            ;Nope!
03171  00F27C  E8            PREFIXDA            INX                         ;Get next character
03172  00F27D  B5 19                             LDA     IN,X
03173  00F27F  20 49 E9      NOPREFIX            JSR     GET_EXPRES          ;Evaluate expression
03174  00F282  D0 E7                             BNE     DIR_EXIT            ;An ERROR occurred!
03175  00F284  A4 D5                             LDY     CHAR                ;What prefix was used?
03176  00F286  A5 D2                             LDA     HEXVAL
03177  00F288  C0 3C                             CPY     #'<'
03178  00F28A  F0 09                             BEQ     .LOW                ;Low byte only!
03179  00F28C  C0 3E                             CPY     #'>'
03180  00F28E  F0 03                             BEQ     .HIGH               ;High byte only!
03181  00F290  20 FD F2                          JSR     SAVE_OBJ            ;Save low byte first
03182  00F293  A5 D3         .HIGH               LDA     HEXVAL+1            ;Then save high byte
03183  00F295  20 FD F2      .LOW                JSR     SAVE_OBJ
03184  00F298  B5 19                             LDA     IN,X                ;More parameters
03185  00F29A  C9 2C                             CMP     #','
03186  00F29C  D0 CD                             BNE     DIR_EXIT            ;Nope!
03187  00F29E  E8                                INX
03188  00F29F  B5 19                             LDA     IN,X
03189  00F2A1  80 CF                             BRA     DIR_DA              ;Always taken!
03190  
03191  
03192  ;------------------------------------------------------------------------
03193  ; .EQ directive
03194  ;------------------------------------------------------------------------
03195  00F2A3  A5 B0         DIR_EQ              LDA     PASS                ;What pass are we in?
03196  00F2A5  D0 1E                             BNE     .RTS                ;Don't bother about .EQ during 2!
03197  00F2A7  20 49 E9                          JSR     GET_EXPRES          ;Evaluate expression
03198  00F2AA  D0 BB                             BNE     DIR_OPE             ;An ERROR occurred!
03199  00F2AC  A5 C2                             LDA     UNDEF               ;Undefined labels are not allowed
03200  00F2AE  D0 19                             BNE     UNDEF_ERROR         ;Yes!
03201  00F2B0  A5 19                             LDA     IN                  ;Was a label declared here?
03202  00F2B2  C9 41                             CMP     #'A'
03203  00F2B4  90 10                             BCC     NOLABEL             ;Nope!
03204  00F2B6  C9 5B                             CMP     #'Z'+1
03205  00F2B8  B0 0C                             BCS     NOLABEL             ;Nope!
03206  00F2BA  A0 01                             LDY     #1                  ;Point to label's value
03207  00F2BC  A5 D2                             LDA     HEXVAL              ;and change it
03208  00F2BE  91 B1                             STA     (GLOBAL),Y
03209  00F2C0  C8                                INY
03210  00F2C1  A5 D3                             LDA     HEXVAL+1
03211  00F2C3  91 B1                             STA     (GLOBAL),Y
03212  00F2C5  60            .RTS                RTS
03213  
03214  00F2C6  A9 10         NOLABEL             LDA     #ERR_LBL            ;Exit with label EERROR     
03215                  .db $2c                         ;Skip next two bytes BIT 
03216                      ;STA     ERROR
03217                      ;RTS
03218  00F2C9  A9 5E         UNDEF_ERROR         LDA     #ERR_DEF            ;Exit with undefined label ERROR
03219  00F2CB  85 C9                             STA     ERROR
03220  00F2CD  60            DIR_EXIT2           RTS
03221  
03222  
03223  ;------------------------------------------------------------------------
03224  ; .OR directive
03225  ;------------------------------------------------------------------------
03226  00F2CE  20 5E EA      DIR_OR              JSR     PRINT_OBJ           ;Print length of previous block
03227  00F2D1  20 49 E9                          JSR     GET_EXPRES          ;Evaluate expression
03228  00F2D4  D0 1E                             BNE     FATAL_ERROR2        ;Can't accept errors here!
03229  00F2D6  84 B9                             STY     PC                  ;Save PC and TA
03230  00F2D8  85 BA                             STA     PC+1
03231  00F2DA  80 08                             BRA     DIR_TA2             ;Always taken!
03232  
03233  
03234  ;------------------------------------------------------------------------
03235  ; .TA directive
03236  ;------------------------------------------------------------------------
03237  00F2DC  20 5E EA      DIR_TA              JSR     PRINT_OBJ           ;Print length of previous block
03238  00F2DF  20 49 E9                          JSR     GET_EXPRES          ;Evaluate expression
03239  00F2E2  D0 16                             BNE     DIR_OPE2            ;An EERROR occurred!
03240  00F2E4  84 BB         DIR_TA2             STY     TA                  ;Save target address
03241  00F2E6  84 BD                             STY     TA_BEGIN
03242  00F2E8  85 BC                             STA     TA+1
03243  00F2EA  85 BE                             STA     TA_BEGIN+1
03244  00F2EC  A5 C2                             LDA     UNDEF               ;Undefined label used?
03245  00F2EE  F0 DD                             BEQ     DIR_EXIT2           ;Nope! We're done now
03246  
03247  00F2F0  A9 5E         DIR_UNDEF           LDA     #ERR_DEF            ;Can't allow undefined labels!
03248  00F2F2  85 C9         FATAL_ERROR         STA     ERROR
03249  00F2F4  20 82 F1      FATAL_ERROR2        JSR     CHCK_ERROR          ;Print the error
03250  00F2F7  4C 14 E0                          JMP     GETLINE             ;And abort assembly! Fatal EERROR
03251  00F2FA  4C 67 F2      DIR_OPE2            JMP     DIR_OPE             ;Operand EERROR
03252  
03253  
03254  ;------------------------------------------------------------------------
03255  ; Save byte to target
03256  ;------------------------------------------------------------------------
03257  00F2FD  A4 B0         SAVE_OBJ            LDY     PASS                ;What pass?
03258  00F2FF  F0 2E                             BEQ     .INCPC              ;Pass 1! Don't save anything
03259  00F301  48                                PHA
03260  00F302  A4 BB                             LDY     TA                  ;See if below standard safe limit
03261  00F304  C4 00                             CPY     <DEF_OBJLOW
03262  00F306  A5 BC                             LDA     TA+1
03263  00F308  E5 02                             SBC     >DEF_OBJLOW
03264  00F30A  90 08                             BCC     .USR                ;Below default safe range!
03265  00F30C  C4 F4                             CPY     LOMEM               ;See if it's above LOMEM now
03266  00F30E  A5 BC                             LDA     TA+1
03267  00F310  E5 F5                             SBC     LOMEM+1
03268  00F312  90 10                             BCC     .SAFE               ;We're in safe range!
03269  
03270  00F314  C4 F0         .USR                CPY     USR_OBJLO           ;See if below user safe limit
03271  00F316  A5 BC                             LDA     TA+1
03272  00F318  E5 F1                             SBC     USR_OBJLO+1
03273  00F31A  90 1A                             BCC     MEM_FULL            ;Yes! Exit with ERROR
03274  00F31C  C4 F2                             CPY     USR_OBJHI           ;See if it's above user safe limit
03275  00F31E  A5 BC                             LDA     TA+1
03276  00F320  E5 F3                             SBC     USR_OBJHI+1
03277  00F322  B0 12                             BCS     MEM_FULL            ;Yes! Exit with ERROR
03278  
03279  00F324  68            .SAFE               PLA
03280  00F325  A0 00                             LDY     #0
03281  00F327  91 BB                             STA     (TA),Y              ;Save byte
03282  00F329  E6 BB                             INC     TA                  ;Increment target address
03283  00F32B  D0 02                             BNE     .INCPC              ;No carry!
03284  00F32D  E6 BC                             INC     TA+1
03285  
03286  00F32F  E6 B9         .INCPC              INC     PC                  ;Increment PC
03287  00F331  D0 02                             BNE     .RTS                ;No carry!
03288  00F333  E6 BA                             INC     PC+1
03289  00F335  60            .RTS                RTS
03290  
03291  00F336  A9 51         MEM_FULL            LDA     #ERR_MEM            ;Exit with fatal memory ERROR
03292  00F338  80 B8                             BRA     FATAL_ERROR         ;(ignoring the stack)
03293  
03294  
03295  ;------------------------------------------------------------------------
03296  ;  Expand the size of the symbol table by A {6Bytes}
03297  ;  Presuming DEST points to current end flag ($00)
03298  ;  Warning END flag is not moved! Must be done by calling routine!
03299  ;------------------------------------------------------------------------
03300  00F33A  18            EXP_SYM             CLC                         ;See if there's enough room to
03301  00F33B  65 E1                             ADC     DEST                ;expand
03302  00F33D  85 DD                             STA     LENG
03303  00F33F  A9 00                             LDA     #0
03304  00F341  A8                                TAY                         ;Point to first byte in new space
03305  00F342  65 E2                             ADC     DEST+1
03306  00F344  85 DE                             STA     LENG+1
03307  00F346  A5 F6                             LDA     HIMEM               ;See if there's enough room
03308  00F348  C5 DD                             CMP     LENG                ;for it
03309  00F34A  A5 F7                             LDA     HIMEM+1
03310  00F34C  E5 DE                             SBC     LENG+1
03311  00F34E  90 E6                             BCC     MEM_FULL            ;Memory full!
03312  00F350  60                                RTS
03313  
03314  
03315  ;------------------------------------------------------------------------
03316  ; Find label in symbol table
03317  ; Upon exit:
03318  ; C=1 if not a legal label name was given
03319  ; Z=1 if label not found
03320  ; X will always point to end of label name + 1 in parse buffer
03321  ; Y will always be 0
03322  ; DEST will point at global label (or end of symbol table $00)
03323  ; DEST will point at local label (or end of local labels $FF)
03324  ;------------------------------------------------------------------------
03325  FIND_LABEL      
03326                      .IF ROM_LIBRRAY 
03327                      
03328  00F351  A5 EF         .USER_LABLES        LDA     SYM_TABLE+1         ;Is symbol table valid?
03329  00F353  F0 13                             BEQ     .NOSYM              ;Nope!
03330  00F355  B5 19                             LDA     IN,X                ;Save first character of label
03331  00F357  85 C5                             STA     FIRST_CHAR
03332  00F359  C9 2E                             CMP     #'.'                ;Is it a local label?
03333  00F35B  F0 14                             BEQ     FIND_LOCAL          ;Yes!
03334      
03335  00F35D  C9 41                             CMP     #'A'                ;First character must be A-Z
03336  00F35F  90 0E                             BCC     NO_LABEL            ;It's not!
03337  00F361  C9 5B                             CMP     #'Z'+1
03338  00F363  B0 0A                             BCS     NO_LABEL            ;It's not!
03339  00F365  4C C6 F3                          JMP     FIND_GLOBAL         ;Find global label                 
03340      
03341  00F368  18            .NOSYM              CLC                         ;Indicate label given
03342  00F369  20 C9 F2                          JSR     UNDEF_ERROR         ;Exit with undefined label ERROR
03343  00F36C  A9 00                             LDA     #0                  ;Make Z=0 meaning label not found
03344  00F36E  60            .FOUND_LABEL        RTS
03345  
03346  00F36F  38            NO_LABEL            SEC                         ;Indicate no label given
03347  00F370  60                                RTS
03348  
03349  
03350  ;------------------------------------------------------------------------
03351  ; Find a local label in the symbol table
03352  ;------------------------------------------------------------------------
03353  00F371  A5 B1         FIND_LOCAL          LDA     GLOBAL              ;Start looking from the begin of
03354  00F373  85 E1                             STA     DEST                ;the last assigned global label
03355  00F375  A5 B2                             LDA     GLOBAL+1
03356  00F377  85 E2                             STA     DEST+1
03357  00F379  F0 F4                             BEQ     NO_LABEL            ;No global label ERROR!
03358  00F37B  E8                                INX                         ;Next char must be a digit!
03359  00F37C  B5 19                             LDA     IN,X
03360  00F37E  C9 30                             CMP     #'0'
03361  00F380  90 ED                             BCC     NO_LABEL            ;It's not!
03362  00F382  C9 3A                             CMP     #'9'+1
03363  00F384  B0 E9                             BCS     NO_LABEL            ;It's not!
03364      
03365  00F386  20 42 E8                          JSR     GET_VAL             ;Get local label number
03366  00F389  A5 D2                             LDA     HEXVAL
03367  00F38B  85 C4                             STA     LL_NUM
03368  00F38D  C9 64                             CMP     #100                ;Value must be below 100!
03369  00F38F  B0 DE                             BCS     NO_LABEL            ;It is not!
03370  00F391  A5 D3                             LDA     HEXVAL+1
03371  00F393  D0 DA                             BNE     NO_LABEL            ;It is not!
03372      
03373  00F395  A0 03                             LDY     #5-2                ;Point to start of local labels
03374  00F397  C8            .LOOP               INY                         ;Each record contains 2 bytes
03375  00F398  C8                                INY
03376  00F399  B1 E1                             LDA     (DEST),Y            ;Could it be this one?
03377  00F39B  C9 FF                             CMP     #$FF
03378  00F39D  F0 15                             BEQ     .DONE               ;Nope! End of record
03379  00F39F  29 7F                             AND     #%01111111          ;Ignore label declared flag !!!
03380  00F3A1  C5 C4                             CMP     LL_NUM
03381  00F3A3  D0 F2                             BNE     .LOOP               ;It's not this one!
03382      
03383  00F3A5  C8                                INY
03384  00F3A6  18                                CLC                         ;Add label's offset to global
03385  00F3A7  A5 B3                             LDA     GLOBAL_VAL          ; label's value
03386  00F3A9  71 E1                             ADC     (DEST),Y
03387  00F3AB  85 D2                             STA     HEXVAL
03388  00F3AD  A5 B4                             LDA     GLOBAL_VAL+1
03389  00F3AF  69 00                             ADC     #0
03390  00F3B1  85 D3                             STA     HEXVAL+1
03391  00F3B3  88                                DEY
03392  
03393  00F3B4  18            .DONE               CLC                         ;Add offset to pointer
03394  00F3B5  98                                TYA
03395  00F3B6  65 E1                             ADC     DEST
03396  00F3B8  85 E1                             STA     DEST
03397  00F3BA  90 02                             BCC     .NOCY               ;No carry
03398  00F3BC  E6 E2                             INC     DEST+1
03399  00F3BE  A0 00         .NOCY               LDY     #0                  ;Now clear Y (points to same addr)
03400  00F3C0  B1 E1                             LDA     (DEST),Y            ;Set/clear label found flag
03401  00F3C2  C9 FF                             CMP     #$FF                ;Z=1 if label not found
03402  00F3C4  18                                CLC                         ;There was no ERROR in label name
03403  00F3C5  60                                RTS
03404  
03405  
03406  ;------------------------------------------------------------------------
03407  ; Find a global label in the symbol table or ROM Table
03408  ; Global Label can also end with :
03409  ; returns word in HEXVAL
03410  ;------------------------------------------------------------------------
03411                  .IF ROM_LIBRRAY 
03412  
03413  00F3C6  A5 EE         FIND_GLOBAL         LDA     SYM_TABLE           ;Start looking from the begin of
03414  00F3C8  85 E1                             STA     DEST                ; the symbol table
03415  00F3CA  A5 EF                             LDA     SYM_TABLE+1
03416  00F3CC  85 E2                             STA     DEST+1
03417  
03418  00F3CE  86 DC         FIND_GLOBAL_SRCH    STX     SAVE_Y              ;Save start of label name
03419  00F3D0  E8            .MARK_END           INX                         ;Find end of label we're looking
03420  00F3D1  B5 19                             LDA     IN,X                ; for
03421  00F3D3  C9 2E                             CMP     #'.'
03422  00F3D5  F0 F9                             BEQ     .MARK_END           ;Not end yet!
03423  00F3D7  C9 30                             CMP     #'0'
03424  00F3D9  90 0C                             BCC     .FOUND_END          ;End!
03425  00F3DB  C9 3A                             CMP     #'9'+1
03426  00F3DD  90 F1                             BCC     .MARK_END
03427  00F3DF  C9 41                             CMP     #'A'
03428  00F3E1  90 04                             BCC     .FOUND_END          ;End!
03429  00F3E3  C9 5B                             CMP     #'Z'+1
03430  00F3E5  90 E9                             BCC     .MARK_END
03431  00F3E7  86 D1         .FOUND_END          STX     DELIM               ;Character must be restored later! x=last character of the label
03432                      ;AND     #%01111111         ;Temporarily mark end of label = z=1
03433  00F3E9  09 80                             ORA     #%10000000          ;Ignore declared flag
03434  00F3EB  95 19                             STA     IN,X
03435  
03436  00F3ED  A0 00         .FND_GLOBAL         LDY     #0                  ;Outer search loop
03437  00F3EF  B1 E1                             LDA     (DEST),Y
03438  00F3F1  F0 27                             BEQ     .EXIT               ;End of symbol table reached!
03439                      ;ORA     #%10000000         ;Ignore declared flag
03440  00F3F3  29 7F                             AND     #%01111111          ;Ignore declared flag
03441  00F3F5  C5 C5                             CMP     FIRST_CHAR          ;Should we bother looking further?
03442  00F3F7  D0 45                             BNE     .FAIL               ;Nope! Find next global label
03443      
03444  00F3F9  A6 DC                             LDX     SAVE_Y              ;Point to begin of label again
03445  00F3FB  A0 04                             LDY     #4                  ;Get pointer to label's name
03446  00F3FD  B1 E1                             LDA     (DEST),Y            ; in source file
03447  00F3FF  85 E0                             STA     SRCE+1              ;(Going backwards leaves Y=3)
03448  00F401  88                                DEY
03449  00F402  B1 E1                             LDA     (DEST),Y
03450  00F404  85 DF                             STA     SRCE
03451  
03452  00F406  B5 19         .CMP_GLOBAL         LDA     IN,X                ;Compare strings
03453  00F408  30 08                             BMI     .EOL                ;End of label reached! 
03454  00F40A  D1 DF                             CMP     (SRCE),Y            ;Do they still match?
03455  00F40C  D0 30                             BNE     .FAIL               ;Nope!
03456  00F40E  E8                                INX
03457  00F40F  C8                                INY
03458  00F410  D0 F4                             BNE     .CMP_GLOBAL         ;Keep trying! Always taken
03459  
03460  00F412  B1 DF         .EOL                LDA     (SRCE),Y            ;Is label in source also at end?
03461  00F414  30 04                             BMI     .EXIT               ;Yes! (packed space or LineLeng)
03462  00F416  C9 3A                             CMP     #':'
03463  00F418  D0 24                             BNE     .FAIL               ;Nope!
03464  
03465  00F41A  A6 D1         .EXIT               LDX     DELIM               ;Label found or at end of symtab
03466  00F41C  B5 19                             LDA     IN,X                ;Restore end of label marker
03467                      ;ORA     #%10000000         ;only used for apple
03468  00F41E  29 7F                             AND     #%01111111
03469  00F420  95 19                             STA     IN,X
03470  00F422  A0 00                             LDY     #0
03471  00F424  B1 E1                             LDA     (DEST),Y            ;A will be 0 if label not found
03472  00F426  F0 14                             BEQ     .RTS                ;Label not found!
03473  00F428  49 80                             EOR     #%10000000          ;Save label's assigned flag
03474                      ;AND     #%10000000         ;  (inverted!)
03475  00F42A  25 B0                             AND     PASS                ;Remains 0 if pass 1
03476  00F42C  85 B5                             STA     LABEL_FLAG
03477  00F42E  C8                                INY
03478  00F42F  B1 E1                             LDA     (DEST),Y            ;Save label's value
03479  00F431  85 D2                             STA     HEXVAL
03480  00F433  C8                                INY
03481  00F434  B1 E1                             LDA     (DEST),Y
03482  00F436  85 D3                             STA     HEXVAL+1
03483  00F438  A0 00                             LDY     #0                  ;Restore pointer
03484  00F43A  A5 C5                             LDA     FIRST_CHAR          ; and first char (Z=0)
03485  00F43C  18            .RTS                CLC                         ;There was no ERROR in label name
03486  00F43D  60                                RTS
03487      
03488  00F43E  A0 05         .FAIL               LDY     #5                  ;Find next label
03489  00F440  B1 E1         .NXT_GLOBAL         LDA     (DEST),Y            ;Try to find $FF which signals
03490  00F442  C8                                INY                         ; the end of this label
03491  00F443  C9 FF                             CMP     #$FF
03492  00F445  D0 F9                             BNE     .NXT_GLOBAL         ;Not yet!
03493  00F447  98                                TYA                         ;Add current offset to DEST
03494  00F448  18                                CLC
03495  00F449  65 E1                             ADC     DEST
03496  00F44B  85 E1                             STA     DEST
03497  00F44D  90 9E                             BCC     .FND_GLOBAL         ;No carry needed!
03498  00F44F  E6 E2                             INC     DEST+1
03499  00F451  80 9A                             BRA     .FND_GLOBAL         ;Always taken!      
03500  
03501  
03502  ;------------------------------------------------------------------------
03503  ; Add label
03504  ;------------------------------------------------------------------------
03505  00F453  20 51 F3      ADD_LABEL           JSR     FIND_LABEL          ;Find label in symbol table
03506  00F456  B0 44                             BCS     .LBL_ERR            ;It was not a valid label!
03507  00F458  D0 47                             BNE     .FOUND_IT           ;Found the label!
03508  00F45A  A5 C5                             LDA     FIRST_CHAR          ;What type of label is it?
03509  00F45C  C9 2E                             CMP     #'.'
03510  00F45E  F0 56                             BEQ     .ADD_LOCAL          ;It is a local label!
03511      
03512  00F460  A9 06                             LDA     #6                  ;Make room for 6 bytes in the
03513  00F462  20 3A F3                          JSR     EXP_SYM             ; symbol table
03514  00F465  A5 C5                             LDA     FIRST_CHAR          ;Save first character of label
03515  ;                   AND     #%01111111          ; in symbol table (clear declared
03516  00F467  91 E1                             STA     (DEST),Y            ;  flag first)
03517  00F469  C8                                INY
03518  00F46A  A5 B9                             LDA     PC                  ;Place current PC into symbol
03519  00F46C  91 E1                             STA     (DEST),Y            ; table
03520  00F46E  C8                                INY
03521  00F46F  A5 BA                             LDA     PC+1
03522  00F471  91 E1                             STA     (DEST),Y
03523  00F473  C8                                INY                         ;Place source pointer in symbol
03524  00F474  A5 B6                             LDA     PNTR                ; table (where the label name
03525  00F476  91 E1                             STA     (DEST),Y            ;  can be found)
03526  00F478  C8                                INY
03527  00F479  A5 B7                             LDA     PNTR+1
03528  00F47B  20 DD F4                          JSR     SAVE_ENDSYM         ;Save last 3 bytes of symbol table
03529  
03530  00F47E  A5 E1         .COPY_GLOBAL        LDA     DEST                ;Copy symbol table pointer
03531  00F480  85 B1                             STA     GLOBAL              ; to last global label
03532  00F482  A5 E2                             LDA     DEST+1
03533  00F484  85 B2                             STA     GLOBAL+1
03534  00F486  A0 01                             LDY     #1                  ;Copy last global label's value
03535  00F488  B1 E1                             LDA     (DEST),Y
03536  00F48A  85 B3                             STA     GLOBAL_VAL
03537  00F48C  C8                                INY
03538  00F48D  B1 E1                             LDA     (DEST),Y
03539  00F48F  85 B4                             STA     GLOBAL_VAL+1
03540  00F491  CA                                DEX
03541  
03542  00F492  20 D7 F4      .BLANK              JSR     NEXT_IN             ;Find first blank or EOL
03543  00F495  F0 04                             BEQ     .RTS                ;EOL!
03544  00F497  C9 20                             CMP     #SP
03545  00F499  D0 F7                             BNE     .BLANK              ;Try again!
03546  00F49B  60            .RTS                RTS
03547  
03548  00F49C  20 C6 F2      .LBL_ERR            JSR     NOLABEL             ;Exit with label EERROR
03549  00F49F  D0 F1                             BNE     .BLANK              ;Always taken!
03550  
03551  00F4A1  A5 B0         .FOUND_IT           LDA     PASS                ;What pass are we in?
03552  00F4A3  F0 0D                             BEQ     .EXT_DEF            ;Pass 1! Extra definition
03553      
03554  00F4A5  B1 E1                             LDA     (DEST),Y            ;Set declared flag in pass 2
03555  00F4A7  09 80                             ORA     #%10000000
03556  00F4A9  91 E1                             STA     (DEST),Y
03557      
03558  00F4AB  A5 C5                             LDA     FIRST_CHAR          ;What type was the label?
03559  00F4AD  C9 2E                             CMP     #'.'
03560  00F4AF  D0 CD                             BNE     .COPY_GLOBAL        ;Copy last global label pointer
03561  00F4B1  60                                RTS
03562  
03563  00F4B2  A9 96         .EXT_DEF            LDA     #ERR_EXT            ;Exit with extra definition EERROR
03564  00F4B4  80 1A                             BRA     SET_ERROR
03565  
03566  00F4B6  A9 02         .ADD_LOCAL          LDA     #2                  ;Make room for 2 bytes in the
03567  00F4B8  20 3A F3                          JSR     EXP_SYM             ; symbol table
03568  00F4BB  A5 C4                             LDA     LL_NUM              ;Save label number in symbol
03569  00F4BD  91 E1                             STA     (DEST),Y            ;  table
03570  00F4BF  C8                                INY
03571  00F4C0  38                                SEC                         ;Calculate offset from last global
03572  00F4C1  A5 B9                             LDA     PC
03573  00F4C3  E5 B3                             SBC     GLOBAL_VAL
03574  00F4C5  20 DD F4                          JSR     SAVE_ENDSYM         ;Save last 3 bytes of symbol table
03575  
03576  00F4C8  A5 BA                             LDA     PC+1                ;Check offset range now
03577  00F4CA  E5 B4                             SBC     GLOBAL_VAL+1
03578  00F4CC  F0 CD                             BEQ     .RTS                ;Range is OK!
03579  
03580  
03581  ;------------------------------------------------------------------------
03582  ; Set RANGE and set ERRRO
03583  ;------------------------------------------------------------------------
03584  00F4CE  A9 17         RANGE_ERROR         LDA     #ERR_RNG            ;Exit with range EERROR
03585  00F4D0  85 C9         SET_ERROR           STA     ERROR
03586  00F4D2  4C 1D F6                          JMP     BAD                 ;set Y=FAIL
03587  
03588  
03589  ;------------------------------------------------------------------------
03590  ; Get next char from input buffer and compare it with CR
03591  ;------------------------------------------------------------------------
03592  00F4D5  A0 00         NEXT_IN_Y0          LDY     #0                  ;Clear Y for different purposes
03593  00F4D7  E8            NEXT_IN             INX                         ;Well, let's do just that!
03594  00F4D8  B5 19         IN_CR               LDA     IN,X
03595  00F4DA  C9 0D                             CMP     #CR
03596  00F4DC  60                                RTS
03597  
03598  
03599  ;------------------------------------------------------------------------
03600  ; Save last 3 bytes to symbol table to save some code
03601  ;------------------------------------------------------------------------
03602  00F4DD  91 E1         SAVE_ENDSYM         STA     (DEST),Y            ;Save low byte of offset only
03603  00F4DF  C8                                INY
03604  00F4E0  A9 FF                             LDA     #$FF                ;Save end of label marker
03605  00F4E2  91 E1                             STA     (DEST),Y
03606  00F4E4  C8                                INY
03607  00F4E5  A9 00                             LDA     #0                  ;Save new end of symbol table flag
03608  00F4E7  91 E1                             STA     (DEST),Y
03609  00F4E9  60                                RTS
03610  
03611  
03612      .include    "Dissassembler Lib.65s"
03613  ; LIBRARY FILE DISSESSEMBER.65S
03614  ; version 2.30
03615  ; two pass symbolic assembler, dissembler and tracer
03616  ; REGB bits 0-3 are connected to LED's
03617  ; tested in Michael Kowalski 6502 Simulator - using 65C02 Code 
03618  ; Programmed by Joe DiMeglio
03619  ; https://github.com/jdimeglio/6502-Monitor
03620  ; bug fixes
03621           
03622  
03623  ;------------------------------------------------------------------------
03624  ; Decode mnemonic and operand
03625  ;------------------------------------------------------------------------
03626  00F4EA  20 F0 F4      MNEMON              JSR     CMPMNE              ;AC = has left MNE :THEN FND INDEX AND SAVE IT IN   
03627                      ;LDA    CURMNE                      
03628                      ;CMP    #FAIL               ;Check MNEMONIC error
03629                      ;BNE    .MNE_ERR                    
03630                      ;LDA    #ERR_MNE
03631                      ;STA    ERROR
03632                      ;BRA    .MNE_ERR                    
03633                      ;JSR     CALCAM              ;Calculate addres 
03634  00F4ED  4C 7C F5                          JMP     CALCAM              ;Calculate addres
03635  ;.MNE_ERR            RTS
03636  
03637  ;------------------------------------------------------------------------
03638  ; Compress MEN into PARM1 & PARM1+1
03639  ; X points to the index in the keyboard IN
03640  ;------------------------------------------------------------------------
03641  00F4F0  DA            CMPMNE              PHX                     ;save X index to keyboard buffer
03642  00F4F1  18                                CLC                     ;AC = has left MNE
03643  00F4F2  66 CB                             ROR     PARM1                       
03644  00F4F4  8A                                TXA
03645  00F4F5  18                                CLC
03646  00F4F6  69 19                             ADC     #IN             ;Calc IN address + X
03647  00F4F8  85 DF                             STA     SRCE
03648  00F4FA  64 E0                             STZ     SRCE+1          ;*** Could be removed if ZP load
03649  00F4FC  A0 02                             LDY     #$02            ;Three letters
03650  ;.NEXT2              SEC
03651  ;                    LDA     (SRCE),Y        ;get the letters SHOULD BE ZERO Page load
03652  ;                    SBC     #'A'-1
03653                      
03654                      
03655  00F4FE  B1 DF         .NEXT2              LDA     (SRCE),Y        ; get the letters
03656  00F500  29 1F                             AND     #$1F            ; Instantly maps 'A' to 1, 'B' to 2, 'Z' to 26                    
03657                      
03658                      
03659  00F502  A2 05                             LDX     #$05            ;shift
03660  00F504  4A            .NEXTROT            LSR
03661  00F505  66 CB                             ROR     PARM1
03662  00F507  66 CC                             ROR     PARM1+1
03663  00F509  CA                                DEX
03664  00F50A  D0 F8                             BNE     .NEXTROT
03665  00F50C  88                                DEY
03666  00F50D  10 EF                             BPL     .NEXT2          ;Nemonic now compressed     
03667  00F50F  A2 42                             LDX     #NUMMN          ;Number of mnemonics to search through
03668  00F511  BD 43 F7      .LOOP               LDA     LMNETB-1,X      ;search 
03669  00F514  C5 CB                             CMP     PARM1
03670  00F516  D0 07                             BNE     .NXT
03671  00F518  BD 85 F7                          LDA     RMNETB-1,X
03672  00F51B  C5 CC                             CMP     PARM1+1
03673  00F51D  F0 03                             BEQ     .FND
03674  00F51F  CA            .NXT                DEX
03675  00F520  D0 EF                             BNE     .LOOP
03676  00F522  CA            .FND                DEX                     ;X = $FF for failure
03677  00F523  86 C6                             STX     CURMNE 
03678  00F525  FA                                PLX                     ;restore X 
03679  00F526  E8                                INX
03680  00F527  E8                                INX
03681  00F528  E8                                INX                     ;Adjust the buffer index to point to next Char
03682  00F529  60                                RTS     
