00999  00E483  E8                                INX
01000  00E484  20 42 E8                          JSR     GET_VAL             ;FILL end address
01001  00E487  84 E1                             STY     DEST
01002  00E489  85 E2                             STA     DEST+1
01003  00E48B  E8                                INX
01004  00E48C  20 42 E8                          JSR     GET_VAL             ;FILL value
01005  00E48F  84 D5                             STY     CHAR
01006              
01007  00E491  38                                SEC                         ;find length add +1
01008  00E492  A5 E1                             LDA     DEST
01009  00E494  E5 DF                             SBC     SRCE
01010  00E496  85 DD                             STA     LENG
01011  00E498  A5 E2                             LDA     DEST+1
01012  00E49A  E5 E0                             SBC     SRCE+1
01013  00E49C  85 DE                             STA     LENG+1
01014  00E49E  98                                TYA                         ;the value              
01015              
01016  00E49F  A4 DE                             LDY     LENG+1                                      
01017  00E4A1  F0 12                             BEQ     .partpg             ;compare partpage           
01018                              
01019  00E4A3  A0 00                             LDY     #00                 ;another way is keep y=0 and increment
01020  00E4A5  D1 DF         .fullpg             CMP     (SRCE),Y
01021  00E4A7  D0 03                             BNE     .skip1              ;probably should be write error
01022  00E4A9  20 07 E5                          JSR     DISPLAY_ADDR
01023  00E4AC  C8            .skip1              INY 
01024  00E4AD  D0 F6                             BNE     .fullpg
01025  00E4AF  E6 E0                             INC     SRCE+1
01026  00E4B1  C6 DE                             DEC     LENG+1              ;are we done
01027  00E4B3  D0 F0                             BNE     .fullpg
01028              
01029  00E4B5  A4 DD         .partpg             LDY     LENG            
01030  00E4B7  D1 DF         .loop1              CMP     (SRCE),Y
01031  00E4B9  D0 05                             BNE     .skip2 
01032                                                  ;savey
01033                                                  ;savya
01034                                                  ;add + y to A
01035                                                  ;better of inc source until equals dest
01036                                                  ;probably should be write error
01037  00E4BB  20 07 E5                          JSR     DISPLAY_ADDR 
01038  00E4BE  A5 D5                             LDA     CHAR                ;get the value          
01039  00E4C0  88            .skip2              DEY 
01040  00E4C1  D0 F4                             BNE     .loop1
01041                      ;STA    (SRCE),Y            ;last byte
01042  00E4C3  60                                RTS
