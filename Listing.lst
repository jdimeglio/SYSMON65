04722  00FA6E  8D 0E A0                          STA     IER             
04723  00FA71  8D 0D A0                          STA     IFR             
04724  00FA74  A9 0F                             LDA     #%00001111          ;inputs and outputs
04725  00FA76  8D 02 A0                          STA     DIRB
04726  00FA79  A9 0F                             LDA     #%00001111          ;show user that 6502 reseted                
04727  00FA7B  8D 00 A0                          STA     REGB                ;Output LEDS light ON
