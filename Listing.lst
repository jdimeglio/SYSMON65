04898  00FB2F  A9 1B                             LDA     #ESC                ;Escape codes   
04899  00FB31  20 98 FB                          JSR     WRCHAR              
04900  00FB34  A9 5B                             LDA     #'['                
04901  00FB36  20 98 FB                          JSR     WRCHAR              
04902  00FB39  98                                TYA             
