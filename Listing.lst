00398                      .BYTE       'H'             ;Hunt Command - future
00399                      .BYTE       '?'             ;Help command
00400                      .BYTE       'I'             ;ASCII Dump 
00401                      .BYTE       'L'             ;List command
00402                      .BYTE       'M'             ;Memory command
00403                      .BYTE       'N'             ;New command
00404                      .BYTE       'O'             ;Old command
00405                      .BYTE       'R'             ;Renumber command
00406                      .BYTE       'S'             ;Start assembling
00407                      .BYTE       'T'             ;Trace code
00408                      .BYTE       'V'             ;Value command
00409                      .BYTE       'W'             ;Display registers                  
00410                      .BYTE       'Y'             ;memory configuraion
00411                      .BYTE       'Z'             ;Clear Screen
00412                      .BYTE       $13             ;[CNTL-S]  - clean code
00413                      .BYTE       'J'             ;Edit Memory
00414                      .BYTE       "K"             ;Watch register      
00415                      .BYTE       '@'             ;User commands  
00416  CMD_BRK             .BYTE       0               ;End of table & BRK
00417  
