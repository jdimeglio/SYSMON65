02802  ;------------------------------------------------------------------------
02803  ; Find end of program memory
02804  ;------------------------------------------------------------------------
02805  00F054  20 4B F0      FIND_EOFZ           JSR     SET_BOF             ;Set pointer to begin of file
02806  ;FIND_EOF            LDY     #0                  ;Point to line length
02807  ;.LOOP               LDA     (PNTR),Y            ;Get current line's length
