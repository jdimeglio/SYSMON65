01960  ;------------------------------------------------------------------------
01961  ; Auto line numbering
01962  ; Increment is done once line is accepted
01963  ;------------------------------------------------------------------------
01964  00EA98  24 ED         AUTONUM             BIT     AUTO_FLAG           ;geneterate next line number
01965                                                  ;Is auto line number enabled?
01966  00EA9A  10 11                             BPL     .RTS                ;Nope!
01967  00EA9C  A5 EA                             LDA     AUTO                ;Setup next line number
01968  00EA9E  85 D2                             STA     HEXVAL
01969  00EAA0  A5 EB                             LDA     AUTO+1
01970  00EAA2  85 D3                             STA     HEXVAL+1
01971  00EAA4  20 0D EA                          JSR     PRDECI_HEXVAL       ;Print decimal value
01972  00EAA7  20 8D FB                          JSR     WRSPACE             ;Followed by a space
01973  00EAAA  95 19                             STA     IN,X
01974  00EAAC  E8                                INX
01975  00EAAD  60            .RTS                RTS
