02458  ;------------------------------------------------------------------------
02459  ; Value command
02460  ;------------------------------------------------------------------------
02461  
02462  00EE4A  F0 58         CMD_VAL             BEQ     .RTS                ;EOL! Missing operand error!
02463  00EE4C  A9 00         .LOOP               LDA     #0
02464  00EE4E  85 C2                             STA     UNDEF               ;Clear undefined label flag
02465  00EE50  20 49 E9                          JSR     GET_EXPRES          ;Get value
02466  00EE53  D0 4F                             BNE     .RTS                ;An error occurred!
02467  00EE55  A5 C2                             LDA     UNDEF               ;Undefined label used?
02468  00EE57  D0 62                             BNE     VAL_UNDEF           ;Yes!
02469      
02470  00EE59  20 0D EA                          JSR     PRDECI_HEXVAL       ;Print value in decimal (ABS)
02471  00EE5C  20 8D FB                          JSR     WRSPACE
02472      
02473  00EE5F  A5 D3                             LDA     HEXVAL+1            ;Save original value
02474  00EE61  48                                PHA
02475  00EE62  A5 D2                             LDA     HEXVAL
02476  00EE64  48                                PHA
02477  00EE65  A9 2B                             LDA     #'+'                ;Print same value, but this time
02478  00EE67  24 D3                             BIT     HEXVAL+1            ; it may be negative
02479  00EE69  10 05                             BPL     .POS                ;It is positive!
02480  00EE6B  20 8A EA                          JSR     NEGATE              ;Make value positive again
02481  00EE6E  A9 2D                             LDA     #'-'
02482  00EE70  20 98 FB      .POS                JSR     WRCHAR              ;Print sign
02483  00EE73  20 0D EA                          JSR     PRDECI_HEXVAL       ;Print value
02484  00EE76  20 8D FB                          JSR     WRSPACE
02485      
02486  00EE79  68                                PLA                         ;Restore hexval
02487  00EE7A  A8                                TAY
02488  00EE7B  85 D2                             STA     HEXVAL
02489  00EE7D  68                                PLA
02490  00EE7E  85 D3                             STA     HEXVAL+1
02491  00EE80  20 D7 FB                          JSR     WRWORD              ;Write value as hex
02492  00EE83  20 8D FB                          JSR     WRSPACE
02493      
02494  00EE86  A9 25                             LDA     #'%'                ;Print percent aka binary
02495  00EE88  20 98 FB                          JSR     WRCHAR
02496  00EE8B  A5 D3                             LDA     HEXVAL+1            ;Is high byte 0?
02497  00EE8D  F0 06                             BEQ     .LOW                ;Yes! Do only the low byte
02498  00EE8F  20 A5 EE                          JSR     WRBIN               ;Print this byte binary
02499  00EE92  20 81 FB                          JSR     WRDOT
02500  00EE95  A5 D2         .LOW                LDA     HEXVAL              ;Print low byte in binary too
02501  00EE97  20 A5 EE                          JSR     WRBIN
02502      
02503  00EE9A  20 91 FB                          JSR     WRCRLF
02504  00EE9D  B5 19                             LDA     IN,X                ;Is next char a comma?
02505  00EE9F  E8                                INX
02506  00EEA0  C9 2C                             CMP     #','
02507  00EEA2  F0 A8                             BEQ     .LOOP               ;Yes! Then more will follow!
02508  00EEA4  60            .RTS                RTS                         ;Ignore rest (soft error check)
02509  
