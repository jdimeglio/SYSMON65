02589  00EF0D  E8            IN_BLANK            INX                         ;Find end of command in IN
02590  00EF0E  B5 19                             LDA     IN,X                ;Get character
02591  00EF10  C9 20                             CMP     #SP
02592  00EF12  F0 02                             BEQ     .RTS                ;A space is the end!
02593  00EF14  C9 0D                             CMP     #CR                 ;CR is EOL
02594  00EF16  60            .RTS                RTS
