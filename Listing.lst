01846  ;------------------------------------------------------------------------
01847  ; Print decimal number and/or write value to IN,X 
01848  ; HEXVAL  holds the value to be printed 16bit wide
01849  ;------------------------------------------------------------------------
01850  00EA0D  A4 D2         PRDECI_HEXVAL       LDY     HEXVAL              ;Copy value to work registers
01851  00EA0F  A5 D3                             LDA     HEXVAL+1
01852  
01853  
01854  ;------------------------------------------------------------------------
01855  ; Print decimal number and/or write value to IN,X 
01856  ; A & Y  holds the value to be printed 16bit wide
01857  ;------------------------------------------------------------------------
01858  00EA11  84 D8         WRDECI              STY     EXP_SAVE            ;           
01859  00EA13  85 D9                             STA     EXP_SAVE+1
01860  00EA15  A0 04                             LDY     #4                  ;A maximum of 5 decades and 4
01861  00EA17  64 D4                             STZ     LEAD0               ; leading zeroes
01862  00EA19  A9 30         .DECLOOP            LDA     #'0'                ;Start with 0
01863  00EA1B  85 D5                             STA     CHAR
01864  00EA1D  A5 D8         .LOOP               LDA     EXP_SAVE            ;Try to subtract decade from
01865  00EA1F  D9 54 EA                          CMP     .DECIL,Y            ; value
01866  00EA22  A5 D9                             LDA     EXP_SAVE+1
01867  00EA24  F9 59 EA                          SBC     .DECIH,Y
01868  00EA27  90 0D                             BCC     .DONE               ;Didn't go! Done this decade
01869  00EA29  85 D9                             STA     EXP_SAVE+1          ;Save new intermediate result
01870  00EA2B  A5 D8                             LDA     EXP_SAVE
01871  00EA2D  F9 54 EA                          SBC     .DECIL,Y
01872  00EA30  85 D8                             STA     EXP_SAVE
01873  00EA32  E6 D5                             INC     CHAR                ;Increment counter
01874  00EA34  D0 E7                             BNE     .LOOP
01875  00EA36  A5 D5         .DONE               LDA     CHAR                ;Get decade character
01876  00EA38  C8                                INY                         ;Last digit?
01877  00EA39  88                                DEY
01878  00EA3A  F0 0A                             BEQ     .PRINT              ;Yes! Simply print it
01879  00EA3C  C9 30                             CMP     #'0'                ;Is it a 0?
01880  00EA3E  F0 02                             BEQ     .LEAD0              ;Yep!
01881  00EA40  C6 D4                             DEC     LEAD0               ;B7=1, no more leading zeroes
01882  00EA42  24 D4         .LEAD0              BIT     LEAD0               ;Still leading zeroes?
01883  00EA44  10 0A                             BPL     .NEXT               ;Yes! Skip them
01884  00EA46  20 98 FB      .PRINT              JSR     WRCHAR              ;Print character
01885  00EA49  24 ED                             BIT     AUTO_FLAG           ;Auto line number?
01886  00EA4B  10 03                             BPL     .NEXT               ;Nope!
01887  00EA4D  95 19                             STA     IN,X                ;Save character in input line
01888  00EA4F  E8                                INX
01889  00EA50  88            .NEXT               DEY                         ;Do all 5 digits (except the LSD)
01890  00EA51  10 C6                             BPL     .DECLOOP            ;Not done them all yet!
01891  00EA53  60                                RTS
01892  
01893  .DECIL          .BYTE     $01,$0a,$64,$e8,$10
01894  .DECIH          .BYTE     $00,$00,$00,$03,$27
