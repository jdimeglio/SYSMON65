04980              
04981          .ELSE
04982  00FB8C  60                                RTS 
04983                          
04984  ;------------------------------------------------------------------------
04985  ; Print a space
04986  ;------------------------------------------------------------------------
04987  00FB8D  A9 20         WRSPACE             LDA     #SP                 ;Print a space
04988  00FB8F  80 07                             BRA     WRCHAR               
04989                             
04990  ;------------------------------------------------------------------------
04991  ; Print a CR
04992  ;------------------------------------------------------------------------
04993  
04994  00FB91  A9 0D         WRCRLF              LDA     #CR                 ;Print a CR & LF        
04995  00FB93  20 98 FB                          JSR     WRCHAR
04996  00FB96  A9 0A         WRLF                LDA     #LF                 ;fall through to WRCHAR
04997  
04998  ;------------------------------------------------------------------------
04999  ;WRCHAR Out charater to the screen
05000  ;  Low level
05001  ;------------------------------------------------------------------------
05002  WRCHAR
05003          .IF LCD_ROUTINES
05004  
05005          .IF MYWYM
05006  00FB98  08                                PHP                         ;save flags         
05007  00FB99  48                                PHA             
05008  .WAITTX             
05009              .IF PROTEUS
05010  00FB9A  AD 00 AF                          LDA     ACIA                ; 6850 Status Reg
05011  00FB9D  29 02                             AND     #$02                ; 6850 TX Empty is Bit 1
05012  00FB9F  F0 F9                             BEQ     .WAITTX
05013  00FBA1  68                                PLA
05014  00FBA2  8D 01 AF                          STA     ACIA+1              ; 6850 Data Reg
05015              .ELSE
05016  00FBA5  28                                PLP             
05017  00FBA6  60                                RTS
05018          .ELSE
05019  
05020  ;------------------------------------------------------------------------
05021  ;Print Blank Lines & print N Blank lines 
05022  ; x= times
05023  ;------------------------------------------------------------------------
05024  00FBA7  A2 03         WRBLNK              LDX     #$03                ;Blank count x3
05025  00FBA9  A9 20         WRBL2               LDA     #SP
05026  00FBAB  80 0D                             BRA     REPWRCHAR           ;repeat WR
05027  
05028  
05029  ;------------------------------------------------------------------------
05030  ;REPWRCHAR Out charater to the screen
05031  ; A= Char  x= times
05032  ;------------------------------------------------------------------------
05033  00FBAD  20 91 FB      DRAWLINECR          JSR     WRCRLF
05034  00FBB0  A9 2D         DRAWLINE            LDA     #DASH
05035  00FBB2  A2 4E                             LDX     #78                 ;columns on the screen 80-2
05036  00FBB4  20 BA FB                          JSR     REPWRCHAR 
05037  00FBB7  4C 91 FB                          JMP     WRCRLF
05038                      
05039  00FBBA  20 98 FB      REPWRCHAR           JSR     WRCHAR
05040  00FBBD  CA                                DEX
05041  00FBBE  D0 FA                             BNE     REPWRCHAR
05042  00FBC0  60                                RTS
05043  
05044  ;------------------------------------------------------------------------
05045  ;convert binary into a ASCII characters 
05046  ;write to screen eg xx
05047  ;------------------------------------------------------------------------
05048  00FBC1  48            WR2HEX              PHA         
05049  00FBC2  4A                                LSR                         ;write 2 hex digits         
05050  00FBC3  4A                                LSR         
05051  00FBC4  4A                                LSR         
05052  00FBC5  4A                                LSR         
05053  00FBC6  20 CA FB                          JSR     WR1HEX          
05054  00FBC9  68                                PLA         
05055  00FBCA  D8            WR1HEX              CLD                         ;write 1 character HEX eg x 
05056  00FBCB  29 0F                             AND     #$0f            
05057  00FBCD  C9 0A                             CMP     #$0a            
05058  00FBCF  90 02                             BCC     .z09                        
05059  00FBD1  69 06                             ADC     #$06                ;carry is set           
05060  00FBD3  69 30         .z09                ADC     #$30
05061  00FBD5  80 C1                             BRA     WRCHAR     
05062              
05063  ;------------------------------------------------------------------------
05064  ; Print word in hex
05065  ; A holds MSB, Y holds LSB, eg $xxxx
05066  ;------------------------------------------------------------------------
05067  00FBD7  48            WRWORD              PHA                         ;Save MSB
05068  00FBD8  A9 24                             LDA     #'$'                ;Print dollar symbol
05069  00FBDA  20 98 FB                          JSR     WRCHAR
05070  00FBDD  68                                PLA
05071  00FBDE  20 C1 FB      WRWORDAY            JSR     WR2HEX              ;Print MSB
05072  00FBE1  98                                TYA
05073  00FBE2  80 DD                             BRA     WR2HEX              ;Print LSB
05074  
05075  ;------------------------------------------------------------------------
05076  ; SCAN_ESC if key is pressed
05077  ;  Low level
05078  ;------------------------------------------------------------------------
05079  SCAN_ESC    
05080              .IF MYWYM       
05081              .IF PROTEUS
05082  00FBE4  AD 00 AF                          LDA     ACIA                ; 6850 Status Reg
05083  00FBE7  29 01                             AND     #$01                ; 6850 RX Full is Bit 0
05084  00FBE9  F0 03                             BEQ     .NOTHING
05085  00FBEB  20 F8 FB                          JSR     READACIA
05086              .ELSE
05087  00FBEE  C9 1B         .NOTHING            CMP     #ESC
05088  00FBF0  60                                RTS     
05089          
05090              .ELSE
05091  
05092  ;------------------------------------------------------------------------
05093  ; Wait for keypressed
05094  ;  Low level
05095  ;------------------------------------------------------------------------
05096  RDCHAR
05097          .IF MYWYM 
05098  .WAITRX             
05099              .IF PROTEUS
05100  00FBF1  AD 00 AF                          LDA     ACIA                ; 6850 Status Reg
05101  00FBF4  29 01                             AND     #$01                ; 6850 RX Full is Bit 0
05102  00FBF6  F0 F9                             BEQ     .WAITRX
05103  00FBF8  AD 01 AF      READACIA            LDA     ACIA+1              ; 6850 Data Reg (Auto-clears status!)
05104  00FBFB  60                                RTS
05105              .ELSE
05106          .ELSE   
05107  
05108  ;------------------------------------------------------------------------
05109  ;Read 1 character and convert it to HEX 
05110  ;------------------------------------------------------------------------
05111  00FBFC  20 F1 FB      RD1HEX              JSR     RDCHAR
05112  00FBFF  80 0F                             BRA     HEX2BIN             
05113  
05114  ;------------------------------------------------------------------------
05115  ;Read 2 HEX character and convert it to BIN 
05116  ;------------------------------------------------------------------------
05117  00FC01  20 FC FB      RD2HEX              JSR     RD1HEX          
05118  00FC04  0A                                ASL         
05119  00FC05  0A                                ASL         
05120  00FC06  0A                                ASL         
05121  00FC07  0A                                ASL                     
05122  00FC08  85 E7                             STA     TEMP1               
05123  00FC0A  20 FC FB                          JSR     RD1HEX                      
05124  00FC0D  05 E7                             ORA     TEMP1                                   
05125  00FC0F  60                                RTS         
05126  
05127  
05128  ;------------------------------------------------------------------------
05129  ;Convert AC in HEX out BIN
05130  ;------------------------------------------------------------------------
05131  ;HEX2BIN             EOR     #'0'                ;Ignore ASCII part for decimals             
05132  ;                    CMP     #9+1    
05133  ;                    BCC     .okhex              ;It was a decimal digit!
05134  ;                    ADC     #$88                ;Map letters A - F to $FA-FF
05135  ;                    CMP     #$fa
05136  ;                    BCC     .invalid            ;No hex digit anymore!
05137   ;                   AND     #$0F            
05138  ;.okhex              RTS
05139  ;.invalid            LDA     #FAIL
05140  ;                    RTS                         
05141  
05142  ;------------------------------------------------------------------------
05143  ; HEX2BIN (Extreme Size Optimization: 20 Bytes)
05144  ; Expects: ASCII in A
05145  ; Returns: Binary 0-15 in A, or FAIL if invalid.
05146  ;------------------------------------------------------------------------
05147  00FC10  49 30         HEX2BIN             EOR     #'0'        ; Maps '0'-'9' to 0-9. Maps A-F to $71-$76, a-f to $51-$56
05148  00FC12  C9 0A                             CMP     #10         ; If A < 10, Carry = 0. If A >= 10, Carry = 1.
05149  00FC14  90 0A                             BCC     .DONE       ; 0-9 finished! Branches with exact binary value.
05150                      
05151  00FC16  09 20                             ORA     #$20        ; Magic: Folds both $71-$76 (A-F) and $51-$56 (a-f) into $71-$76!
05152  00FC18  E9 71                             SBC     #$71        ; C=1 from CMP, so no borrow. $71-$76 safely becomes 0-5.
05153  00FC1A  C9 06                             CMP     #6          ; Is it > 5? (Sets C=0 if it is valid 0-5)
05154  00FC1C  B0 03                             BCS     .INVALID    ; If it wasn't a valid hex letter, reject it.
05155                      
05156  00FC1E  69 0A                             ADC     #10         ; C=0 from CMP, so it perfectly adds exactly 10.
05157  00FC20  60            .DONE               RTS
05158  00FC21  A9 FF         .INVALID            LDA     #FAIL
05159  00FC23  60                                RTS
05160  
05161  
05162  ;--------------------------------------------------------------
05163  ;Restore saved registers - used for Tracing
05164  ;--------------------------------------------------------------
05165  00FC24  A5 A8         RESTORE             LDA     SAVP                ;Restore 6502 Register Contents 
05166  00FC26  48                                PHA                         ;Used by tracing software
05167  00FC27  A5 AC                             LDA     SAVA    
05168  00FC29  A6 AB                             LDX     SAVX
05169  00FC2B  A4 AA                             LDY     SAVY
05170  00FC2D  28                                PLP
05171  00FC2E  60                                RTS
05172  
05173  
05174  ;------------------------------------------------------------------------
05175  ; Save HW registers
05176  ;------------------------------------------------------------------------       
05177  00FC2F  85 AC         SAVE                STA     SAVA                ;Save 6502 HW registers
05178  00FC31  86 AB                             STX     SAVX
05179  00FC33  84 AA                             STY     SAVY
05180  00FC35  08                                PHP
05181  00FC36  68                                PLA
05182  00FC37  85 A8                             STA     SAVP                ;svae the flags
05183  00FC39  BA                                TSX
05184  00FC3A  86 A9                             STX     SAVS                ;stack pointer              
05185  00FC3C  60                                RTS 
05186  
05187  
05188  ;------------------------------------------------------------------------
05189  ;Convert keyboard buffer to uppercase           
05190  ;------------------------------------------------------------------------
05191  00FC3D  B5 19         UPPERCASE           LDA     IN,x
05192  00FC3F  C9 7B                             CMP     #'z'+1              
05193  00FC41  B0 08                             BCS     .NEXTDIGIT          
05194  00FC43  C9 61                             CMP     #'a'                
05195  00FC45  90 04                             BCC     .NEXTDIGIT          
05196  00FC47  E9 20                             SBC     #SP         
05197  00FC49  95 19                             STA     IN,x                
05198  00FC4B  CA            .NEXTDIGIT          DEX
05199  00FC4C  10 EF                             BPL     UPPERCASE           ;end of string          
05200  00FC4E  60                                RTS         
05201   
05202   
05203          .IF LCD_ROUTINES
05204          .ENDIF                      ;End of LCD Routines
