01142  00E560  20 91 FB                          JSR     WRCRLF              ;new line
01143  00E563  A9 10                             LDA     #$10
01144  00E565  20 9D E2                          JSR     BUMPSRCE            ;Add to SRCE for next 16 bytes                  
01145  00E568  7A                                PLY                     
01146  00E569  20 E4 FB                          JSR     SCAN_ESC            ;Scan for Escape    
01147  00E56C  F0 05                             BEQ     EXIT                ;Z=1 Escape pressed
01148  00E56E  88                                DEY         
01149  00E56F  D0 CA                             BNE     .NEWLINE                
01150  00E571  64 C9                             STZ     ERROR                   
01151  00E573  60            EXIT                RTS
