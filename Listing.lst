00203  ;------------------------------------------------------------------------
00204  ; Hardware mapping
00205  ;------------------------------------------------------------------------
00206              .IF LCD_ROUTINES
00207  
00208  ;------------------------------------------------------------------------
00209  ; My board settings (MYWYM = Real Hardware SBC)
00210  ;------------------------------------------------------------------------   
00211              .IF MYWYM
00212      
00213                  .IF SYMON   
00214                      .IF PROTEUS	    ; My Proteus Simulator	
00215    A000              VIA             = 	$A000       ; Proteus Schematic 
00216    AF00              ACIA            = 	$AF00       ; Proteus Schematic 
00217    A200              LCD		=	$A200
00218                      .ELSE           
00219                  .ENDIF    
00220  
00221    AF00              ADATA           = ACIA              ; 6551 Data Register
00222    AF01              ASTAT           = ADATA + 1         ; 6551 Status Register
00223    AF02              ACMND           = ADATA + 2         ; 6551 Command Register
00224    AF03              ACTRL           = ADATA + 3         ; 6551 Control Register
00225  
00226  
00227                  ; --- VIA 6522 Definitions ---
00228    A000              REGB            = VIA               
00229    A001              REGA            = REGB + 1
00230    A002              DIRB            = REGB + 2
00231    A003              DIRA            = REGB + 3
00232    A004              TICL            = REGB + 4
00233    A005              TICH            = REGB + 5
00234    A00B              ACR             = REGB + $B
00235    A00C              PCR             = REGB + $C
00236    A00D              IFR             = REGB + $D
00237    A00E              IER             = REGB + $E
00238  
00239              .ELSE
