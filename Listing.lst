04415  ;------------------------------------------------------------------------------------------         
04416  ;Interrupts Handling        
04417  ;------------------------------------------------------------------------------------------
04418  00F8AD  6C 00 01      NMI_VECTOR          JMP     (USMNI)             ;NMI hardware interrupt handler                             
04419                                                  ;loop through RAM               
04420  
04421  
04422  ;------------------------------------------------------------------------------------------
04423  NMI_RETURN                  ;Routines http://6502.org/tutorials/interrupts.html 
04424                      
04425  IRQ_RETURN          ;JSR    SAVE             
04426                      ;LDA    ASTAT               ;Read 6551 ACIA status register
04427                      ;AND    #$88                ;Isolate bits 7: Interrupt has occured and 3: receive data register full 
04428                      ;EOR    #$88                ;Invert state of both bits      
04429                      ;BNE    .BRKINSTR           ;IF bit 7 OR bit 3 = 1: no valid data in receive data register                         
04430                      ;LDX    INCNT               ; ELSE, Store keystroke in keystroke buffer address
04431                      ;STA    IN,X                ;  indexed by INCNT: keystroke buffer input counter
04432                      ;INC    INCNT               ;Increment keystroke buffer input counter
04433  .BRKINSTR           ;JSR    RESTORE         
04434  00F8B0  40                                RTI                         ;IRQ return address - used to store in RAM 
04435  
04436  
04437  ;------------------------------------------------------------------------------------------
04438  ;IRQ Routine
04439  ;------------------------------------------------------------------------------------------
04440  00F8B1  48            IRQ_VECTOR          PHA                         ;IRQ hardware interrupt
04441  00F8B2  DA                                PHX
04442  00F8B3  BA                                TSX
04443  00F8B4  BD 03 01                          LDA     $0103,x             ;check if caused by a 
04444  00F8B7  FA                                PLX                         ;done with X so restore it
04445  00F8B8  89 10                             BIT     #$10                ;BRK instruction            
04446  00F8BA  D0 04                             BNE     GOBRK               ;yes            
04447  00F8BC  68                                PLA                         ;no must have been an IRQ           
04448  00F8BD  6C FC 00                          JMP     (USIRQ)         
04449  00F8C0  68            GOBRK               PLA     
04450  00F8C1  6C FE 00                          JMP     (USBRK)
04451  
04452  
04453  ;------------------------------------------------------------------------------------------
04454  ; IRQ Routine return
04455  ;------------------------------------------------------------------------------------------
04456  00F8C4  28            BRK_RETURN          PLP
04457  00F8C5  20 2F FC                          JSR     SAVE                ;Save the Registers
04458  00F8C8  68                                PLA                         ; save the Program counter
04459  00F8C9  85 DF                             STA     SRCE
04460  00F8CB  68                                PLA
04461  00F8CC  85 E0                             STA     SRCE+1
04462  00F8CE  BA                                TSX         
04463  00F8CF  86 A9                             STX     SAVS                ;save registers
04464  00F8D1  20 91 F9      XBRK                JSR     TRACE_DIS           ;show registers     
04465  00F8D4  58                                CLI
04466  00F8D5  4C 03 E0                          JMP     WARM 
04467  
04468  
04469  ;------------------------------------------------------------------------------------------
04470  ; Tracing
04471  ;------------------------------------------------------------------------------------------
04472  ; =======================================================================
04473  ; COMMAND: TRACE (CMD_TRACE)
04474  ; -----------------------------------------------------------------------
04475  ; Single-steps through 65C02 code. Simulates stack operations (JSR/RTS) 
04476  ; and intercepts conditional branches by executing them in a safe RAM 
04477  ; space (XQT) to see if they are taken.
04478  ; =======================================================================
04479  00F8D8  68            CMD_TRACE           PLA                         ; Pull caller address off stack      
04480  00F8D9  68                                PLA                         
04481  00F8DA  20 49 E9                          JSR     GET_EXPRES          ; Get start address
04482  00F8DD  D0 07                             BNE     .CONT
04483  00F8DF  84 DF                             STY     SRCE                ; Store low byte
04484  00F8E1  85 E0                             STA     SRCE+1              ; Store high byte
04485  00F8E3  20 61 FB                          JSR     CLS                 ; Clear the screen                   
04486  
04487  00F8E6  20 91 F9      .CONT               JSR     TRACE_DIS           ; Display one line of disassembled code
04488                      
04489                      				; --- INITIALIZE EXECUTION AREA ---
04490  00F8E9  A2 08                             LDX     #$08
04491  00F8EB  BD 88 F9      XQINIT              LDA     INITBL-1,X          ; Init XEQ AREA
04492  00F8EE  95 99                             STA     XQT,X           
04493  00F8F0  CA                                DEX
04494  00F8F1  D0 F8                             BNE     XQINIT              
04495                      
04496                      				; --- IDENTIFY INSTRUCTION ---
04497  00F8F3  B2 DF                             LDA     (SRCE)              ; OPTIMIZATION: 65C02 native LDA (zp)
04498  00F8F5  F0 DA                             BEQ     XBRK                ; $00 = BRK (Jumps to your existing global XBRK handler)
04499                      
04500  00F8F7  A4 DD                             LDY     LENG                ; <--- RESTORED: Length from Disassembler!
04501                      
04502  00F8F9  C9 80                             CMP     #$80                ; $80 = BRA (Branch Always)
04503  00F8FB  F0 2A                             BEQ     XBRA                ; Handle unconditional branch directly
04504                      
04505  00F8FD  C9 20         .BRNCH              CMP     #$20                ; JSR
04506  00F8FF  F0 43                             BEQ     XJSR                
04507  00F901  C9 60                             CMP     #$60                ; RTS
04508  00F903  F0 31                             BEQ     XRTS
04509  00F905  C9 4C                             CMP     #$4C                ; JMP (Absolute)
04510  00F907  F0 43                             BEQ     XJMP
04511  00F909  C9 6C                             CMP     #$6C                ; JMP (Indirect)
04512  00F90B  F0 4D                             BEQ     XJMPAT
04513  00F90D  C9 40                             CMP     #$40                ; RTI
04514  00F90F  F0 19                             BEQ     XRTI
04515                      
04516                      				; --- CONDITIONAL BRANCH INTERCEPT ---
04517  00F911  29 1F                             AND     #$1F                
04518  00F913  49 14                             EOR     #$14                ; Forces A to equal $04!
04519  00F915  C9 04                             CMP     #$04                ; Is it a conditional branch?
04520  00F917  F0 02                             BEQ     .XQ2                ; Yes! Jump to .XQ2 to overwrite offset with $04.
04521                      
04522  00F919  B1 DF         .XQ1                LDA     (SRCE),Y            ; Copy normal instruction bytes into XEQ area
04523  00F91B  99 99 00      .XQ2                STA     XQT,Y               ; If branch, overwrites offset with $04 to perfectly target XQT+6!
04524  00F91E  88                                DEY                         
04525  00F91F  10 F8                             BPL     .XQ1                
04526                      
04527  00F921  20 24 FC                          JSR     RESTORE             ; Restore user registers 
04528  00F924  4C 99 00                          JMP     XQT                 ; EXECUTE user code in RAM!
04529  
04530  						; --- FLOW CONTROL SIMULATORS ---
04531  
04532  00F927  4C 74 F9      XBRA                JMP     BRANCH              ; BRA is unconditional. Jump straight to existing relative math!
04533  
04534  00F92A  68            XRTI                PLA                         ; Simulate RTI: Pull Flags
04535  00F92B  85 A8                             STA     SAVP                
04536  00F92D  68                                PLA                         ; Pull PC Low
04537  00F92E  85 DF                             STA     SRCE
04538  00F930  68                                PLA                         ; Pull PC High
04539  00F931  85 E0                             STA     SRCE+1
04540  00F933  4C 71 F9                          JMP     RTS_TRACE           ; BUG FIX: Do NOT add 1! RTI returns to exact address.
04541  
04542  00F936  68            XRTS                PLA                         ; Simulate RTS
04543  00F937  85 DF                             STA     SRCE                ; Pull PC Low from stack
04544  00F939  68                                PLA                         
04545  00F93A  85 E0                             STA     SRCE+1              ; Pull PC High from stack
04546  00F93C  20 1D E4      PCINC3              JSR     PCADJ2              ; Add 1 to the pulled address (RTS specific)
04547  00F93F  84 E0                             STY     SRCE+1
04548  00F941  18                                CLC
04549  00F942  80 11                             BRA     NEWPCL              ; Update PC and exit
04550  
04551  00F944  18            XJSR                CLC                         
04552  00F945  20 1D E4                          JSR     PCADJ2              ; Calculate Return Address (Current PC + 2)
04553  00F948  5A                                PHY                         ; Push Return Address High
04554  00F949  48                                PHA                         ; Push Return Address Low
04555  00F94A  A0 02                             LDY     #$02
04556  00F94C  18            XJMP                CLC
04557  00F94D  B1 DF                             LDA     (SRCE),Y            ; Get Absolute Target High
04558  00F94F  AA                                TAX                         
04559  00F950  88                                DEY                         
04560  00F951  B1 DF                             LDA     (SRCE),Y            ; Get Absolute Target Low
04561  00F953  86 E0                             STX     SRCE+1              ; Update PC
04562  00F955  85 DF         NEWPCL              STA     SRCE
04563  00F957  4C 71 F9                          JMP     RTS_TRACE
04564  
04565  00F95A  A0 02         XJMPAT              LDY     #$02                ; Simulate JMP (Indirect)
04566  00F95C  B1 DF                             LDA     (SRCE),Y
04567  00F95E  AA                                TAX
04568  00F95F  88                                DEY
04569  00F960  B1 DF                             LDA     (SRCE),Y            ; A = Vector Low, X = Vector High
04570  00F962  85 E7                             STA     TEMP1               ; Store Vector in Zero Page
04571  00F964  86 E8                             STX     TEMP1+1
04572  00F966  B2 E7                             LDA     (TEMP1)             ; BUG FIX: Read actual destination LOW from the Vector
04573  00F968  AA                                TAX
04574  00F969  A0 01                             LDY     #$01
04575  00F96B  B1 E7                             LDA     (TEMP1),Y           ; Read actual destination HIGH from the Vector
04576  00F96D  86 DF                             STX     SRCE                ; Update PC Low
04577  00F96F  85 E0                             STA     SRCE+1              ; Update PC High
04578  
04579  00F971  4C 14 E0      RTS_TRACE           JMP     GETLINE             ; Return to OS Prompt
