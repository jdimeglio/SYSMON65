02597  ;------------------------------------------------------------------------
02598  ; ADDLINE - Add line to the program 
02599  ; - todo remove PACK into subroutine and add more optoins aka any repitable chars
02600  ; [LENGTH][LINE NUMBER][PACKED LINE] [EOL]
02601  ;------------------------------------------------------------------------
02602  00EF17  20 42 E8      ADDLINE             JSR     GET_VAL             ;ADDLINE - Add line to the program 
02603                                                  ;Get line number eg: 1000
02604  00EF1A  F0 01                             BEQ     .NOERR              ;No error occurred!
02605  00EF1C  60                                RTS
02606  
02607  00EF1D  18            .NOERR              CLC
02608  00EF1E  A5 D2                             LDA     HEXVAL              ;Calculate next auto line number
02609  00EF20  65 EC                             ADC     AUTO_INC
02610  00EF22  85 EA                             STA     AUTO
02611  00EF24  A9 00                             LDA     #0                  ;Invalidate symbol table
02612  00EF26  85 EF                             STA     SYM_TABLE+1
02613  00EF28  85 E9                             STA     OLD_SAVE            ;Invalidate OLD command
02614  00EF2A  65 D3                             ADC     HEXVAL+1            ;Oh yes, we were busy adding
02615  00EF2C  85 EB                             STA     AUTO+1              ; something!    
02616  00EF2E  8A                                TXA                         ;Save read index
02617  00EF2F  A8                                TAY
02618  00EF30  20 0A E8                          JSR     NNONSPC             ;See if line contains text
02619  00EF33  D0 0F                             BNE     .OK                 ;It does!
02620  00EF35  A5 D2                             LDA     HEXVAL              ;Set begin and end line to linenum
02621  00EF37  85 CB                             STA     PARM1               ; to delete this line from source
02622  00EF39  85 CD                             STA     PARM2
02623  00EF3B  A5 D3                             LDA     HEXVAL+1
02624  00EF3D  85 CC                             STA     PARM1+1
02625  00EF3F  85 CE                             STA     PARM2+1
02626  00EF41  4C 81 EB                          JMP     DELETE              ;Delete this line!
02627  
02628  00EF44  98            .OK                 TYA                         ;Restore read index
02629  00EF45  AA                                TAX
02630  00EF46  A0 00                             LDY     #0                  ;Clear write index
02631  00EF48  B5 19                             LDA     IN,X                ;Ignore first space after linenum
02632  00EF4A  C9 20                             CMP     #SP                 ; (not part of source)
02633  00EF4C  D0 01                             BNE     .LOOP1              ;Forget about 1st space!
02634  00EF4E  E8            .LOOP               INX                         ;Get next character
02635  00EF4F  B5 19         .LOOP1              LDA     IN,X
02636  00EF51  C9 20                             CMP     #SP                 ;Is it a space?
02637  00EF53  F0 12                             BEQ     .PACK               ;Yes! Pack it!
02638  00EF55  C9 2D                             CMP     #DASH               ;Is it a dash?
02639  00EF57  F0 0E                             BEQ     .PACK               ;Yes! Pack it!
02640  00EF59  C9 5F                             CMP     #'_'                ;It it horizontal grz   
02641  00EF5B  F0 0A                             BEQ     .PACK               ;Yes! Pack it!  
02642  00EF5D  C9 0D                             CMP     #CR                 ;Is it end of line?
02643  00EF5F  F0 33                             BEQ     .EOL                ;Yes! Packed entire line now!
02644  00EF61  99 19 00      .WRITE              STA     IN,Y                ;Save normal character
02645  00EF64  C8                                INY                         ;Increment write pointer
02646  00EF65  80 E7                             BRA     .LOOP               ;Always taken!
02647  
02648  00EF67  85 D1         .PACK               STA     DELIM               ;Save character to pack
02649  00EF69  A9 01                             LDA     #1                  ;Init repetition counter
02650  00EF6B  85 D0                             STA     COUNT
02651  00EF6D  E8            .PCKLOOP            INX                         ;Count number of same characters
02652  00EF6E  B5 19                             LDA     IN,X
02653  00EF70  C5 D1                             CMP     DELIM
02654  00EF72  D0 09                             BNE     .PCKEXIT            ;It's not the same anymore!
02655  00EF74  E6 D0                             INC     COUNT               ;Increment counter
02656  00EF76  A5 D0                             LDA     COUNT               ;Don't allow it to exceed 31
02657  00EF78  C9 1F                             CMP     #31
02658  00EF7A  90 F1                             BCC     .PCKLOOP            ;Still OK!
02659  00EF7C  E8                                INX                         ;Compensate for normal exit
02660  00EF7D  CA            .PCKEXIT            DEX                         ;We're too far now
02661  00EF7E  A5 D1                             LDA     DELIM               ;Was it space or dash?
02662  00EF80  C9 20                             CMP     #SP                 ;                  
02663  00EF82  F0 0A                             BEQ     .SPACE_FLAG         ;It was space!                  
02664  00EF84  C9 2D                             CMP     #DASH
02665  00EF86  F0 03                             BEQ     .DASH_FLAG                  
02666  00EF88  A9 A0                             LDA     #%10100000          ;Set underscore flag
02667                  .DB $2C                         ;Skip two bytes trcick          
02668                      ;BRA    .ADDCOUNT           
02669  00EF8B  A9 C0         .DASH_FLAG           LDA     #%11000000         ;Set dash flag
02670                  .DB $2C             ;Skip two bytes
02671                      ;BRA    .ADDCOUNT
02672  00EF8E  A9 E0         .SPACE_FLAG         LDA     #%11100000          ;Set space flag         
02673  00EF90  05 D0         .ADDCOUNT           ORA     COUNT               ;Combine with counter           
02674  00EF92  80 CD                             BRA     .WRITE              ;Always taken!
02675  
02676  00EF94  98            .EOL                TYA                         ;Add 3 byte overhead to length
02677  00EF95  18                                CLC
02678  00EF96  69 03                             ADC     #3
02679  00EF98  85 DD                             STA     LENG                ;Save length
02680  00EF9A  85 D0                             STA     COUNT
02681  00EF9C  A0 D2                             LDY     #HEXVAL             ;Find line in program memory
02682  00EF9E  20 67 F0                          JSR     FIND_LINE
02683  00EFA1  90 31                             BCC     .NEWLINE            ;EOF! Line does not exist yet
02684  00EFA3  D0 2F                             BNE     .NEWLINE            ;Line does not exist yet
02685  
02686  ; The line number already exists. Compare both line lengths
02687  
02688  00EFA5  A0 00                             LDY     #0                  ;Is new line longer or shorter?
02689  00EFA7  38                                SEC
02690  00EFA8  A5 DD                             LDA     LENG
02691  00EFAA  F1 B6                             SBC     (PNTR),Y
02692  00EFAC  F0 5C                             BEQ     .INSERT             ;Line length did not change!
02693  00EFAE  85 DD                             STA     LENG                ;Save number of bytes difference
02694  00EFB0  B0 22                             BCS     .NEWLINE            ;Make room for longer line
02695  
02696  00EFB2  38            .SHORTER            SEC                         ;Setup source and destination to
02697  00EFB3  A5 B6                             LDA     PNTR                ; move the source down
02698  00EFB5  48                                PHA
02699  00EFB6  85 E1                             STA     DEST
02700  00EFB8  E5 DD                             SBC     LENG                ;(length is negative!)
02701  00EFBA  85 DF                             STA     SRCE
02702  00EFBC  A5 B7                             LDA     PNTR+1
02703  00EFBE  48                                PHA
02704  00EFBF  85 E2                             STA     DEST+1
02705  00EFC1  E9 FF                             SBC     #-1                 ;(keep high byte negative too!)
02706  00EFC3  85 E0                             STA     SRCE+1
02707  00EFC5  20 34 F0                          JSR     CALC_LENG           ;Get the number of bytes to move
02708  00EFC8  68                                PLA                         ;Restore PNTR (was destroyed by
02709  00EFC9  85 B7                             STA     PNTR+1              ; CALC_LENG)
02710  00EFCB  68                                PLA
02711  00EFCC  85 B6                             STA     PNTR
02712  00EFCE  20 A1 E6                          JSR     MOV_DOWN            ;Move rest of program down
02713  00EFD1  4C 0A F0                          JMP     .INSERT             ;Insert new, shorter, line
02714  
02715  00EFD4  A5 B6         .NEWLINE            LDA     PNTR                ;Use current pointer as
02716  00EFD6  48                                PHA                         ; source
02717  00EFD7  85 DF                             STA     SRCE
02718  00EFD9  18                                CLC                         ;Add new line's length to it
02719  00EFDA  65 DD                             ADC     LENG                ; to find the destination
02720  00EFDC  85 E1                             STA     DEST
02721  00EFDE  A5 B7                             LDA     PNTR+1
02722  00EFE0  48                                PHA
02723  00EFE1  85 E0                             STA     SRCE+1
02724  00EFE3  69 00                             ADC     #0
02725  00EFE5  85 E2                             STA     DEST+1
02726  00EFE7  20 34 F0                          JSR     CALC_LENG           ;Calculate number of bytes to move
02727      
02728  00EFEA  18                                CLC                         ;See if there's enough room in
02729  00EFEB  A5 E1                             LDA     DEST                ; memory until HIMEM
02730  00EFED  65 DD                             ADC     LENG
02731  00EFEF  85 B6                             STA     PNTR
02732  00EFF1  A5 E2                             LDA     DEST+1
02733  00EFF3  65 DE                             ADC     LENG+1
02734  00EFF5  85 B7                             STA     PNTR+1
02735  00EFF7  A5 F6                             LDA     HIMEM
02736  00EFF9  C5 B6                             CMP     PNTR
02737  00EFFB  A5 F7                             LDA     HIMEM+1
02738  00EFFD  E5 B7                             SBC     PNTR+1
02739  00EFFF  90 2C                             BCC     .MEMFUL             ;Memory full!
02740  00F001  20 C2 E6                          JSR     MOV_UP              ;Move them! (move end marker to end)
02741  00F004  68                                PLA                         ;Restore pointer
02742  00F005  85 B7                             STA     PNTR+1
02743  00F007  68                                PLA
02744  00F008  85 B6                             STA     PNTR
02745  
02746  00F00A  A0 00         .INSERT             LDY     #0                  ;Insert new line to freed space
02747  00F00C  A2 00                             LDX     #0
02748  00F00E  A5 D0                             LDA     COUNT               ;Start with length byte
02749  00F010  91 B6                             STA     (PNTR),Y
02750  00F012  38                                SEC                         ;Subtract header length
02751  00F013  E9 03                             SBC     #3
02752  00F015  85 D0                             STA     COUNT
02753  00F017  C8                                INY
02754  00F018  A5 D2                             LDA     HEXVAL              ;Then comes the line number
02755  00F01A  91 B6                             STA     (PNTR),Y
02756  00F01C  C8                                INY
02757  00F01D  A5 D3                             LDA     HEXVAL+1
02758  00F01F  91 B6                             STA     (PNTR),Y
02759  00F021  C8                                INY
02760  00F022  B5 19         .INSLOOP            LDA     IN,X                ;Get byte from new line
02761  00F024  91 B6                             STA     (PNTR),Y            ; and store it
02762  00F026  E8                                INX
02763  00F027  C8                                INY
02764  00F028  C6 D0                             DEC     COUNT
02765  00F02A  D0 F6                             BNE     .INSLOOP            ;Not all bytes done yet!
02766  00F02C  60                                RTS
02767  
02768  00F02D  A9 51         .MEMFUL             LDA     #ERR_MEM            ;Exit with memory full error
02769  00F02F  85 C9                             STA     ERROR
02770  00F031  68                                PLA                         ;Clear stack
02771  00F032  68                                PLA
02772  00F033  60                                RTS
