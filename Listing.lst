00479  ;----------------------------------------------------------------------------------------
00480  ;Intel HEX loader
00481  ;----------------------------------------------------------------------------------------
00482    00DD              CHECKSUM    =   LENG        
00483  
00484  00E127  78            CMD_INTELHEX        SEI                         ;stop Interrupts            
00485  00E128  D8                                CLD                         ;binary mode additons           
00486  00E129  64 D8                             STZ     EXP_SAVE            ;temp           
00487  00E12B  64 DA                             STZ     DEC_SAVE            ;Bytes count
00488  00E12D  64 DB                             STZ     DEC_SAVE+1                      
00489  00E12F  64 DD                             STZ     CHECKSUM            ;checksum   
00490  00E131  A9 0D                             LDA     #CR         
00491  00E133  8D 00 AF                          STA     ACIA                ;dont wait on port status           
00492  00E136  A9 0A                             LDA     #LF         
00493  00E138  8D 00 AF                          STA     ACIA                ;dont wait on port status                                   
00494  00E13B  80 34                             BRA     CONTINUE                                
00495                  
00496  00E13D  20 F1 FB      NEXTRECORD          JSR     RDCHAR
00497  00E140  C9 0D                             CMP     #CR             
00498  00E142  D0 0E                             BNE     PROTOCOLERROR               
00499  00E144  20 F1 FB                          JSR     RDCHAR              ;CRLF and end of line (BUG there's a CHECKSUM)              
00500  00E147  C9 0A                             CMP     #LF             
00501  00E149  D0 07                             BNE     PROTOCOLERROR               
00502  00E14B  20 F1 FB                          JSR     RDCHAR              
00503  00E14E  C9 3A                             CMP     #':'                
00504  00E150  F0 1F                             BEQ     CONTINUE                
00505                  
00506  00E152  20 98 FB      PROTOCOLERROR       JSR     WRCHAR
00507  00E155  20 ED FA                          JSR     STRING              
00508                  .ASCII    BELL,CR,LF," :PROTOCOL ERROR",CR,LF,EOS
00509  00E16E  4C 7D E2                          JMP     TERMINATE               
00510  
00511  00E171  20 85 E2      CONTINUE            JSR     READ_DATA           ;read rcord length with checksum add
00512  00E174  85 D0                             STA     COUNT               ;load the amount of bytes to load into memory               
00513  00E176  20 85 E2                          JSR     READ_DATA           ;read hgh byte of memory location                           
00514  00E179  85 E0                             STA     SRCE+1              ;store hgh byte of memory location                              
00515  00E17B  20 85 E2                          JSR     READ_DATA           ;read low byte with checksum add                            
00516  00E17E  85 DF                             STA     SRCE                ;store                                          
00517  00E180  20 85 E2                          JSR     READ_DATA           ;get record type 01 = end               
00518                      ;CMP     #$00               ;check if 00 if yes then type #00               
00519  00E183  F0 2E                             BEQ     .DATARECORD         ;get the data frame                             
00520  00E185  C9 01                             CMP     #$01                ;is it type #01 ie: end of record               
00521  00E187  D0 03                             BNE     .INVREC             ;else invalid               
00522  00E189  4C 2D E2                          JMP     .END_RECORD             
00523  
00524  00E18C  20 ED FA      .INVREC             JSR     STRING
00525                  .ASCII    BELL,CR,LF," :INVALID RECORD TYPE",CR,LF,EOS
00526  00E1AA  4C 7D E2                          JMP     TERMINATE
00527  
00528              .IF MYWYM
00529  .LEDS           .BYTE   1                       ;quicker than a shift
00530                  .BYTE   2                       ;knight rider lights
00531                  .BYTE   4
00532                  .BYTE   8
00533                  .BYTE   4
00534                  .BYTE   2
00535              .ENDIF              
00536  
00537  00E1B3  A6 D0         .DATARECORD         LDX     COUNT               ;DATASIZE
00538  00E1B5  A0 00                             LDY     #$00                
00539  00E1B7  20 85 E2      .NEXT_BYTE          JSR     READ_DATA           ;read two hex characters
00540  00E1BA  91 DF                             STA     (SRCE),y            ;store in RAM               
00541  00E1BC  D1 DF                             CMP     (SRCE),y            ;did it actually store          
00542  00E1BE  D0 20                             BNE     .WRITEERROR         ;no then error - probably no ram there              
00543  00E1C0  A9 23                             LDA     #'#'                ;write fast         
00544  00E1C2  8D 00 AF                          STA     ACIA                ;dont wait on port status                           
00545  00E1C5  C8                                INY                         ;next address               
00546  00E1C6  CA                                DEX                         ;next byte to recieve               
00547                      ;CPX     #$00               ;all bytes recieved?                
00548  00E1C7  D0 EE                             BNE     .NEXT_BYTE          ;no then get next record                
00549  00E1C9  20 85 E2                          JSR     READ_DATA           ;get checksum           
00550  
00551              .IF MYWYM                           
00552  00E1CC  A6 D8                             LDX     EXP_SAVE            ;which LED to turn on               
00553  00E1CE  BC AD E1                          LDY     .LEDS,x                     
00554  00E1D1  8C 00 A0                          STY     VIA             
00555  00E1D4  E8                                INX             
00556  00E1D5  86 D8                             STX     EXP_SAVE                
00557  00E1D7  E0 06                             CPX     #$06                
00558  00E1D9  D0 02                             BNE     .LEDCNT             
00559  00E1DB  64 D8                             STZ     EXP_SAVE            ;leds shifting counter restart              
00560              .ENDiF  
00561  00E1DD  4C 3D E1      .LEDCNT             JMP    NEXTRECORD
00562  
00563  00E1E0  20 ED FA      .WRITEERROR         JSR     STRING
00564                  .ASCII   BELL,CR,LF
00565                  .ASCII   " :CANNOT WRITE AT ADDRESS $",EOS
00566  
00567  00E202  A5 E0                             LDA     SRCE+1              
00568  00E204  20 C1 FB                          JSR     WR2HEX              
00569  00E207  A5 DF                             LDA     SRCE                
00570  00E209  20 C1 FB                          JSR     WR2HEX              
00571  00E20C  20 91 FB                          JSR     WRCRLF                                  
00572  00E20F  80 6C                             BRA     TERMINATE   
00573  
00574  00E211  20 ED FA      .CHECKSUMERR        JSR     STRING
00575                  .ASCII    BELL,LF,CR," :CHECK SUM ERROR",LF,CR,EOS
00576  00E22B  80 50                             BRA     TERMINATE               
00577                  
00578  00E22D  20 01 FC      .END_RECORD         JSR     RD2HEX              ;last two byes the CheckSUM
00579  00E230  18                                CLC         
00580  00E231  65 DD                             ADC     CHECKSUM            
00581  00E233  D0 DC                             BNE     .CHECKSUMERR                
00582  00E235  20 ED FA                          JSR     STRING
00583                  .ASCII  BELL,CR,LF              
00584                  .ASCII   " :INTEL-HEX SUCCESSFUL",EOS
00585  00E252  20 ED FA                          JSR     STRING                          
00586                  .ASCII   CR,LF
00587                  .ASCII   " :TOTAL BYTES WRITTEN ",EOS
00588  00E26E  A4 DA                             LDY     DEC_SAVE
00589  00E270  A5 DB                             LDA     DEC_SAVE+1
00590  00E272  20 11 EA                          JSR     WRDECI                          
00591              
00592              .IF MYWYM                               
00593  00E275  A9 09                             LDA     #%00001001          ;set lights             
00594  00E277  8D 00 A0                          STA     REGB
00595              .ENDIF              
00596  00E27A  58                                CLI             
00597  00E27B  18                                CLC             
00598  00E27C  60                                RTS                         ;return to caller
00599                      
00600  TERMINATE  
00601              .IF MYWYM   
00602  00E27D  A9 0F                             LDA     #%00001111          ;LEDS arrange in the
00603  00E27F  8D 00 A0                          STA     REGB                ;mode means an error                                
00604              .ENDIF              
00605  00E282  38                                SEC             
00606  00E283  58                                CLI             
00607  00E284  60                                RTS                         ;return to caller
00608                  
00609  ;---------------------------------------------------------------------------------
00610  00E285  20 01 FC      READ_DATA           JSR     RD2HEX               ;read two hex characters & checksum
00611                      ;bcs     ERRS
00612  00E288  48                                PHA             
00613  00E289  18                                CLC             
00614  00E28A  65 DD                             ADC     CHECKSUM             ;add to checksum
00615  00E28C  85 DD                             STA     CHECKSUM                                
00616  00E28E  18                                CLC
00617  00E28F  A5 DA                             LDA     DEC_SAVE
00618  00E291  69 01                             ADC     #01
00619  00E293  85 DA                             STA     DEC_SAVE
00620  00E295  A5 DB                             LDA     DEC_SAVE+1          ;add the carry  
00621  00E297  69 00                             ADC     #00
00622  00E299  85 DB                             STA     DEC_SAVE+1
00623  00E29B  68                                PLA             
00624  00E29C  60                                RTS
00625                  
00626  ;ERRS           tsx                             ;remove the last RTS from stack
00627  ;               inx
00628  ;               inx
00629  ;               txs
00630  ;               jsr     STRING     ;read error from RS232
00631  ;               .ASCIS   BELL,CR,LF," :READ ERROR FROM ACIA",CR,LF,EOS
00632  ;               BRA     TERMINATE
00633                                      
00634                                      
00635  
00636  ;------------------------------------------------------------------------   
00637  ;Bump Address by AC ie: SRCE variable add it by AC
00638  ;------------------------------------------------------------------------   
00639  00E29D  18            BUMPSRCE            CLC
00640  00E29E  65 DF                             ADC     SRCE 
00641  00E2A0  85 DF                             STA     SRCE  
00642  00E2A2  90 02                             BCC     .BUMPSRCE                                                       
00643  00E2A4  E6 E0                             INC     SRCE+1                      
00644  00E2A6  60            .BUMPSRCE           RTS             
00645  
00646  
00647  ;------------------------------------------------------------------------   
00648  ;Instruction display - orginal code seems to come from MOS
00649  ;------------------------------------------------------------------------   
00650  ;------------------------------------------------------------------------   
00651  ;Instruction display - orginal code seems to come from MOS
00652  ;------------------------------------------------------------------------   
00653  00E2A7  A8            INSTDSP             TAY                         ;Save op code
00654  00E2A8  4A                                LSR                         ;* Even/odd test
00655  00E2A9  90 05                             BCC     .IEVEN
00656  00E2AB  6A                                ROR                         ;* Test B1
00657  00E2AC  B0 11                             BCS     .ERR                ;XXXXXX11 instr invalid
00658  00E2AE  29 87                             AND     #$87                ;Mask 3 bits for address mode
00659  00E2B0  4A            .IEVEN              LSR                         ;* LSB into carry for
00660  00E2B1  AA                                TAX                         ;Left/right test below
00661  00E2B2  BD 37 F8                          LDA     MODE,X              ;Index into address mode table
00662  00E2B5  90 04                             BCC     .RTMODE             ;If carry set use LSD for
00663  00E2B7  4A                                LSR                         ;* print format index
00664  00E2B8  4A                                LSR         
00665  00E2B9  4A                                LSR                         ;If carry clear use MSD
00666  00E2BA  4A                                LSR   
00667  00E2BB  29 0F         .RTMODE             AND     #$0F                ;Mask for 4-bit index
00668  00E2BD  D0 04                             BNE     .GETFMT             ;$0 for invalid opcodes
00669  00E2BF  A0 FC         .ERR                LDY     #$FC                ;Substitute $FC for invalid op,
00670  00E2C1  A9 00                             LDA     #$00                ;set print format index to 0
00671  00E2C3  AA            .GETFMT             TAX   
00672  00E2C4  BD 7B F8                          LDA     MODE2,X             ;Index into print format table
00673  00E2C7  85 DC                             STA     SAVE_Y              ;Save for address field format
00674  00E2C9  29 03                             AND     #$03                ;Mask 2-bit length.  0=1-byte
00675  00E2CB  85 DD                             STA     LENG                ;* 1=2-byte, 2=3 byte
00676  00E2CD  98                                TYA                         ;* op code
00677  00E2CE  20 C9 F6                          JSR     GETMNE              ;Lookup the mnemonic
00678  00E2D1  A0 00                             LDY     #$00
00679  00E2D3  48                                PHA                         ;Save mnemonic table index
00680  00E2D4  B1 DF         .PROP               LDA     (SRCE),Y
00681  00E2D6  20 C1 FB                          JSR     WR2HEX
00682  00E2D9  A2 01                             LDX     #$01
00683  00E2DB  20 A9 FB      .PROPBL             JSR     WRBL2
00684  00E2DE  C4 DD                             CPY     LENG                ;Print instr (1 to 3 bytes)
00685  00E2E0  C8                                INY                         ;* in a 12-character field
00686  00E2E1  90 F1                             BCC     .PROP
00687  00E2E3  A2 03                             LDX     #$03                ;char count for mnemonic print
00688  00E2E5  86 E5                             STX     PRFLAG              ;So EXPMNE prints the mnemonic
00689  00E2E7  C0 04                             CPY     #$04
00690  00E2E9  90 F0                             BCC     .PROPBL
00691  00E2EB  68                                PLA                         ;Recover mnemonic index
00692  00E2EC  AA                                TAX
00693  00E2ED  20 2B E4                          JSR     EXPMNE              ;Expand the Memonic
00694  00E2F0  20 A7 FB                          JSR     WRBLNK              ;Output 3 blanks
00695                      
00696  00E2F3  A4 DD                             LDY     LENG                ; Load the instruction length
00697  00E2F5  A2 06                             LDX     #$06                ; We will check up to 6 formatting bits (from SAVE_Y)
00698  00E2F7  E0 03         .PPADR1             CPX     #$03        
00699  00E2F9  D0 09                             BNE     .PPADR2             ; When X is not 3, proceed to formatting chars
00700                      
00701                      ; --- NEW LABEL INTERCEPTOR ---
00702  00E2FB  20 1C E3                          JSR     PRINT_OP_OR_LABEL   ; Print the Label (if found) or raw Hex Operand
00703  00E2FE  A5 DC                             LDA     SAVE_Y              
00704  00E300  C9 E8                             CMP     #$E8                ; Was it a Relative Branch?
00705  00E302  B0 15                             BCS     .EXIT_DSP           ; If so, exit immediately (mimics original 6502 formatting behavior)
00706                      
00707  00E304  06 DC         .PPADR2             ASL     SAVE_Y              ; Shift the format byte left
00708  00E306  90 0E                             BCC     .PPADR3             ; If Carry is clear, don't print a character here
00709  00E308  BD 8E F8                          LDA     CHAR1-1,X           ; Fetch the corresponding formatting character (e.g., '(' or '#')
00710  00E30B  20 98 FB                          JSR     WRCHAR              ; Print the formatting character
00711  00E30E  BD 88 F8                          LDA     CHAR2-1,X           ; Check if there is a second formatting character (e.g., 'X' or 'Y')
00712  00E311  F0 03                             BEQ     .PPADR3             ; If it's $00, skip it
00713  00E313  20 98 FB                          JSR     WRCHAR              ; Print the second formatting character
00714  00E316  CA            .PPADR3             DEX                         ; Decrement format bit counter
00715  00E317  D0 DE                             BNE     .PPADR1             ; Loop until all format bits are processed
00716  00E319  86 E5         .EXIT_DSP           STX     PRFLAG              ; Reset print flag to 0
00717  00E31B  60                                RTS                         ; Return (Instruction fully printed!)
00718  
00719  ; =======================================================================
00720  ; PRINT OPERAND OR LABEL
00721  ; Calculates the 16-bit target address, searches the Symbol Table, and 
00722  ; prints the Label if found. Otherwise, falls back to raw Hex bytes.
00723  ; =======================================================================
00724  00E31C  DA            PRINT_OP_OR_LABEL   PHX                         ; Preserve format counter (X=3)
00725                      
00726  00E31D  A4 DD                             LDY     LENG
00727  00E31F  F0 36                             BEQ     .EXIT_NO_OP         ; BUG FIX: 1-byte instructions have no operand! Bail out immediately.
00728                      
00729  00E321  A5 DC                             LDA     SAVE_Y
00730  00E323  C9 21                             CMP     #$21                ; Is it Immediate mode? (#$xx)
00731  00E325  F0 32                             BEQ     .PRINT_HEX          ; Do not substitute labels for immediate values!
00732                      
00733  00E327  C9 E8                             CMP     #$E8                ; Is it Relative mode? (BNE, BEQ, BRA)
00734  00E329  B0 14                             BCS     .CALC_REL
00735                      
00736                      ; --- Extract Normal Address (Absolute / Zero Page) ---
00737  00E32B  A0 01                             LDY     #$01
00738  00E32D  B1 DF                             LDA     (SRCE),Y            ; Get Low byte
00739  00E32F  85 D2                             STA     HEXVAL              ; Use HEXVAL as safe temporary storage
00740  00E331  64 D3                             STZ     HEXVAL+1            ; Default High byte to 00 (Zero Page)
00741                      
00742  00E333  A4 DD                             LDY     LENG
00743  00E335  C0 02                             CPY     #$02                ; Is it a 2-byte operand? (Absolute)
00744  00E337  D0 16                             BNE     .LOOKUP
00745  00E339  B1 DF                             LDA     (SRCE),Y            ; Get High byte
00746  00E33B  85 D3                             STA     HEXVAL+1
00747  00E33D  80 10                             BRA     .LOOKUP
00748  
00749  .CALC_REL           ; --- Calculate Relative Address ---
00750  00E33F  A4 DD                             LDY     LENG                ; Fetch relative offset byte
00751  00E341  B1 DF                             LDA     (SRCE),Y
00752  00E343  20 1F E4                          JSR     PCADJ3              ; A = Low, Y = High (Uses existing PC Math)
00753  00E346  AA                                TAX                         ; Move Low to X
00754  00E347  E8                                INX                         ; Adjust +1 for exact branch target
00755  00E348  D0 01                             BNE     .REL_NO_CARRY
00756  00E34A  C8                                INY                         ; Handle page cross
00757  00E34B  86 D2         .REL_NO_CARRY       STX     HEXVAL              ; Save Target Low
00758  00E34D  84 D3                             STY     HEXVAL+1            ; Save Target High
00759  
00760  .LOOKUP             ; --- Search Symbol Table ---
00761  00E34F  20 77 E3                          JSR     SEARCH_SYMBOL_TABLE
00762  00E352  B0 05                             BCS     .PRINT_HEX          ; Carry Set = Not Found in Symbol Table
00763  
00764                      ; --- Found! Print Label String ---
00765  00E354  20 D9 E3                          JSR     PRINT_LABEL_STRING
00766  00E357  FA            .EXIT_NO_OP         PLX                         ; Restore format counter
00767  00E358  60                                RTS                         ; Return to INSTDSP
00768  
00769  .PRINT_HEX          ; --- Fallback: Print Raw Hex ---
00770  00E359  A5 DC                             LDA     SAVE_Y
00771  00E35B  C9 E8                             CMP     #$E8                ; Was it Relative?
00772  00E35D  B0 0C                             BCS     .HEX_REL
00773                      
00774                      ; Normal Hex Print (High byte then Low byte)
00775  00E35F  A4 DD                             LDY     LENG
00776  00E361  B1 DF         .HEX_LOOP           LDA     (SRCE),Y
00777  00E363  20 C1 FB                          JSR     WR2HEX
00778  00E366  88                                DEY
00779  00E367  D0 F8                             BNE     .HEX_LOOP           ; Safe loop: LENG is guaranteed > 0 by the BEQ at the top
00780  00E369  FA                                PLX                         ; Restore format counter
00781  00E36A  60                                RTS
00782                      
00783  .HEX_REL            ; Print Relative Hex Target (High then Low)
00784  00E36B  A5 D3                             LDA     HEXVAL+1
00785  00E36D  20 C1 FB                          JSR     WR2HEX
00786  00E370  A5 D2                             LDA     HEXVAL
00787  00E372  20 C1 FB                          JSR     WR2HEX
00788  00E375  FA                                PLX                         ; Restore format counter
00789  00E376  60                                RTS
00790  
00791  ; =======================================================================
00792  ; SEARCH_SYMBOL_TABLE
00793  ; Scans SYM_TABLE for an address matching HEXVAL (Reverse Lookup).
00794  ; Dynamically tracks Global Label base addresses to resolve Local Label
00795  ; offsets. Record length is determined by scanning for the $FF terminator.
00796  ; Returns: Carry CLEAR if found (DEST points to symbol), Carry SET if not.
00797  ; =======================================================================
00798  00E377  A5 EE         SEARCH_SYMBOL_TABLE LDA     SYM_TABLE
00799  00E379  85 E1                             STA     DEST
00800  00E37B  A5 EF                             LDA     SYM_TABLE+1
00801  00E37D  85 E2                             STA     DEST+1
00802  00E37F  05 EE                             ORA     SYM_TABLE           ; If table pointer is 0000, no symbols exist
00803  00E381  F0 54                             BEQ     .NOT_FOUND
00804  00E383  64 E8                             STZ     TEMP2               ; Init running Global Base Low
00805  00E385  64 E9                             STZ     TEMP2+1             ; Init running Global Base High
00806  
00807  00E387  A0 00         .NEXT_SYM           LDY     #$00
00808  00E389  B1 E1                             LDA     (DEST),Y            
00809  00E38B  F0 4A                             BEQ     .NOT_FOUND          ; $00 marker = End of symbol table!
00810  
00811                      ; --- Find record length by scanning for $FF ---
00812  00E38D  B1 E1         .FIND_LEN           LDA     (DEST),Y
00813  00E38F  C8                                INY
00814  00E390  C9 FF                             CMP     #$FF
00815  00E392  D0 F9                             BNE     .FIND_LEN
00816                      
00817  00E394  98                                TYA                         ; Save record length in X
00818  00E395  AA                                TAX                         
00819                      
00820  00E396  E0 05                             CPX     #$05                ; Is length < 5? 
00821  00E398  90 1C                             BCC     .CHK_LOCAL          ; If yes, it's a 3-byte Local Label!
00822  
00823  .CHK_GLOBAL         ; --- Process Global Label ---
00824  00E39A  A0 01                             LDY     #$01
00825  00E39C  B1 E1                             LDA     (DEST),Y            ; Fetch Global Address Low
00826  00E39E  85 E8                             STA     TEMP2               ; Update running Global Base Low
00827  00E3A0  C5 D2                             CMP     HEXVAL
00828  00E3A2  D0 0B                             BNE     .UP_GLOB_HI
00829                      
00830  00E3A4  C8                                INY
00831  00E3A5  B1 E1                             LDA     (DEST),Y            ; Fetch Global Address High
00832  00E3A7  85 E9                             STA     TEMP2+1             ; Update running Global Base High
00833  00E3A9  C5 D3                             CMP     HEXVAL+1
00834  00E3AB  F0 28                             BEQ     .FOUND              ; Exact 16-bit Match!
00835  00E3AD  80 1A                             BRA     .ADVANCE
00836  
00837  00E3AF  C8            .UP_GLOB_HI         INY                         ; We must keep the High byte updated 
00838  00E3B0  B1 E1                             LDA     (DEST),Y            ; for subsequent local label calculations
00839  00E3B2  85 E9                             STA     TEMP2+1
00840  00E3B4  80 13                             BRA     .ADVANCE
00841  
00842  .CHK_LOCAL          ; --- Process Local Label ---
00843  00E3B6  A0 01                             LDY     #$01
00844  00E3B8  B1 E1                             LDA     (DEST),Y            ; Fetch Local Offset byte
00845  00E3BA  18                                CLC
00846  00E3BB  65 E8                             ADC     TEMP2               ; Add to Global Base Low
00847  00E3BD  C5 D2                             CMP     HEXVAL
00848  00E3BF  D0 08                             BNE     .ADVANCE
00849                      
00850  00E3C1  A5 E9                             LDA     TEMP2+1             
00851  00E3C3  69 00                             ADC     #$00                ; Add Carry to Global Base High
00852  00E3C5  C5 D3                             CMP     HEXVAL+1
00853  00E3C7  F0 0C                             BEQ     .FOUND              ; Exact 16-bit Match!
00854  
00855  .ADVANCE            ; --- Move DEST to the next record ---
00856  00E3C9  8A                                TXA                         ; Restore record length from X
00857  00E3CA  18                                CLC
00858  00E3CB  65 E1                             ADC     DEST
00859  00E3CD  85 E1                             STA     DEST
00860  00E3CF  90 B6                             BCC     .NEXT_SYM
00861  00E3D1  E6 E2                             INC     DEST+1
00862  00E3D3  80 B2                             BRA     .NEXT_SYM
00863  
00864  00E3D5  18            .FOUND              CLC                         ; Success
00865  00E3D6  60                                RTS
00866  00E3D7  38            .NOT_FOUND          SEC                         ; Failure
00867  00E3D8  60                                RTS
00868  
00869  ; =======================================================================
00870  ; PRINT_LABEL_STRING
00871  ; Prints the label name. If Global, fetches the source code text pointer.
00872  ; If Local, manually formats and prints the '.' prefix and binary ID.
00873  ; =======================================================================
00874  00E3D9  E0 05         PRINT_LABEL_STRING  CPX     #$05                ; X holds the record length from the search loop
00875  00E3DB  90 26                             BCC     .PRT_LOCAL          ; If < 5, it is a Local Label
00876  
00877  00E3DD  A0 03         .PRT_GLOBAL         LDY     #$03
00878  00E3DF  B1 E1                             LDA     (DEST),Y            ; Fetch Source Code Pointer Low
00879  00E3E1  85 E7                             STA     TEMP1           
00880  00E3E3  C8                                INY
00881  00E3E4  B1 E1                             LDA     (DEST),Y            ; Fetch Source Code Pointer High
00882  00E3E6  85 E8                             STA     TEMP1+1
00883                      
00884  00E3E8  A0 03                             LDY     #$03                ; Offset 3: Skips Length and Line Number bytes in Source
00885  00E3EA  B1 E7         .PRT_LOOP           LDA     (TEMP1),Y
00886  00E3EC  30 14                             BMI     .DONE               ; B7 Set = Packed Token (End of label)
00887  00E3EE  C9 3A                             CMP     #':'            
00888  00E3F0  F0 10                             BEQ     .DONE               ; Colon = End of label
00889  00E3F2  C9 20                             CMP     #SP
00890  00E3F4  F0 0C                             BEQ     .DONE               ; Space = End of label
00891  00E3F6  C9 0D                             CMP     #CR
00892  00E3F8  F0 08                             BEQ     .DONE               ; CR = End of line
00893                      
00894  00E3FA  29 7F                             AND     #$7F                ; Ensure character is clean ASCII
00895  00E3FC  20 98 FB                          JSR     WRCHAR              ; Print the character to terminal
00896  00E3FF  C8                                INY
00897  00E400  80 E8                             BRA     .PRT_LOOP
00898  00E402  60            .DONE               RTS
00899  
00900  00E403  A9 2E         .PRT_LOCAL          LDA     #'.'                ; Local labels start with a dot
00901  00E405  20 98 FB                          JSR     WRCHAR
00902  00E408  A0 00                             LDY     #$00
00903  00E40A  B1 E1                             LDA     (DEST),Y            ; Fetch the local label ID (e.g., binary 1 or 2)
00904  00E40C  29 7F                             AND     #$7F                ; Mask out declared flags just in case
00905  00E40E  A8                                TAY                         ; Move to Y (LSB parameter for WRDECI)
00906  00E40F  A9 00                             LDA     #$00                ; Move 0 to A (MSB parameter for WRDECI)
00907  00E411  20 11 EA                          JSR     WRDECI              ; Print the ID as a decimal number
00908  00E414  60                                RTS
