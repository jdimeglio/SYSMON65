02059  ;------------------------------------------------------------------------
02060  ; Erase command - erase  line from editer
02061  ;------------------------------------------------------------------------
02062  
02063  00EB3B  20 C4 EB      CMD_ERASE           JSR     BEG_END             ;Get begin and end line parameters
02064  00EB3E  B0 41                             BCS     DELETE              ;Parameters given! Do delete
02065  
02066  00EB40  A9 26         ERROR_MISSING       LDA     #ERR_MIS            ;Exit with missing parameter
02067  00EB42  85 C9                             STA     ERROR
02068  00EB44  60            ERASE_RTS           RTS
02069  
02070  
02071  ;------------------------------------------------------------------------
02072  ;Fill F start range value
02073  ;------------------------------------------------------------------------ 
02074  00EB45  20 42 E8      CMD_FILL            JSR     GET_VAL         ;Fill Memory Command 
02075                      ;BCS    ERROR_MISSING
02076  00EB48  84 F6         .OK                 STY     HIMEM           ;Get start address
02077  00EB4A  85 F7                             STA     HIMEM+1  
02078  00EB4C  E8                                INX
02079  00EB4D  20 42 E8                          JSR     GET_VAL             ;Get RANGE 
02080  00EB50  84 DD                             STY     LENG
02081  00EB52  85 DE                             STA     LENG+1
02082  00EB54  E8                                INX
02083  00EB55  20 42 E8                          JSR     GET_VAL             ;FILL value
02084  00EB58  98                                TYA 
02085  00EB59  A6 DE         .USERFILL           LDX     LENG+1      
02086  00EB5B  F0 0F                             BEQ     .FILEFT     
02087  00EB5D  A0 00                             LDY     #$00        
02088  00EB5F  20 3D E8      .PGFILL             JSR     PROBE
02089  00EB62  D0 18                             BNE     .WRERROR    
02090  00EB64  C8                                INY                 
02091  00EB65  D0 F8                             BNE     .PGFILL     
02092  00EB67  E6 F7                             INC     HIMEM+1   
02093  00EB69  CA                                DEX           
02094  00EB6A  D0 F3                             BNE     .PGFILL   
02095  00EB6C  A6 DD         .FILEFT             LDX     LENG    
02096  00EB6E  F0 0B                             BEQ     .DONEFILL 
02097  00EB70  A0 00                             LDY     #$00     
02098  00EB72  20 3D E8      .FILAST             JSR     PROBE
02099  00EB75  D0 05                             BNE     .WRERROR
02100  00EB77  C8                                INY           
02101  00EB78  CA                                DEX           
02102  00EB79  D0 F7                             BNE     .FILAST   
02103  00EB7B  60            .DONEFILL           RTS             
02104  00EB7C  A9 A9         .WRERROR            LDA     #ERR_WRT                    
02105  00EB7E  85 C9                             STA     ERROR           
02106  00EB80  60                                RTS                 
02107  
02108  
02109  ;------------------------------------------------------------------------
02110  ; Delete block of lines from the source code
02111  ;------------------------------------------------------------------------
02112  00EB81  A5 CD         DELETE              LDA     PARM2               ;Don't delete anything if
02113  00EB83  C5 CB                             CMP     PARM1               ; begin > end
02114  00EB85  A5 CE                             LDA     PARM2+1
02115  00EB87  E5 CC                             SBC     PARM1+1
02116  00EB89  90 B9                             BCC     ERASE_RTS           ;Begin is indeed > end!
02117  00EB8B  A0 CB                             LDY     #PARM1              ;Find this line number
02118  00EB8D  20 67 F0                          JSR     FIND_LINE
02119  00EB90  90 B2                             BCC     ERASE_RTS           ;EOF reached! Line not found
02120  00EB92  A5 B6                             LDA     PNTR                ;Current pointer is going to be
02121  00EB94  85 E1                             STA     DEST                ; the move's destination anyway
02122  00EB96  A5 B7                             LDA     PNTR+1
02123  00EB98  85 E2                             STA     DEST+1
02124  00EB9A  A0 01         .LOOP               LDY     #1                  ;See if we're already past end
02125  00EB9C  A5 CD                             LDA     PARM2
02126  00EB9E  D1 B6                             CMP     (PNTR),Y
02127  00EBA0  C8                                INY
02128  00EBA1  A5 CE                             LDA     PARM2+1
02129  00EBA3  F1 B6                             SBC     (PNTR),Y
02130  00EBA5  90 05                             BCC     .FOUNDEND           ;Yes!
02131  00EBA7  20 92 F0                          JSR     NEXT_LINE           ;Find next line
02132  00EBAA  D0 EE                             BNE     .LOOP               ;Do until end line found!
02133  00EBAC  A5 B6         .FOUNDEND           LDA     PNTR                ;This pointer is going to be
02134  00EBAE  85 DF                             STA     SRCE                ; the source
02135  00EBB0  45 E1                             EOR     DEST                ;And see if source and dest are
02136  00EBB2  85 D0                             STA     COUNT               ; the same
02137  00EBB4  A5 B7                             LDA     PNTR+1
02138  00EBB6  85 E0                             STA     SRCE+1
02139  00EBB8  45 E2                             EOR     DEST+1
02140  00EBBA  05 D0                             ORA     COUNT
02141  00EBBC  F0 86                             BEQ     ERASE_RTS           ;They are the same! Why bother
02142  00EBBE  20 34 F0                          JSR     CALC_LENG           ;Calculate number of bytes to move
02143  00EBC1  4C A1 E6                          JMP     MOV_DOWN            ;Move from next line to end down
02144  
02145  
02146  ;------------------------------------------------------------------------
02147  ; Get begin and end line number from user
02148  ;------------------------------------------------------------------------
02149  00EBC4  84 CA         BEG_END             STY     DUMP                ;Disable dump mode
02150  00EBC6  84 CB                             STY     PARM1               ;Set default begin and end lines
02151  00EBC8  84 CC                             STY     PARM1+1             ; Y=0
02152  00EBCA  88                                DEY
02153  00EBCB  84 CD                             STY     PARM2
02154  00EBCD  84 CE                             STY     PARM2+1
02155  00EBCF  20 0A E8                          JSR     NNONSPC             ;Are there any parameters?
02156  00EBD2  F0 2E                             BEQ     .NOPARM             ;No parameters given!
02157  00EBD4  C9 44                             CMP     #'D'                ;Dump mode?
02158  00EBD6  F0 28                             BEQ     .DUMP               ;Yes!       
02159  00EBD8  C9 2C                             CMP     #','                ;Is begin line given?
02160  00EBDA  F0 17                             BEQ     .ENDLIN             ;Nope!
02161  00EBDC  20 42 E8                          JSR     GET_VAL             ;Get begin line number
02162  00EBDF  D0 1C                             BNE     .ERRORLB            ;An error occurred
02163  00EBE1  84 CB                             STY     PARM1               ;Save begin line number
02164  00EBE3  85 CC                             STA     PARM1+1 
02165  00EBE5  B5 19                             LDA     IN,X                ;Does the end line number follow?
02166  00EBE7  C9 2C                             CMP     #','
02167  00EBE9  F0 08                             BEQ     .ENDLIN             ;Yes! Get it
02168  00EBEB  A5 D3                             LDA     HEXVAL+1            ;If not make begin = end
02169  00EBED  85 CE         .SAVE_DONE          STA     PARM2+1
02170  00EBEF  84 CD                             STY     PARM2
02171  00EBF1  38            .DONE               SEC                         ;Indicate parameter given
02172  00EBF2  60                                RTS
02173  
02174  00EBF3  20 0D EF      .ENDLIN             JSR     IN_BLANK            ;Get next and see if it's blank
02175  00EBF6  F0 F9                             BEQ     .DONE               ;EOL! No line number
02176  00EBF8  20 42 E8                          JSR     GET_VAL
02177  00EBFB  F0 F0                             BEQ     .SAVE_DONE          ;No error occurred
02178  00EBFD  68            .ERRORLB            PLA                         ;An error occurred, pop return
02179  00EBFE  68                                PLA                         ; address from stack
02180  00EBFF  60                                RTS
02181  
02182  00EC00  85 CA         .DUMP               STA     DUMP                ;Activate dump mode and CY=0
02183  00EC02  18            .NOPARM             CLC                         ;Indicate no parameters are given
02184  00EC03  60                                RTS                         ; (DEL requires them!)
02185  
02186  
02187  ;------------------------------------------------------------------------
02188  ; LIST command
02189  ;------------------------------------------------------------------------
02190  00EC04  20 C4 EB      CMD_LST             JSR     BEG_END             ;Command List 
02191                                                  ;Get begin and end line parameters
02192  00EC07  A0 CB                             LDY     #PARM1              ;Find first line
02193  00EC09  20 67 F0                          JSR     FIND_LINE
02194  00EC0C  20 E4 FB      .LOOP               JSR     SCAN_ESC            ;SCAN_ESC if key pressed
02195  00EC0F  F0 3E                             BEQ     DORTS               ;ESC pressed!
02196  00EC11  A0 00                             LDY     #0                  ;Check EOF
02197  00EC13  B1 B6                             LDA     (PNTR),Y
02198  00EC15  F0 38                             BEQ     DORTS               ;Yes!
02199  00EC17  C8                                INY                         ;See if we're past end line
02200  00EC18  38                                SEC
02201  00EC19  B1 B6                             LDA     (PNTR),Y
02202  00EC1B  85 D2                             STA     HEXVAL
02203  00EC1D  E5 CD                             SBC     PARM2
02204  00EC1F  85 D1                             STA     DELIM               ;Used to see if equal
02205  00EC21  C8                                INY
02206  00EC22  B1 B6                             LDA     (PNTR),Y
02207  00EC24  85 D3                             STA     HEXVAL+1
02208  00EC26  E5 CE                             SBC     PARM2+1
02209  00EC28  05 D1                             ORA     DELIM
02210  00EC2A  F0 02                             BEQ     .EQUAL              ;Hey, last line to list!
02211  00EC2C  B0 21                             BCS     DORTS               ;We're done!
02212  
02213  00EC2E  A5 CA         .EQUAL              LDA     DUMP                ;Dump mode?
02214  00EC30  D0 06                             BNE     .SKIP               ;Yes! Skip line number printing
02215  00EC32  20 0D EA                          JSR     PRDECI_HEXVAL
02216  00EC35  20 8D FB                          JSR     WRSPACE
02217  
02218  00EC38  20 A2 F0      .SKIP               JSR     UNPACK_IN           ;Unpack current line into keyboard buffer
02219  00EC3B  A2 00                             LDX     #0                  ;Print the entire unpacked line
02220  00EC3D  B5 19         .PRINT              LDA     IN,X
02221  00EC3F  E8                                INX
02222  00EC40  20 98 FB                          JSR     WRCHAR
02223  00EC43  C9 0D                             CMP     #CR                 ;End of line?
02224  00EC45  D0 F6                             BNE     .PRINT              ;Not yet!
02225  00EC47  20 96 FB                          JSR     WRLF                ;New line on screen 
02226  00EC4A  20 92 F0                          JSR     NEXT_LINE           ;Set pointer to next line
02227  00EC4D  D0 BD                             BNE     .LOOP               ;Repeat if not EOF!
02228  00EC4F  60            DORTS               RTS
02229  
02230  
02231  ;------------------------------------------------------------------------
02232  ; Code Clean UP command  (bug - label, then space 
02233  ;------------------------------------------------------------------------
02234  00EC50  20 C4 EB      CMD_CLEAN_CODE      JSR     BEG_END             ;Code clean Up Command       
02235  00EC53  A0 CB                             LDY     #PARM1              ;Find first line
02236  00EC55  20 67 F0                          JSR     FIND_LINE
02237  00EC58  20 E4 FB      .LOOP               JSR     SCAN_ESC                ;SCAN_ESC if key pressed
02238  00EC5B  F0 F2                             BEQ     DORTS               ;ESC pressed!
02239  00EC5D  A0 00                             LDY     #0                  ;Check EOF
02240  00EC5F  B1 B6                             LDA     (PNTR),Y
02241  00EC61  F0 EC                             BEQ     DORTS               ;Yes!
02242  00EC63  C8                                INY                         ;See if we're past end line
02243  00EC64  38                                SEC
02244  00EC65  B1 B6                             LDA     (PNTR),Y
02245  00EC67  85 D2                             STA     HEXVAL
02246  00EC69  E5 CD                             SBC     PARM2
02247  00EC6B  85 D1                             STA     DELIM               ;Used to see if equal
02248  00EC6D  C8                                INY
02249  00EC6E  B1 B6                             LDA     (PNTR),Y
02250  00EC70  85 D3                             STA     HEXVAL+1
02251  00EC72  E5 CE                             SBC     PARM2+1
02252  00EC74  05 D1                             ORA     DELIM
02253  00EC76  F0 02                             BEQ     .SCAN_LINE          ;Hey, last line to list!
02254  00EC78  B0 D5                             BCS     DORTS               ;We're done!
02255  00EC7A  A0 00         .SCAN_LINE          LDY     #0                  ;Get line length
02256  00EC7C  B1 B6                             LDA     (PNTR),Y
02257  00EC7E  38                                SEC
02258  00EC7F  E9 03                             SBC     #3                  ;Subtract length and line-num
02259  00EC81  85 D0                             STA     COUNT
02260                      
02261  00EC83  A0 03                             LDY     #3                  ;This is where the fun is
02262  00EC85  B1 B6         .LOOP_LINE          LDA     (PNTR),Y            ;Get byte from source
02263  00EC87  30 0B                             BMI     .UNPACK             ;It's a packed byte! was bpl
02264                      
02265  00EC89  C8            .SPACENFOUND        INY                         ;Point to next source byte
02266  00EC8A  C6 D0                             DEC     COUNT               ;Decrement length counter            
02267  00EC8C  D0 F7                             BNE     .LOOP_LINE          ;Not done yet!
02268              
02269  00EC8E  20 92 F0                          JSR     NEXT_LINE
02270  00EC91  D0 C5                             BNE     .LOOP
02271  00EC93  60                                RTS
02272      
02273  00EC94  29 E0         .UNPACK             AND     #%11100000          ;mask flags
02274  00EC96  C9 E0                             CMP     #%11100000
02275  00EC98  D0 EF                             BNE     .SPACENFOUND
02276  00EC9A  A9 E5                             LDA     #%11100101          ;#BUG - probably should compare if larger than 4 
02277  00EC9C  91 B6                             STA     (PNTR),Y 
02278  00EC9E  80 E9                             BRA     .SPACENFOUND
02279  
02280  
02281  ;------------------------------------------------------------------------
02282  ; MEMORY command
02283  ; Warning! Range is not checked! It's your own responsibility to set the
02284  ; range. Illegal ranges are belowe $0200, above RAM, inside own source,
02285  ; lomem => himem.
02286  ;------------------------------------------------------------------------
02287  00ECA0  F0 26         CMD_MEM             BEQ     SHOWMEM             ;Yes! Set Lomem,Himem
02288  00ECA2  B5 19                             LDA     IN,X                ;Is lomem given?
02289  00ECA4  C9 2C                             CMP     #','
02290  00ECA6  F0 0F                             BEQ     .HIMEM              ;Nope!
02291      
02292  00ECA8  20 42 E8                          JSR     GET_VAL             ;Get lomem value
02293  00ECAB  D0 A2                             BNE     DORTS               ;An error occurred!
02294  00ECAD  84 F4                             STY     LOMEM               ;Copy new lomem value
02295  00ECAF  85 F5                             STA     LOMEM+1
02296      
02297  00ECB1  B5 19                             LDA     IN,X                ;Is highmem given? (soft)
02298  00ECB3  C9 2C                             CMP     #','
02299  00ECB5  D0 0A                             BNE     .DONE               ;Nope! Leave it
02300  
02301  00ECB7  E8            .HIMEM              INX
02302  00ECB8  20 42 E8                          JSR     GET_VAL             ;Get himem value
02303  00ECBB  D0 92                             BNE     DORTS               ;An error occurred!
02304  00ECBD  84 F6                             STY     HIMEM               ;Copy new himem value
02305  00ECBF  85 F7                             STA     HIMEM+1
02306  
02307  00ECC1  A0 00         .DONE               LDY     #0                  ;Perform a new command
02308  00ECC3  84 E9                             STY     OLD_SAVE            ;However OLD will not work now
02309  00ECC5  20 B0 ED                          JSR     DONEW               ;Clear source program
02310  
02311  00ECC8  20 ED FA      SHOWMEM             JSR STRING
02312              .db $e1,$a5,$e1,$a2,$e1,$a2,$e1,$a5,$e1,$a5,$e1,$a5,$e1,$a5,$e1,$a3
02313              .db $e1,$a3,$e1,$0d,$0a,$7c,$e3,$a2,$7c,$e2,$7c,$e2,$7c,$e3,$a2,$7c
02314              .db $e5,$7c,$e5,$7c,$e3,$7c,$e1,$7c,$e2,$a1,$7c,$e2,$a1,$7c,$e1,$4c
02315              .db $4f,$57,$45,$52,$e1,$6c,$69,$6d,$69,$74,$3a,$e1,$00
02316  00ED08  A5 F5                             LDA     LOMEM+1             ;Print lomem
02317  00ED0A  A4 F4                             LDY     LOMEM
02318  00ED0C  20 D7 FB                          JSR     WRWORD              
02319  00ED0F  20 ED FA                          JSR     STRING
02320              
02321                      .DB CR,LF
02322              .DB $7c,$a2,$e3,$7c,$a1,$e3,$a1,$7c,$a2,$e3,$7c,$e1,$7c,$e1,$7c,$e1
02323              .DB $7c,$e2,$7c,$e2,$7c,$e1,$7c,$e1,$7c,$e1,$7c,$e1,$2e,$e1,$7c,$a1
02324              .DB $e2,$7c,$e1,$54,$4f,$54,$41,$4c,$e1,$52,$41,$4d,$3a,$e3,$00
02325                      
02326              
02327  00ED43  A5 F7                             LDA     HIMEM+1             ;And himem
02328  00ED45  A4 F6                             LDY     HIMEM
02329  00ED47  20 D7 FB                          JSR     WRWORD
02330  00ED4A  20 ED FA                          JSR     STRING
02331                  
02332                  .DB LF,CR
02333              .DB $7c,$a5,$7c,$e1,$7c,$a1,$7c,$e1,$7c,$a5,$7c,$a1,$7c,$a1,$7c,$a1
02334              .DB $7c,$a5,$7c,$a1,$7c,$a3,$7c,$a3,$7c,$a3,$7c,$e1,$55,$50,$50,$45
02335              .DB $52,$e1,$73,$70,$65,$6e,$74,$3a,$e1,$00
02336                  
02337      
02338  00ED79  20 54 F0                          JSR     FIND_EOFZ           ;Find end of source file
02339  00ED7C  A4 B6                             LDY     PNTR
02340  00ED7E  A5 B7                             LDA     PNTR+1                
02341  00ED80  20 D7 FB                          JSR     WRWORD
02342  00ED83  20 ED FA                          JSR     STRING
02343                      
02344              .ASCII  LF,CR 
02345              .ASCII "All rights reserved v2.10",CR,LF,EOS
02346  
02347  .PRWORDCR           ;JSR     WRWORD
02348  00EDA4  60                                RTS
