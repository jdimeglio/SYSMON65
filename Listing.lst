00096  ;------------------------------------------------------------------------
00097  ; Constants
00098  ;------------------------------------------------------------------------
00099    0004              DEF_LOMEM       =       $04                 ;Default lomem page
00100    03E8              DEF_AUTO        =       1000                ;Default Auto line number start
00101    000A              DEF_INC         =       10                  ;Default Auto increment step
00102    1000              DEF_ORG         =       $1000               ;Default Orgin location
00103    0200              DEF_OBJLOW      =       $0200               ;Default lowest object address
