02775  ;------------------------------------------------------------------------
02776  ; Calculate the length of the memory block to be moved
02777  ;------------------------------------------------------------------------
02778  00F034  20 57 F0      CALC_LENG           JSR     FIND_EOF            ;Find end of source
02779  00F037  38                                SEC                         ;Calculate number of bytes to
02780  00F038  A5 B6                             LDA     PNTR                ; be moved
02781  00F03A  E5 DF                             SBC     SRCE
02782  00F03C  85 DD                             STA     LENG
02783  00F03E  A5 B7                             LDA     PNTR+1
02784  00F040  E5 E0                             SBC     SRCE+1
02785  00F042  85 DE                             STA     LENG+1
