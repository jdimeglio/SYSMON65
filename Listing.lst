01947  ;                   BNE     .RTS                ;No carry to high byte!
01948                      ;INC                        ;?????????????? 
01949  ;.RTS                STA     HEXVAL+1
01950  ;                    RTS
01951  00EA8A  38            NEGATE          	SEC
01952  00EA8B  A9 00                         	LDA     #0
01953  00EA8D  E5 D2                         	SBC     HEXVAL
01954  00EA8F  85 D2                         	STA     HEXVAL
01955  00EA91  A9 00                         	LDA     #0
01956  00EA93  E5 D3                         	SBC     HEXVAL+1
01957  00EA95  85 D3                         	STA     HEXVAL+1
