01897  ;------------------------------------------------------------------------
01898  ; Check object if code was generated
01899  ;------------------------------------------------------------------------
01900  ;CHECK_OBJ           CLC
01901  ;                    LDA     TA                  ;See if code was generated
01902  ;                    EOR     TA_BEGIN
01903  ;                    BEQ     .NOK            ;no code        
01904  ;                    BRA     .CODE
01905  ;.NOK                LDA     TA+1            ;what about high byte   
01906  ;                    EOR     TA_BEGIN+1
01907  ;                    BEQ     .CHECK_OBJ_RTS      ; No code!                           
01908  ;.CODE               SEC         
01909  ;.CHECK_OBJ_RTS      RTS
01910  
01911  
01912  ;------------------------------------------------------------------------
01913  ; Print object range
01914  ;------------------------------------------------------------------------
01915  00EA5E  A5 BB         PRINT_OBJ           LDA     TA                  ;See if code was generated
01916  00EA60  45 BD                             EOR     TA_BEGIN
01917  00EA62  D0 06                             BNE     .OK         ;no code 
01918  00EA64  A5 BC                             LDA     TA+1
01919  00EA66  45 BE                             EOR     TA_BEGIN+1
01920  00EA68  F0 1F                             BEQ     .PRINT_OBJ_RTS      ;No code!
01921  00EA6A  A9 2B         .OK                 LDA     #CODE_ORG
01922  00EA6C  20 EC E6                          JSR     PRINT_MSGS
01923  00EA6F  A4 BD                             LDY     TA_BEGIN            ;First print begin address
01924  00EA71  A5 BE                             LDA     TA_BEGIN+1
01925  00EA73  20 D7 FB                          JSR     WRWORD 
01926  00EA76  20 81 FB                          JSR     WRDOT
01927  00EA79  38                                SEC                         ;Then print end address
01928  00EA7A  A5 BC                             LDA     TA+1                ; (but this time one less)
01929  00EA7C  A4 BB                             LDY     TA
01930  00EA7E  D0 02                             BNE     .NOBOR              ;No borrow from high byte
01931  00EA80  E9 01                             SBC     #1
01932  00EA82  88            .NOBOR              DEY                         ;Decrement low byte
01933  00EA83  20 D7 FB                          JSR     WRWORD 
01934  00EA86  4C 91 FB                          JMP     WRCRLF              ;Followed by CR
01935  00EA89  60            .PRINT_OBJ_RTS      RTS
