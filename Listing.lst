01105  ;------------------------------------------------------------------------
01106  ;Memory DUMP one line
01107  ;------------------------------------------------------------------------ 
01108  00E525  20 49 E9      CMD_MEMORY_DUMP     JSR     GET_EXPRES          ;DUMPS MEMORY TO THE SCREEN
01109  00E528  D0 04                             BNE     .CONT
01110  00E52A  84 DF                             STY     SRCE
01111  00E52C  85 E0                             STA     SRCE+1                                                  
01112  00E52E  20 61 FB      .CONT               JSR     CLS                 ;Cursor top left
01113             ;         JSR     STRING
01114             ;             
01115             ;     .ASCII "   _____ _____ _____",CR,LF
01116             ;     .ASCII "  |     |   __|     |",CR,LF
01117             ;     .ASCII "  | | | |   __| | | |",CR,LF
01118             ;     .ASCII "  |_|_|_|_____|_|_|_|",CR,LF, EOS
01119                  
01120  00E531  20 83 E6                          JSR     DMPGR               ;draw the 00 01 02 03 etc etc
01121  00E534  20 AD FB                          JSR     DRAWLINECR          ;draw line
01122              
01123  00E537  A0 10         DRAWMEM_DRAW        LDY     #$10                ;lines to draw = 1 page of memory       
01124  00E539  A2 04                             LDX     #04                 ;divided by 4
01125  00E53B  5A            .NEWLINE            PHY
01126  00E53C  20 07 E5                          JSR     DISPLAY_ADDR        
01127  00E53F  A0 00                             LDY     #$00            
01128  00E541  B1 DF         .DUMP               LDA     (SRCE),y            ;SCAN_ESC    
01129  00E543  20 C1 FB                          JSR     WR2HEX          
01130  00E546  A9 20                             LDA     #SP         
01131  00E548  20 98 FB                          JSR     WRCHAR          
01132  00E54B  CA                                DEX
01133  00E54C  D0 05                             BNE     .SKIPSP             
01134  00E54E  A2 04                             LDX     #04                 ;4 coloumns of 4 words to display           
01135  00E550  20 98 FB                          JSR     WRCHAR              ;then add a 2nd space 
01136  00E553  C8            .SKIPSP             INY
01137  00E554  C0 10                             CPY     #$10            
01138  00E556  D0 E9                             BNE     .DUMP           
01139  00E558  20 8D FB                          JSR     WRSPACE         
01140  00E55B  84 D0                             STY     COUNT               
