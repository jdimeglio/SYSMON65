02810  FIND_EOF            		                ;Point to line length
02811  00F057  B2 B6         .LOOP               LDA     (PNTR)            	;Get current line's length
02812  00F059  F0 0B                             BEQ     .EOF                ;EOF found!
02813  00F05B  18                                CLC                         ;Add line length to current pntr
02814  00F05C  65 B6                             ADC     PNTR
02815  00F05E  85 B6                             STA     PNTR
02816  00F060  90 F5                             BCC     .LOOP               ;Carry is not set!
02817  00F062  E6 B7                             INC     PNTR+1
02818  00F064  B0 F1                             BCS     .LOOP               ;Always taken
02819  00F066  60            .EOF                RTS
