02008  ;------------------------------------------------------------------------
02009  ; Copy command
02010  ;------------------------------------------------------------------------
02011  00EAE2  84 C2         CMD_COP             STY     UNDEF               ;Clear undefined label flag
02012  00EAE4  20 17 EB                          JSR     .GETVAL             ;Get Source
02013  00EAE7  F0 57                             BEQ     ERROR_MISSING       ;Missing parameter!
02014  00EAE9  84 DF                             STY     SRCE
02015  00EAEB  A5 D3                             LDA     HEXVAL+1
02016  00EAED  85 E0                             STA     SRCE+1
02017  00EAEF  20 17 EB                          JSR     .GETVAL             ;Get Destination
02018  00EAF2  F0 4C                             BEQ     ERROR_MISSING       ;Missing parameter!
02019  00EAF4  84 E1                             STY     DEST
02020  00EAF6  A5 D3                             LDA     HEXVAL+1
02021  00EAF8  85 E2                             STA     DEST+1
02022  00EAFA  20 17 EB                          JSR     .GETVAL             ;Get length
02023  00EAFD  84 DD                             STY     LENG
02024  00EAFF  A5 D3                             LDA     HEXVAL+1
02025  00EB01  85 DE                             STA     LENG+1
02026  00EB03  05 DD                             ORA     LENG
02027  00EB05  F0 29                             BEQ     .RTS                ;Length is 0! We're done    
02028  00EB07  A5 DF                             LDA     SRCE                ;Copy up or down?
02029  00EB09  C5 E1                             CMP     DEST
02030  00EB0B  A5 E0                             LDA     SRCE+1
02031  00EB0D  E5 E2                             SBC     DEST+1
02032  00EB0F  90 03                             BCC     .MOVEUP             ;Move up!
02033  00EB11  4C A1 E6                          JMP     MOV_DOWN            ;Move memory block down
02034  00EB14  4C C2 E6      .MOVEUP             JMP     MOV_UP              ;Move memory block up
02035  00EB17  20 0A E8      .GETVAL             JSR     NNONSPC             ;See if end of line
02036  00EB1A  F0 15                             BEQ     .MIS                ;Yes!
02037  00EB1C  20 49 E9                          JSR     GET_EXPRES          ;Get value
02038  00EB1F  D0 17                             BNE     _ERROR              ;An error occurred
02039  00EB21  A5 C2                             LDA     UNDEF               ;Undefined label used?
02040  00EB23  D0 0F                             BNE     .UNDEF              ;Yes!
02041  00EB25  B5 19                             LDA     IN,X
02042  00EB27  C9 0D                             CMP     #CR                 ;End of line?
02043  00EB29  F0 05                             BEQ     .RTS                ;Yes! Z=1 now!
02044  00EB2B  C9 2C                             CMP     #','                ;Must be a comma now
02045  00EB2D  D0 02                             BNE     .MIS                ;It's not!
02046  00EB2F  E8                                INX                         ;Z=0 now!
02047  00EB30  60            .RTS                RTS
02048  
02049  00EB31  A9 26         .MIS                LDA     #ERR_MIS            ;Exit with missing error
02050                      .DB $2C                     ;save a byte
02051                                                  ;Always taken
02052  00EB34  A9 5E         .UNDEF              LDA     #ERR_DEF            ;Exit with undefined label
02053  00EB36  85 C9         .SKIP               STA     ERROR
02054  00EB38  68            _ERROR              PLA                         ;Pull return address from stack
02055  00EB39  68                                PLA
02056  00EB3A  60                                RTS
