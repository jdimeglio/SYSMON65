02350  ;------------------------------------------------------------------------
02351  ; NEW command (or N -f force)
02352  ;------------------------------------------------------------------------
02353  00EDA5  20 0A E8      CMD_NEW             JSR     NNONSPC         ;if there's value after N
02354  00EDA8  D0 06                             BNE     DONEW
02355  00EDAA  B1 F4                             LDA     (LOMEM),Y           ;Save first byte of program (OLD)
02356  00EDAC  F0 13                             BEQ     RTS_MEM             ;But don't do it if already 0!
02357  00EDAE  85 E9                             STA     OLD_SAVE
02358  
02359  00EDB0  98            DONEW               TYA                         ;Make A=0
02360  00EDB1  91 F4                             STA     (LOMEM),Y           ;Clear first byte of program
02361  00EDB3  85 EF                             STA     SYM_TABLE+1         ;Invalidate symbol table
02362  00EDB5  A9 E8                             LDA     #<DEF_AUTO          ;Set default AUTO line number
02363  00EDB7  85 EA                             STA     AUTO
02364  00EDB9  A9 03                             LDA     #>DEF_AUTO
02365  00EDBB  85 EB                             STA     AUTO+1
02366  00EDBD  A9 0A                             LDA     #DEF_INC            ;Set default AUTO increment
02367  00EDBF  85 EC                             STA     AUTO_INC
02368  00EDC1  60            RTS_MEM             RTS
02369  
02370  ;------------------------------------------------------------------------
02371  ; OLD command 
02372  ;------------------------------------------------------------------------
02373                                      ;Save some space by omitting error
02374  00EDC2  A5 E9         CMD_OLD             LDA     OLD_SAVE            ;Is it possible to do OLD?
02375  00EDC4  F0 04                             BEQ     ._ERROR             ;OLD not possible!
02376  00EDC6  91 F4                             STA     (LOMEM),Y           ;Save old value into program
02377  00EDC8  84 E9                             STY     OLD_SAVE            ;Clear old flag
02378  00EDCA  60            ._ERROR             RTS
02379  
02380  ;------------------------------------------------------------------------
02381  ; Renumber command
02382  ;------------------------------------------------------------------------
02383  
02384  00EDCB  84 CB         CMD_REN             STY     PARM1               ;Set default values
02385  00EDCD  84 CC                             STY     PARM1+1             ;Start renumbering from line 0
02386  00EDCF  A9 E8                             LDA     #<DEF_AUTO          ;Set default renumber start addr.
02387  00EDD1  85 CD                             STA     PARM2
02388  00EDD3  A9 03                             LDA     #>DEF_AUTO
02389  00EDD5  85 CE                             STA     PARM2+1
02390  00EDD7  A9 0A                             LDA     #DEF_INC            ;Set default increment
02391  00EDD9  85 DD                             STA     LENG
02392      
02393  00EDDB  20 0A E8                          JSR     NNONSPC             ;Are there any parameters?
02394  00EDDE  F0 2F                             BEQ     .RENUMBER           ;No parameters given!
02395  00EDE0  C9 2C                             CMP     #','                ;Is begin line given?
02396  00EDE2  F0 0F                             BEQ     .STRTLIN            ;Nope!
02397      
02398  00EDE4  20 42 E8                          JSR     GET_VAL             ;Get begin line number
02399  00EDE7  D0 5D                             BNE     .DONE               ;An error occurred
02400  00EDE9  84 CB                             STY     PARM1               ;Save begin line number
02401  00EDEB  85 CC                             STA     PARM1+1
02402      
02403  00EDED  B5 19                             LDA     IN,X                ;Does the start line number follow?
02404  00EDEF  C9 2C                             CMP     #','
02405  00EDF1  D0 1C                             BNE     .RENUMBER           ;Nope! Get going
02406  
02407  00EDF3  E8            .STRTLIN            INX                         ;Get start line
02408  00EDF4  20 42 E8                          JSR     GET_VAL
02409  00EDF7  D0 4D                             BNE     .DONE
02410  00EDF9  84 CD                             STY     PARM2
02411  00EDFB  85 CE                             STA     PARM2+1
02412      
02413  00EDFD  B5 19                             LDA     IN,X                ;Is increment given?
02414  00EDFF  C9 2C                             CMP     #','
02415  00EE01  D0 0C                             BNE     .RENUMBER           ;Nope! Get going
02416      
02417  00EE03  E8                                INX
02418  00EE04  20 42 E8                          JSR     GET_VAL             ;Get increment value
02419  00EE07  D0 3D                             BNE     .DONE
02420  00EE09  C0 00                             CPY     #0                  ;May not be zero!
02421  00EE0B  F0 3A                             BEQ     .RANGE              ;Exit with range error
02422  00EE0D  84 DD                             STY     LENG                ;Save increment
02423  
02424  00EE0F  A5 CD         .RENUMBER           LDA     PARM2               ;See if begin line <= start line
02425  00EE11  C5 CB                             CMP     PARM1               ; to avoid double line numbers
02426  00EE13  A5 CE                             LDA     PARM2+1
02427  00EE15  E5 CC                             SBC     PARM1+1
02428  00EE17  90 2E                             BCC     .RANGE              ;Nope! Exit with range error
02429      
02430  00EE19  A5 CD                             LDA     PARM2               ;Copy parm2 to auto number
02431  00EE1B  85 EA                             STA     AUTO
02432  00EE1D  A5 CE                             LDA     PARM2+1
02433  00EE1F  85 EB                             STA     AUTO+1
02434  00EE21  A5 DD                             LDA     LENG                ;Copy increment to auto_inc
02435  00EE23  85 EC                             STA     AUTO_INC
02436      
02437  00EE25  A0 CB                             LDY     #PARM1              ;Find first line number
02438  00EE27  20 67 F0                          JSR     FIND_LINE
02439  00EE2A  90 1A                             BCC     .DONE               ;End of file!
02440  00EE2C  A0 00                             LDY     #0
02441  
02442  00EE2E  C8            .LOOP               INY                         ;Set new line number
02443  00EE2F  18                                CLC                         ; and calculate next number
02444  00EE30  A5 EA                             LDA     AUTO
02445  00EE32  91 B6                             STA     (PNTR),Y
02446  00EE34  65 EC                             ADC     AUTO_INC
02447  00EE36  85 EA                             STA     AUTO
02448  00EE38  C8                                INY
02449  00EE39  A5 EB                             LDA     AUTO+1
02450  00EE3B  91 B6                             STA     (PNTR),Y
02451  00EE3D  69 00                             ADC     #0
02452  00EE3F  85 EB                             STA     AUTO+1
02453  00EE41  20 92 F0                          JSR     NEXT_LINE           ;Set pointer to next line
02454  00EE44  D0 E8                             BNE     .LOOP               ;Nope!
02455  00EE46  60            .DONE               RTS
