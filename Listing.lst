00993  ;------------------------------------------------------------------------
00994  ;Hunt F start end value
00995  ;------------------------------------------------------------------------ 
00996  00E47C  20 42 E8      CMD_HUNT            JSR     GET_VAL             ;Fill Memory
00997  00E47F  84 DF                             STY     SRCE                ;Get start address
