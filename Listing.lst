02568  00EEF3  F0 0F         CMD_XEC             BEQ     .RUN                ;Nope! Run from last known addr.
02569  00EEF5  64 C2                             STZ     UNDEF               ;CLear it
02570  00EEF7  20 49 E9                          JSR     GET_EXPRES          ;Get address to run from
02571  00EEFA  D0 BE                             BNE     VAL_RTS             ;An error occurred!
