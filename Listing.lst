00243  
00244  
00245      
00246      
00247  00E000                            *= $e000            ;ROM location
00248          
00249  ;------------------------------------------------------------------------
00250  ; Lets get going
00251  ; Cold and Warm program entry points
00252  ;------------------------------------------------------------------------
00253  00E000  20 16 E8      COLD                JSR     INIT                ;Initialise assembler
00254  00E003  D8            WARM                CLD                         ;WARM Reboot/startup
00255  00E004  A2 FF                             LDX     #$FF                ;just in case   
00256  00E006  9A                                TXS
00257  00E007  20 91 FB                          JSR     WRCRLF              ;Print CR & LF before we do anything                
00258  00E00A  AD 01 E0                          LDA     COLD+1
00259  00E00D  48                                PHA
00260  00E00E  AD 00 E0                          LDA     COLD
00261  00E011  48                                PHA
00262  00E012  64 ED                             STZ     AUTO_FLAG           ;Clear auto flag
00263  
00264  
00265  ;------------------------------------------------------------------------
00266  ; Get input line (main program loop)
00267  ;------------------------------------------------------------------------
00268  00E014  A2 00         GETLINE             LDX     #$00                ;Get input line (main program loop)
00269                                                  ;reset buffer index
00270  00E016  A9 2E                             LDA     #PROMPT             ;Print the assembler prompt
00271  00E018  20 98 FB                          JSR     WRCHAR      
00272  00E01B  20 98 EA                          JSR     AUTONUM             ;Generate line number if auto=on
00273  00E01E  20 F1 FB      .IN                 JSR     RDCHAR              ;Was a key pressed?
00274  00E021  C9 1B         .found              CMP     #ESC                ;Is it the ESC key?
00275  00E023  F0 23                             BEQ     .ESC                ;Nope!
00276  00E025  C9 08                             CMP     #BS                 ;Back space key then?
00277  00E027  F0 26                             BEQ     .BS
00278  00E029  C9 09                             CMP     #TAB                ;Is it the TAB character?
00279  00E02B  F0 2B                             BEQ     .TABS 
00280  00E02D  C9 0D                             CMP     #CR                 ;Is it a CR then?
00281  00E02F  F0 45                             BEQ     .CR                 ;Yes!                
00282  00E031  C9 3A                             CMP     #':'                ;INTEL Hex loader
00283  00E033  D0 05                             BNE     .LF                 ;nope then skip
00284  00E035  20 27 E1                          JSR     CMD_INTELHEX
00285  00E038  80 DA                             BRA     GETLINE          
00286  00E03A  C9 0A         .LF                 CMP     #LF                 ;Is it a CR then?
00287  00E03C  F0 E0                             BEQ     .IN                 ;Strip LF useful for pasting code                                
00288  00E03E  95 19                             STA     IN,X                ;Save new character in input buffer
00289  00E040  20 98 FB                          JSR     WRCHAR              ; and display it
00290  00E043  E8                                INX
00291  00E044  10 D8                             BPL     .IN                 ;Get next character unless its 128 characters
00292  00E046  80 02                             BRA     .CANCEL             ;Always taken! Too many chars.
00293  00E048  64 ED         .ESC                STZ     AUTO_FLAG           ;Clear auto flag and therefore OFF
00294          
00295              
00296  ;       .IF MYWYM
00297  ;       .IF SYMON   
00298  ;           JSR     RDCHAR          ;get the unwanted arrow keys    
00299  ;           
00300  ;       .ELSE           
00301  ;           ;JSR     RDCHAR                                 
00302  ;           ;JSR     RDCHAR  
00303  ;       .ENDIF          
00304  ;       .ENDIF  
00305          
00306  00E04A  20 91 FB      .CANCEL             JSR     WRCRLF              ;Print CRLF
00307  00E04D  80 C5                             BRA     GETLINE             ;Always taken! Restart line
00308  
00309  00E04F  20 98 FB      .BS                 JSR     WRCHAR              ;Process Back SPACE   
00310  00E052  CA                                DEX                         ;Decrement input pointer
00311  00E053  10 C9                             BPL     .IN                 ;Still positive!
00312  00E055  E8                                INX                         ;Don't allow it to go negative
00313  00E056  80 C6                             BRA     .IN                 ;Always taken!
00314  
00315  00E058  A0 00         .TABS               LDY     #0                  ;Point to 1st tab stop
00316  00E05A  B9 9E E0      .TABS_NEXT          LDA     TABS,Y              ;It X smaller than this one?
00317  00E05D  85 D0                             STA     COUNT
00318  00E05F  A9 20                             LDA     #SP                 ;replace with SPACE probably dont need this
00319  00E061  E4 D0                             CPX     COUNT
00320  00E063  90 05                             BCC     .DOTAB              ;Yes! Tab to this position
00321  00E065  C8                                INY 
00322  00E066  C0 04                             CPY     #NUMTABS            ;Maximum number of tab stops
00323  00E068  90 F0                             BCC     .TABS_NEXT          ;Try next!
00324  
00325  00E06A  95 19         .DOTAB              STA     IN,X                ;Save this character
00326  00E06C  E8                                INX
00327  00E06D  20 98 FB                          JSR     WRCHAR              ; and WRCHAR it
00328  00E070  E4 D0                             CPX     COUNT               ;At tab stop?
00329  00E072  90 F6                             BCC     .DOTAB              ;Not yet!
00330  00E074  80 A8                             BRA     .IN                 ;Always taken!
00331      
00332  00E076  95 19         .CR                 STA     IN,X                ;Mark end of line now with CR
00333  00E078  20 3D FC                          JSR     UPPERCASE           ;convert to upper case
00334  00E07B  20 91 FB                          JSR     WRCRLF              ;CR new line    
00335  00E07E  20 08 E8                          JSR     FIRSTNONSPC         ;Find first non space
00336  00E081  F0 91                             BEQ     GETLINE             ;End of line reached!
00337  
00338  00E083  C9 30                             CMP     #'0'                ;Is it a line number?
00339  00E085  90 04                             BCC     .NOLINE             ;No!
00340  00E087  C9 3A                             CMP     #'9'+1
00341  00E089  90 0D                             BCC     .LINENUM            ;It is! Add it to the program
00342  00E08B  20 A2 E0      .NOLINE             JSR     KEYDEF              ;Parse command, or line number
00343  00E08E  A5 C9         .CHK_ERROR          LDA     ERROR               ;Was there an error?
00344  00E090  F0 03                             BEQ     .GETLINE            ;Nope!
00345  00E092  20 EC E6                          JSR     PRINT_MSGS          ;Print error
00346  00E095  4C 14 E0      .GETLINE            JMP     GETLINE             ;Stay in main program loop
00347  
00348  00E098  20 17 EF      .LINENUM            JSR     ADDLINE             ;Add line to program
00349  00E09B  4C 8E E0                          JMP     .CHK_ERROR          ;Check if an error occurred
00350  
00351  TABS            .BYTE     TAB1                  ;1st tab stop
00352                  .BYTE     TAB2                  ;2nd tab stop
00353                  .BYTE     TAB3 
00354                  .BYTE     TAB4                  ;3rd tab stop
00355    0004              NUMTABS         =     4                         ;Number of tab stops
00356  
00357  
00358  ;------------------------------------------------------------------------
00359  ; Parse command line 
00360  ; IN: AC holds the command character
00361  ;------------------------------------------------------------------------
00362  00E0A2  A0 00         KEYDEF              LDY     #0                  ;Find command in table
00363  00E0A4  84 C9                             STY     ERROR               ;Clear error        
00364  00E0A6  85 C8                             STA     CMD_CHR
00365  00E0A8  B9 CE E0      .LOOP               LDA     .TABLE,Y    
00366  00E0AB  F0 1C                             BEQ     .SYNERR             ;End of table! Syntax errorv 
00367  00E0AD  C5 C8                             CMP     CMD_CHR             ;Is it this command
00368  00E0AF  F0 03                             BEQ     .FOUND              ;Found our command!
00369  00E0B1  C8                                INY                         ;Next command from table
00370  00E0B2  80 F4                             BRA     .LOOP               ;Always taken!
00371  00E0B4  20 0D EF      .FOUND              JSR     IN_BLANK            ;Get next and see if it's blank
00372  00E0B7  D0 FB                             BNE     .FOUND              ;A CR would have been too! Sets up X                    
00373  00E0B9  98                                TYA                         ;Point to command handler's
00374  00E0BA  0A                                ASL                         ; address in table                
00375  00E0BB  A8                                TAY                   
00376  00E0BC  B9 E9 E0                          LDA     FUNCTIONS+1,Y       ; Get the address and use it MSB first
00377  00E0BF  48                                PHA                         ; as return address                
00378  00E0C0  B9 E8 E0                          LDA     FUNCTIONS,Y
00379  00E0C3  48                                PHA
00380  00E0C4  A0 00                             LDY     #0                  ;Some commands may benefit from this
00381  00E0C6  4C 0A E8                          JMP     NNONSPC             ;Find next non space and exec cmd XR points to IN.X                 
00382  00E0C9  A9 08         .SYNERR             LDA     #ERR_SYN            ;Exit with syntax error
00383  00E0CB  85 C9                             STA     ERROR
00384  00E0CD  60                                RTS
00385  
00386  
