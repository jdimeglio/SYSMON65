00936  ;------------------------------------------------------------------------   
00937  ; Expand Mnemic
00938  ; copy the 2 chars at R/LMNETB,X
00939  ; into LMNE and RMNE, and expand 
00940  ; into 3 chars at MNE to MNE+2
00941  ;------------------------------------------------------------------------
00942  00E42B  BD 44 F7      EXPMNE              LDA     LMNETB,X            ;Expand Mnemic
00943  00E42E  85 CB                             STA     PARM1               
00944  00E430  BD 86 F7                          LDA     RMNETB,X        
00945  00E433  85 CC                             STA     PARM1+1
00946  00E435  A2 00                             LDX     #$00
00947  00E437  A9 00         .NEXT               LDA     #$00
00948  00E439  A0 05                             LDY     #$05                ;5 bits of  used
00949  00E43B  06 CC         .LOOP               ASL     PARM1+1             ;across 2 bytes
00950  00E43D  26 CB                             ROL     PARM1               ;expand and extra 
00951  00E43F  2A                                ROL
00952  00E440  88                                DEY
00953  00E441  D0 F8                             BNE     .LOOP
00954  00E443  69 40                             ADC     #'A'-1
00955                      ;STA    MNE,X               
00956  00E445  A4 E5                             LDY     PRFLAG              ;check if print to screen
00957  00E447  F0 03                             BEQ     .SKIP               
00958  00E449  20 98 FB                          JSR     WRCHAR              ;print the mnemonic as well
00959  00E44C  E8            .SKIP               INX
00960  00E44D  E0 03                             CPX     #$03        
00961  00E44F  D0 E6                             BNE     .NEXT
00962  00E451  60                                RTS 
