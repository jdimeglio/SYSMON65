00044  ;------------------------------------------------------------------------
00045  ; Symbols used in source code
00046  ;------------------------------------------------------------------------
00047    0023              IMV         ='#'                            ;Indicates immediate mode value
00048    0024              HEX         ='$'                            ;Indicates a hex value
00049    0028              OPEN        ='('                            ;Open bracket for indirect addressing
00050    0029              CLOSE       =')'                            ;Close bracket for indirect addressing
00051    002A              PCREL       ='*'                            ;Indicates PC relative addressing
00052    003C              LOBYTE      ='<'                            ;Indicates lo-byte of following word
00053    003E              HIBYTE      ='>'                            ;Indicates hi-byte of following word
00054    002B              PLUS        ='+'                            ;Plus in simple expressions
00055    002D              MINUS       ='-'                            ;Minus in simple expressions
00056    002E              DOT         ='.'                            ;Indicates a local label
00057    0027              QUOTE       ='''                            ;delimits a string
00058    002C              COMMA       =','                
00059    003B              CMNT        =';'                            ;indicates a full line comment
00060    002E              PROMPT      ='.'                            ;The assembler prompt character
00061    002D              DASH        ='-'                            ;Dash for crued graphics
00062    0000              EOL         =$00                            ;End of line marker
00063    0000              EOS         =$00                            ;End of string marker
00064    0001              EOFLD       =$01                            ;End of field in tokenised source line
00065    0002              BLANK       =$02                            ;used to mark a blank line
00066    00FE              PRGEND      =$FE                            ;used to flag end of program parsing
00067    00FF              FAIL        =$FF                            ;used to flag failure in various searches
00068    000D              CR          =$0D                            ;CR character
00069    001B              ESC         =$1B                            ;ESC character
00070    0007              BELL        =$07                            ;BELL should be $07 but $20 for testing 
00071    0008              BS          =$08                            ;Back space key
00072    0009              TAB         =$09                            ;TAB character
00073    000A              LF          =$0a                            ;Line feed
00074    0020              SP          =$20                            ;Space
00075  
00076  
00077    004A              LEFTARROW   ='J'                            ;37
00078    0049              UPARROW     ='I'                            ;38 
00079    004B              RIGHTARROW  ='K'                            ;39
00080    004D              DOWNARROW   ='M'                            ;40
00081  
00082  
00083    000C              TAB1        =12                             ;1st tab stop 8
00084    0010              TAB2        =16                             ;2nd tab stop 12
00085    0014              TAB3        =20                             ;3rd tab stop 21
00086    001A              TAB4        =26                             ;4th tab
